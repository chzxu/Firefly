---
import { getCollection } from "astro:content";
import WidgetLayout from "@/components/common/WidgetLayout.astro";
import { getPostUrlBySlug } from "@/utils/url-utils";

interface Props {
	class?: string;
	style?: string;
}

const className = Astro.props.class;
const style = Astro.props.style;

// 当前路径（去掉末尾斜杠，方便比较）
const currentPath = Astro.url.pathname.replace(/\/$/, "");

const allPosts = (await getCollection("posts")).filter((p) => !p.data.draft);

// 按分类分组
const groups = new Map<string, typeof allPosts>();
for (const post of allPosts) {
	const raw = post.data.category;
	const cat = raw ? String(raw).replace(/^["']|["']$/g, "").trim() : "未分类";
	const list = groups.get(cat);
	if (list) {
		list.push(post);
	} else {
		groups.set(cat, [post]);
	}
}

// 排序键：index 文件排最前，其余按文件名自然序（00、01 … 99-0、99-1）
const orderKey = (id: string) => {
	const name = id.split("/").pop() || id;
	if (/^index\./i.test(name)) return "00";
	return name;
};

// 只保留有 2 篇以上的分类，才值得做「系列导航」
const series = [...groups.entries()]
	.filter(([, list]) => list.length >= 2)
	.map(([cat, list]) => {
		const posts = [...list].sort((a, b) =>
			orderKey(a.id).localeCompare(orderKey(b.id), "zh-CN", { numeric: true }),
		);
		const active = posts.some(
			(p) => getPostUrlBySlug(p.id).replace(/\/$/, "") === currentPath,
		);
		return { cat, posts, active };
	})
	.sort((a, b) => b.posts.length - a.posts.length);

const total = series.reduce((n, s) => n + s.posts.length, 0);

// 默认展开的系列：文章数最多的那个（当前是「学习笔记」），其余保持折叠
const defaultOpenCat = series[0]?.cat;
---

{total > 0 && (
	<WidgetLayout
		name="文章导航"
		id="series-nav"
		class={className}
		style={style}
	>
		<div class="series-scroll custom-scrollbar">
			{series.map(({ cat, posts, active }) => (
				<details class="series-group" open={active || cat === defaultOpenCat}>
					<summary class="series-summary">
						<span class="series-cat">{cat}</span>
						<span class="series-count">{posts.length}</span>
					</summary>
					<ul class="series-list">
						{posts.map((p) => {
							const href = getPostUrlBySlug(p.id);
							const isActive = href.replace(/\/$/, "") === currentPath;
							return (
								<li>
									<a
										href={href}
										class:list={["series-link", { "series-link-active": isActive }]}
										aria-current={isActive ? "page" : undefined}
									>
										{p.data.title}
									</a>
								</li>
							);
						})}
					</ul>
				</details>
			))}
		</div>
	</WidgetLayout>
)}

<style lang="stylus">
.series-scroll
	max-height: 20rem
	overflow-y: auto
	padding-right: 0.25rem

.series-group
	margin-bottom: 0.375rem

.series-summary
	display: flex
	align-items: center
	justify-content: space-between
	gap: 0.5rem
	padding: 0.35rem 0.5rem
	border-radius: 0.5rem
	cursor: pointer
	list-style: none
	font-size: 0.875rem
	font-weight: 600
	color: var(--primary)
	transition: background-color 0.15s ease
	&::-webkit-details-marker
		display: none
	&:hover
		background-color: var(--btn-regular-bg)

.series-count
	flex-shrink: 0
	min-width: 1.25rem
	padding: 0 0.35rem
	border-radius: 999px
	font-size: 0.7rem
	font-weight: 500
	line-height: 1.25rem
	text-align: center
	color: var(--primary)
	background-color: var(--btn-regular-bg)

.series-list
	margin: 0.15rem 0 0.35rem 0
	padding: 0 0 0 0.5rem
	border-left: 1px solid var(--line-divider)
	list-style: none

.series-link
	display: block
	padding: 0.25rem 0.5rem
	border-radius: 0.4rem
	font-size: 0.8125rem
	line-height: 1.35
	color: var(--text-75, inherit)
	opacity: 0.8
	transition: all 0.15s ease
	text-decoration: none
	overflow: hidden
	text-overflow: ellipsis
	display: -webkit-box
	-webkit-line-clamp: 2
	-webkit-box-orient: vertical
	&:hover
		opacity: 1
		color: var(--primary)
		background-color: var(--btn-regular-bg)

.series-link-active
	opacity: 1
	font-weight: 600
	color: var(--primary)
	background-color: var(--btn-regular-bg)
</style>
