---
import { Icon } from "astro-icon/components";
import ImageWrapper from "@/components/common/ImageWrapper.astro";
import { profileConfig } from "@/config/profileConfig";
import { url } from "@/utils/url-utils";
---

<div class="card-base p-4">
  <!-- B 站风格头像：大圆形 + 粉色边框 -->
  <a
    aria-label="Go to About Page"
    href={url("/about/")}
    class="group relative block mx-auto mb-3 w-20 h-20 rounded-full overflow-hidden border-3 border-(--primary) active:scale-95 transition"
  >
    <div
      class="absolute transition pointer-events-none group-hover:bg-black/30 group-active:bg-black/50
        w-full h-full z-50 flex items-center justify-center rounded-full"
    >
      <Icon
        name="fa7-regular:address-card"
        class="transition opacity-0 scale-90 group-hover:scale-100 group-hover:opacity-100 text-white text-5xl"
      />
    </div>
    <ImageWrapper
      src={profileConfig.avatar || ""}
      alt="Profile Image of the Author"
      class="w-full h-full object-cover"
      loading="eager"
      fetchpriority="high"
      widths={[160]}
      sizes="80px"
    />
  </a>
  <div class="text-center px-1">
    <div class="font-bold text-lg text-center mb-0.5 dark:text-neutral-50 transition">
      {profileConfig.name}
    </div>
    <div class="h-0.5 w-6 bg-(--primary) mx-auto rounded-full mb-2 transition"></div>
    <div class="text-center text-neutral-400 text-xs mb-3 transition leading-relaxed">
      {profileConfig.bio}
    </div>
    <div class="flex flex-wrap gap-1.5 justify-center">
      {profileConfig.links.map(item => {
        const className = "btn-regular rounded-lg h-8 w-8 active:scale-90 transition hover:bg-(--primary)/10 hover:text-(--primary)";

        if (item.url.startsWith("mailto:")) {
          const encodedEmail = Buffer.from(item.url.replace("mailto:", "")).toString("base64");
          return <a rel="me" aria-label={item.name} href="#" data-encoded-email={encodedEmail}
            onclick={`(function(){const d=atob(this.getAttribute('data-encoded-email'));this.href='mailto:'+d;this.removeAttribute('data-encoded-email');this.removeAttribute('onclick');this.click();return false;}).call(this)`}
            class={className}>
            <Icon name={item.icon} class="text-[1.25rem]"></Icon>
          </a>
        } else {
          return <a rel="me" aria-label={item.name} href={item.url} target="_blank" class={className}>
            <Icon name={item.icon} class="text-[1.25rem]"></Icon>
          </a>
        }
      })}
    </div>
  </div>
</div>
