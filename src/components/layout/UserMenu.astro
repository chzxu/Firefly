---
import { Icon } from "astro-icon/components";
import ImageWrapper from "@/components/common/ImageWrapper.astro";
import { profileConfig } from "@/config/profileConfig";
import {
  getCategoryList,
  getSortedPosts,
  getTagList,
} from "@/utils/content-utils";
import { url } from "@/utils/url-utils";

const posts = await getSortedPosts();
const tags = await getTagList();
const categories = await getCategoryList();

const stats = [
  { icon: "material-symbols:article-outline", label: "文章", value: posts.length },
  { icon: "material-symbols:label-outline", label: "标签", value: tags.length },
  { icon: "material-symbols:folder-outline", label: "分类", value: categories.length },
];
---

<div class="user-menu-container relative">
  <!-- 触发按钮：小圆形头像 -->
  <button
    class="user-menu-trigger flex items-center justify-center w-9 h-9 rounded-full overflow-hidden border-2 border-transparent hover:border-(--primary) focus-visible:border-(--primary) transition-all duration-200 active:scale-95"
    id="user-menu-trigger"
    aria-label="用户菜单"
    aria-expanded="false"
    aria-controls="user-menu-panel"
  >
    <ImageWrapper
      src={profileConfig.avatar || ""}
      alt={profileConfig.name}
      class="w-full h-full object-cover"
      widths={[72]}
      sizes="36px"
      loading="eager"
    />
  </button>

  <!-- 下拉面板 -->
  <div
    id="user-menu-panel"
    class="user-menu-panel float-panel-closed absolute right-0 top-full mt-2 w-72 z-50 transition-all duration-200"
  >
    <div class="float-panel p-4">
      <!-- 头像 + 名字 + 签名 -->
      <a href={url("/about/")} class="group block">
        <div class="flex items-center gap-3 mb-3">
          <div class="w-14 h-14 rounded-full overflow-hidden border-3 border-(--primary) flex-shrink-0 transition-transform duration-300 group-hover:scale-110">
            <ImageWrapper
              src={profileConfig.avatar || ""}
              alt={profileConfig.name}
              class="w-full h-full object-cover"
              widths={[112]}
              sizes="56px"
              loading="lazy"
            />
          </div>
          <div class="min-w-0">
            <div class="font-bold text-base text-90 group-hover:text-(--primary) transition">
              {profileConfig.name}
            </div>
            <div class="text-xs text-neutral-400 mt-0.5 line-clamp-2 leading-relaxed">
              {profileConfig.bio}
            </div>
          </div>
        </div>
      </a>

      <!-- 分隔线 -->
      <div class="border-t border-(--line-divider) mb-3"></div>

      <!-- 统计数据 -->
      <div class="flex justify-around mb-3">
        {stats.map((stat) => (
          <div class="flex flex-col items-center gap-1">
            <span class="text-lg font-bold text-90">{stat.value}</span>
            <span class="text-xs text-neutral-400">{stat.label}</span>
          </div>
        ))}
      </div>

      <!-- 分隔线 -->
      <div class="border-t border-(--line-divider) mb-3"></div>

      <!-- 社交链接 -->
      <div class="flex flex-wrap gap-1.5 justify-center">
        {profileConfig.links.map((item) => {
          const className = "btn-regular rounded-lg h-8 w-8 active:scale-90 transition hover:bg-(--primary)/10 hover:text-(--primary)";

          if (item.url.startsWith("mailto:")) {
            const encodedEmail = Buffer.from(item.url.replace("mailto:", "")).toString("base64");
            return <a rel="me" aria-label={item.name} href="#" data-encoded-email={encodedEmail}
              onclick={`(function(){const d=atob(this.getAttribute('data-encoded-email'));this.href='mailto:'+d;this.removeAttribute('data-encoded-email');this.removeAttribute('onclick');this.click();return false;}).call(this)`}
              class={className}>
              <Icon name={item.icon} class="text-[1.15rem]" />
            </a>
          } else {
            return <a rel="me" aria-label={item.name} href={item.url} target="_blank" class={className}>
              <Icon name={item.icon} class="text-[1.15rem]" />
            </a>
          }
        })}
      </div>

      <!-- 查看完整资料 -->
      <a href={url("/about/")}
        class="mt-3 flex items-center justify-center gap-1 text-sm text-(--primary) font-medium
               hover:bg-(--primary)/10 py-2 rounded-lg transition">
        查看完整资料
        <Icon name="material-symbols:chevron-right-rounded" class="text-base" />
      </a>
    </div>
  </div>
</div>

<style>
  .user-menu-container:hover .user-menu-panel,
  .user-menu-container:focus-within .user-menu-panel {
    opacity: 1 !important;
    visibility: visible !important;
    pointer-events: auto !important;
    transform: translateY(0) !important;
  }

  .user-menu-container:hover .user-menu-trigger {
    border-color: var(--primary);
  }

  .user-menu-panel {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translateY(-8px);
    transition: all 0.2s ease-out;
  }

  /* 点击外部关闭通过全局的 float-panel 点击关闭机制处理 */
</style>

<script>
  function closePanel() {
    const panel = document.getElementById('user-menu-panel');
    const trigger = document.getElementById('user-menu-trigger');
    if (panel) panel.classList.add('float-panel-closed');
    if (trigger) trigger.setAttribute('aria-expanded', 'false');
  }

  function openPanel() {
    const panel = document.getElementById('user-menu-panel');
    const trigger = document.getElementById('user-menu-trigger');
    if (panel) panel.classList.remove('float-panel-closed');
    if (trigger) trigger.setAttribute('aria-expanded', 'true');
  }

  // 移动端点击切换
  document.addEventListener('DOMContentLoaded', () => {
    const trigger = document.getElementById('user-menu-trigger');
    const panel = document.getElementById('user-menu-panel');

    if (trigger && panel) {
      trigger.addEventListener('click', (e) => {
        e.stopPropagation();
        if (panel.classList.contains('float-panel-closed')) {
          openPanel();
        } else {
          closePanel();
        }
      });
    }
  });

  // 点击外部关闭
  document.addEventListener('click', (event) => {
    const panel = document.getElementById('user-menu-panel');
    const trigger = document.getElementById('user-menu-trigger');
    if (panel && trigger && event.target instanceof Node &&
        !panel.contains(event.target) && !trigger.contains(event.target)) {
      closePanel();
    }
  });

  // Escape 键关闭
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') {
      closePanel();
    }
  });
</script>
