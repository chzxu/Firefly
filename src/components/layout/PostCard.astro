---
import type { CollectionEntry } from "astro:content";
import { render } from "astro:content";
import { Icon } from "astro-icon/components";
import CoverImage from "@/components/common/CoverImage.astro";
import ImageWrapper from "@/components/common/ImageWrapper.astro";
import { profileConfig } from "@/config/profileConfig";
import { siteConfig } from "@/config";
import { formatDateToYYYYMMDD } from "@/utils/date-utils";
import { getApiUrlList, processCoverImageSync } from "@/utils/image-utils";
import { getFileDirFromPath, getTagUrl } from "@/utils/url-utils";

interface Props {
	class?: string;
	entry: CollectionEntry<"posts">;
	title: string;
	url: string;
	published: Date;
	updated?: Date;
	tags: string[];
	category: string | null;
	image: string;
	description: string;
	draft: boolean;
	pinned?: boolean;
	password?: boolean;
	style: string;
	loading?: "lazy" | "eager";
}
const {
	entry,
	title,
	url,
	published,
	tags,
	category,
	image,
	description,
	pinned,
	password,
	style,
	loading = "lazy",
} = Astro.props;
const className = Astro.props.class;

const processedImage = processCoverImageSync(image, entry.id);
const apiUrls = getApiUrlList(image, entry.id);
const hasCover =
	processedImage !== undefined &&
	processedImage !== null &&
	processedImage !== "";

const showTags = siteConfig.postListLayout.showTags;
const descriptionLines = Math.max(
	0,
	Math.trunc(siteConfig.postListLayout.descriptionLines ?? 2),
);
const descriptionClampLines = String(descriptionLines);
const shouldClampDescription = descriptionLines > 0;

const { remarkPluginFrontmatter } = await render(entry);
const descriptionText = description || remarkPluginFrontmatter.excerpt || "";

const publishedDateStr = formatDateToYYYYMMDD(published);
---

<div
  class:list={[
    "post-card-wrapper",
    hasCover ? "has-cover" : "no-cover",
    pinned ? "pinned" : "",
    "card-base flex flex-col w-full rounded-(--radius-large) overflow-hidden relative",
    className,
  ]}
  style={style}
>
  <!-- B 站风格卡片头部：头像 + 用户名 + 日期 -->
  <div class="post-card-header flex items-center gap-3 px-4 md:px-6 pt-4 md:pt-5">
    <a href="/about/" class="flex-shrink-0" aria-label={profileConfig.name}>
      <div class="w-8 h-8 md:w-9 md:h-9 rounded-full overflow-hidden border-2 border-(--primary) flex-shrink-0">
        <ImageWrapper
          src={profileConfig.avatar || ""}
          alt={profileConfig.name}
          class="w-full h-full object-cover"
          widths={[36]}
          sizes="36px"
          loading="lazy"
        />
      </div>
    </a>
    <div class="flex flex-col min-w-0">
      <span class="text-sm font-bold text-(--primary)">{profileConfig.name}</span>
      <span class="text-xs text-neutral-400">{publishedDateStr}</span>
    </div>
    <div class="ml-auto flex items-center gap-1.5">
      {pinned && (
        <span class="text-xs bg-(--primary)/10 text-(--primary) px-2 py-0.5 rounded-full font-medium flex items-center gap-0.5">
          <Icon name="material-symbols:pinboard" class="text-xs" />置顶
        </span>
      )}
      {password && (
        <Icon name="material-symbols:lock-outline" class="text-base text-neutral-400" />
      )}
    </div>
  </div>

  <!-- 卡片内容 -->
  <div
    class:list={[
      "post-card-content",
      "px-4 md:px-6 pt-3 pb-4",
      "flex flex-col",
      "w-full",
    ]}
  >
    <!-- 标题 -->
    <a
      href={url}
      class="post-card-title font-bold mb-2 text-xl leading-snug
        hover:text-(--primary) dark:hover:text-(--primary)
        active:text-(--title-active) dark:active:text-(--title-active)"
    >
      {title}
    </a>

    <!-- 描述文本 -->
    <div
      class:list={[
        "text-sm text-75 mb-3 leading-relaxed description",
        { "description-clamped": shouldClampDescription },
      ]}
      title={descriptionText}
    >
      {descriptionText}
    </div>

    <!-- 封面图（列表模式在描述下方，网格模式在标题上方） -->
    {hasCover && (
      <a
        href={url}
        aria-label={title}
        class:list={[
          "post-card-image",
          "group",
          "relative",
          "w-full",
          "mb-3",
          "rounded-xl overflow-hidden",
          "aspect-2/1",
          "order-first md:order-none",  // 网格模式图片置顶
        ]}
      >
        <div class="absolute pointer-events-none z-10 w-full h-full group-hover:bg-black/30 group-active:bg-black/50 transition" />
        <div class="absolute pointer-events-none z-20 w-full h-full flex items-center justify-center">
          <Icon
            name="material-symbols:chevron-right-rounded"
            class="transition opacity-0 group-hover:opacity-100 scale-50 group-hover:scale-100 text-white text-5xl"
          />
        </div>
        <CoverImage
          src={processedImage}
          basePath={getFileDirFromPath(entry.filePath || "")}
          alt="Cover Image of the Post"
          class="w-full h-full transition-transform duration-300 group-hover:scale-110 group-active:scale-115"
          preview={true}
          loading={loading}
          apiUrls={apiUrls}
        />
      </a>
    )}

    <!-- 底部互动栏 -->
    <div class="post-card-footer flex items-center justify-between mt-1 pt-3 border-t border-(--line-divider)">
      <a
        href={url}
        class="post-card-read-btn inline-flex items-center gap-1 text-sm text-(--primary) font-medium
               hover:bg-(--primary)/10 px-3 py-1.5 rounded-lg transition"
      >
        <Icon name="material-symbols:auto-stories-outline" class="text-lg" />
        阅读全文
      </a>

      <div class="flex items-center gap-3 text-xs text-neutral-400">
        {category && (
          <a href={getTagUrl(category)} class="hover:text-(--primary) transition">
            <Icon name="material-symbols:book-2-outline-rounded" class="text-sm inline mr-0.5" />
            {category}
          </a>
        )}
        {tags && tags.length > 0 && (
          <span class="flex items-center gap-1">
            <Icon name="material-symbols:tag-rounded" class="text-sm" />
            {tags.slice(0, 2).map((tag) => (
              <a href={getTagUrl(tag)} class="hover:text-(--primary) transition">#{tag.trim()}</a>
            ))}
          </span>
        )}
      </div>
    </div>
  </div>
</div>

<style define:vars={{ descriptionClampLines }}>
  /* 封面图完整展示（不裁剪） */
  .post-card-image :global(.cover-image-container img) {
    object-fit: contain !important;
    background: var(--card-bg);
  }

  .description-clamped {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    overflow: hidden;
    -webkit-line-clamp: var(--descriptionClampLines);
    line-clamp: var(--descriptionClampLines);
  }

  /* 文章卡片头部样式 */
  .post-card-header {
    position: relative;
  }

  .post-card-header::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 1.5rem;
    right: 1.5rem;
    height: 1px;
    background: var(--line-divider);
    opacity: 0.5;
  }

  /* 封面图默认样式 */
  .post-card-image {
    order: -1;
  }

  /* === List Mode Styles === */
  /* 列表模式：封面图内嵌在内容中（B 站动态风格） */
  :global(.list-mode) .post-card-wrapper {
    flex-direction: column !important;
  }

  :global(.list-mode) .post-card-image {
    order: 0 !important; /* 恢复默认顺序，在描述和底部栏之间 */
    width: 100% !important;
    max-height: 20rem !important;
    border-radius: 0.75rem !important;
  }

  :global(.list-mode) .post-card-title {
    font-size: 1.15rem !important;
    line-height: 1.6 !important;
    margin-bottom: 0.5rem !important;
  }

  :global(.list-mode) .post-card-header {
    padding-left: 1rem !important;
    padding-right: 1rem !important;
    padding-top: 1rem !important;
  }

  :global(.list-mode) .post-card-header::after {
    left: 1rem !important;
    right: 1rem !important;
  }

  :global(.list-mode) .post-card-content {
    padding-left: 1rem !important;
    padding-right: 1rem !important;
  }

  /* === Desktop List Mode === */
  @media (min-width: 768px) {
    :global(.list-mode) .post-card-header {
      padding-left: 1.5rem !important;
      padding-right: 1.5rem !important;
    }

    :global(.list-mode) .post-card-header::after {
      left: 1.5rem !important;
      right: 1.5rem !important;
    }

    :global(.list-mode) .post-card-content {
      padding-left: 1.5rem !important;
      padding-right: 1.5rem !important;
    }

    :global(.list-mode) .post-card-title {
      font-size: 1.35rem !important;
      margin-bottom: 0.75rem !important;
    }
  }

  /* === Grid Mode Styles === */
  /* 网格模式：封面在卡片最顶部 */
  :global(.grid-mode) .post-card-wrapper {
    flex-direction: column !important;
    height: 100% !important;
  }

  :global(.grid-mode) .post-card-image {
    order: -1 !important; /* 封面在网格模式置顶 */
    width: 100% !important;
    margin: 0 !important;
    border-radius: var(--radius-large) var(--radius-large) 0 0 !important;
    aspect-ratio: 2/1 !important;
    max-height: none !important;
    margin-bottom: 0 !important;
  }

  :global(.grid-mode) .post-card-content {
    flex-grow: 1 !important;
    padding-top: 0.5rem !important;
  }

  :global(.grid-mode) .post-card-header {
    padding-top: 0.25rem !important;
    padding-left: 0.75rem !important;
    padding-right: 0.75rem !important;
  }

  :global(.grid-mode) .post-card-header::after {
    display: none !important;
  }

  :global(.grid-mode) .post-card-content {
    padding-left: 0.75rem !important;
    padding-right: 0.75rem !important;
  }

  :global(.grid-mode) .post-card-title {
    font-size: 1rem !important;
    line-height: 1.5 !important;
  }

  :global(.grid-mode) .post-card-footer {
    margin-top: auto !important;
  }

  :global(.grid-mode) .description {
    display: none !important;
  }
</style>
