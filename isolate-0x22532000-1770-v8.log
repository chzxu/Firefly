code-creation,Script,9,1588460,0x13f93cdf12b0,67, file:///mnt/d/blog/Firefly/node_modules/astro/dist/cli/telemetry/index.js:1:1,0x14839c967688,~
script-source,153,file:///mnt/d/blog/Firefly/node_modules/astro/dist/cli/telemetry/index.js,import * as msg from "../../core/messages/runtime.js";\nimport { telemetry } from "../../events/index.js";\nimport { createLoggerFromFlags } from "../flags.js";\nasync function notify() {\n  await telemetry.notify(() => {\n    console.log(msg.telemetryNotice() + "\\n");\n    return true;\n  });\n}\nasync function update(subcommand\x2C { flags }) {\n  const isValid = ["enable"\x2C "disable"\x2C "reset"].includes(subcommand);\n  const logger = createLoggerFromFlags(flags);\n  if (flags.help || flags.h || !isValid) {\n    msg.printHelp({\n      commandName: "astro telemetry"\x2C\n      usage: "[command]"\x2C\n      tables: {\n        Commands: [\n          ["enable"\x2C "Enable anonymous data collection."]\x2C\n          ["disable"\x2C "Disable anonymous data collection."]\x2C\n          ["reset"\x2C "Reset anonymous data collection settings."]\n        ]\n      }\n    });\n    return;\n  }\n  switch (subcommand) {\n    case "enable": {\n      telemetry.setEnabled(true);\n      logger.info("SKIP_FORMAT"\x2C msg.telemetryEnabled());\n      return;\n    }\n    case "disable": {\n      telemetry.setEnabled(false);\n      logger.info("SKIP_FORMAT"\x2C msg.telemetryDisabled());\n      return;\n    }\n    case "reset": {\n      telemetry.clear();\n      logger.info("SKIP_FORMAT"\x2C msg.telemetryReset());\n      return;\n    }\n  }\n}\nexport {\n  notify\x2C\n  update\n};\n
