script-source,274,file:///mnt/d/blog/Firefly/node_modules/astro/dist/core/config/schemas/refined.js,import * as z from "zod/v4";\nimport {\n  validateAssetsPrefix\x2C\n  validateFontsCssVariables\x2C\n  validateI18nDefaultLocale\x2C\n  validateI18nDomains\x2C\n  validateI18nFallback\x2C\n  validateI18nRedirectToDefaultLocale\x2C\n  validateOutDirNotInPublicDir\x2C\n  validateRemotePatterns\n} from "./refined-validators.js";\nconst AstroConfigRefinedSchema = z.custom().superRefine((config\x2C ctx) => {\n  let issues = [];\n  issues = issues.concat(\n    validateAssetsPrefix(config)\x2C\n    validateRemotePatterns(config.image.remotePatterns)\x2C\n    validateI18nRedirectToDefaultLocale(config.i18n)\x2C\n    validateOutDirNotInPublicDir(config.outDir\x2C config.publicDir)\n  );\n  if (config.i18n) {\n    issues = issues.concat(\n      validateI18nDefaultLocale(config.i18n)\x2C\n      validateI18nFallback(config.i18n)\x2C\n      validateI18nDomains(config)\n    );\n  }\n  if (config.fonts && config.fonts.length > 0) {\n    issues = issues.concat(validateFontsCssVariables(config.fonts));\n  }\n  for (const issue of issues) {\n    ctx.addIssue({\n      code: z.ZodIssueCode.custom\x2C\n      message: issue.message\x2C\n      path: issue.path\n    });\n  }\n});\nexport {\n  AstroConfigRefinedSchema\n};\n
