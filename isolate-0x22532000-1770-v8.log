script-source,426,file:///mnt/d/blog/Firefly/node_modules/mdast-util-to-hast/lib/handlers/table.js,/**\n * @import {Table} from 'mdast'\n * @import {Element} from 'hast'\n * @import {State} from '../state.js'\n */\n\nimport {pointEnd\x2C pointStart} from 'unist-util-position'\n\n/**\n * Turn an mdast `table` node into hast.\n *\n * @param {State} state\n *   Info passed around.\n * @param {Table} node\n *   mdast node.\n * @returns {Element}\n *   hast node.\n */\nexport function table(state\x2C node) {\n  const rows = state.all(node)\n  const firstRow = rows.shift()\n  /** @type {Array<Element>} */\n  const tableContent = []\n\n  if (firstRow) {\n    /** @type {Element} */\n    const head = {\n      type: 'element'\x2C\n      tagName: 'thead'\x2C\n      properties: {}\x2C\n      children: state.wrap([firstRow]\x2C true)\n    }\n    state.patch(node.children[0]\x2C head)\n    tableContent.push(head)\n  }\n\n  if (rows.length > 0) {\n    /** @type {Element} */\n    const body = {\n      type: 'element'\x2C\n      tagName: 'tbody'\x2C\n      properties: {}\x2C\n      children: state.wrap(rows\x2C true)\n    }\n\n    const start = pointStart(node.children[1])\n    const end = pointEnd(node.children[node.children.length - 1])\n    if (start && end) body.position = {start\x2C end}\n    tableContent.push(body)\n  }\n\n  /** @type {Element} */\n  const result = {\n    type: 'element'\x2C\n    tagName: 'table'\x2C\n    properties: {}\x2C\n    children: state.wrap(tableContent\x2C true)\n  }\n  state.patch(node\x2C result)\n  return state.applyData(node\x2C result)\n}\n
