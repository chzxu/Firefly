script-source,755,file:///mnt/d/blog/Firefly/node_modules/mdast-util-to-markdown/lib/util/check-quote.js,/**\n * @import {Options\x2C State} from 'mdast-util-to-markdown'\n */\n\n/**\n * @param {State} state\n * @returns {Exclude<Options['quote']\x2C null | undefined>}\n */\nexport function checkQuote(state) {\n  const marker = state.options.quote || '"'\n\n  if (marker !== '"' && marker !== "'") {\n    throw new Error(\n      'Cannot serialize title with `' +\n        marker +\n        '` for `options.quote`\x2C expected `"`\x2C or `\\'`'\n    )\n  }\n\n  return marker\n}\n
