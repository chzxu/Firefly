script-source,557,file:///mnt/d/blog/Firefly/node_modules/parse5/dist/tree-adapters/default.js,import { DOCUMENT_MODE } from '../common/html.js';\nexport const defaultTreeAdapter = {\n    //Node construction\n    createDocument() {\n        return {\n            nodeName: '#document'\x2C\n            mode: DOCUMENT_MODE.NO_QUIRKS\x2C\n            childNodes: []\x2C\n        };\n    }\x2C\n    createDocumentFragment() {\n        return {\n            nodeName: '#document-fragment'\x2C\n            childNodes: []\x2C\n        };\n    }\x2C\n    createElement(tagName\x2C namespaceURI\x2C attrs) {\n        return {\n            nodeName: tagName\x2C\n            tagName\x2C\n            attrs\x2C\n            namespaceURI\x2C\n            childNodes: []\x2C\n            parentNode: null\x2C\n        };\n    }\x2C\n    createCommentNode(data) {\n        return {\n            nodeName: '#comment'\x2C\n            data\x2C\n            parentNode: null\x2C\n        };\n    }\x2C\n    createTextNode(value) {\n        return {\n            nodeName: '#text'\x2C\n            value\x2C\n            parentNode: null\x2C\n        };\n    }\x2C\n    //Tree mutation\n    appendChild(parentNode\x2C newNode) {\n        parentNode.childNodes.push(newNode);\n        newNode.parentNode = parentNode;\n    }\x2C\n    insertBefore(parentNode\x2C newNode\x2C referenceNode) {\n        const insertionIdx = parentNode.childNodes.indexOf(referenceNode);\n        parentNode.childNodes.splice(insertionIdx\x2C 0\x2C newNode);\n        newNode.parentNode = parentNode;\n    }\x2C\n    setTemplateContent(templateElement\x2C contentElement) {\n        templateElement.content = contentElement;\n    }\x2C\n    getTemplateContent(templateElement) {\n        return templateElement.content;\n    }\x2C\n    setDocumentType(document\x2C name\x2C publicId\x2C systemId) {\n        const doctypeNode = document.childNodes.find((node) => node.nodeName === '#documentType');\n        if (doctypeNode) {\n          