script-source,92,file:///mnt/d/blog/Firefly/node_modules/astro/dist/cli/index.js,import yargs from "yargs-parser";\nfunction resolveCommand(flags) {\n  const cmd = flags._[2];\n  if (flags.version) return "version";\n  const supportedCommands = /* @__PURE__ */ new Set([\n    "add"\x2C\n    "sync"\x2C\n    "telemetry"\x2C\n    "preferences"\x2C\n    "dev"\x2C\n    "build"\x2C\n    "preview"\x2C\n    "check"\x2C\n    "create-key"\x2C\n    "docs"\x2C\n    "db"\x2C\n    "info"\x2C\n    "login"\x2C\n    "logout"\x2C\n    "link"\x2C\n    "init"\n  ]);\n  if (supportedCommands.has(cmd)) {\n    return cmd;\n  }\n  return "help";\n}\nasync function runCommand(cmd\x2C flags) {\n  const [\n    { createLoggerFromFlags }\x2C\n    { piccoloreTextStyler: textStyler }\x2C\n    { BuildTimeAstroVersionProvider }\x2C\n    { LoggerHelpDisplay }\x2C\n    { CliCommandRunner }\n  ] = await Promise.all([\n    import("./flags.js")\x2C\n    import("./infra/piccolore-text-styler.js")\x2C\n    import("./infra/build-time-astro-version-provider.js")\x2C\n    import("./infra/logger-help-display.js")\x2C\n    import("./infra/cli-command-runner.js")\n  ]);\n  const logger = createLoggerFromFlags(flags);\n  const astroVersionProvider = new BuildTimeAstroVersionProvider();\n  const helpDisplay = new LoggerHelpDisplay({\n    logger\x2C\n    flags\x2C\n    textStyler\x2C\n    astroVersionProvider\n  });\n  const runner = new CliCommandRunner({ helpDisplay });\n  switch (cmd) {\n    /** Display --help flag */\n    case "help": {\n      const { DEFAULT_HELP_PAYLOAD } = await import("./help/index.js");\n      helpDisplay.show(DEFAULT_HELP_PAYLOAD);\n      return;\n    }\n    /** Display --version flag */\n    case "version": {\n      const { formatVersion } = await import("./utils/format-version.js");\n      logger.info(\n        "SKIP_FORMAT"\x2C\n        formatVersion({ name: "astro"\x2C textStyler\x2C astroVersionProvider })\n      );\n      return;\n    }\n    case "info": {\n      const [\n        { ProcessOperatingSystemProvider }\x2C\n        { CliAstroConfigResolver }\x2C\n        { ProcessPackageManagerUserAgentProvider }\x2C\n        { ProcessNodeVersionProvider }\x2C\n        { CliDebugInfoProvider }\x2C\n        { TinyexecCommandExecutor }\x2C\n        { getPackageManager }\x2C\n        { StyledDebugInfoFormatter }\x2C\n        { ClackPrompt }\x2C\n        { TinyclipClipboard }\x2C\n        { PassthroughTextStyler }\x2C\n        { infoCommand }\n      ] = await Promise.all([\n        import("./infra/process-operating-system-provider.js")\x2C\n        import("./info/infra/cli-astro-config-resolver.js")\x2C\n        import("./info/infra/process-package-manager-user-agent-provider.js")\x2C\n        import("./info/infra/process-node-version-provider.js")\x2C\n        import("./info/infra/cli-debug-info-provider.js")\x2C\n        import("./infra/tinyexec-command-executor.js")\x2C\n        import("./info/core/get-package-manager.js")\x2C\n        import("./info/infra/styled-debug-info-formatter.js")\x2C\n        import("./info/infra/clack-prompt.js")\x2C\n        import("./info/infra/tinyclip-clipboard.js")\x2C\n        import("./infra/passthrough-text-styler.js")\x2C\n        import("./info/core/info.js")\n      ]);\n      const operatingSystemProvider = new ProcessOperatingSystemProvider();\n      const astroConfigResolver = new CliAstroConfigResolver({ flags });\n      const commandExecutor = new TinyexecCommandExecutor();\n      const packageManagerUserAgentProvider = new ProcessPackageManagerUserAgentProvider();\n      const nodeVersionProvider = new ProcessNodeVersionProvider();\n      const debugInfoProvider = new CliDebugInfoProvider({\n        config: await astroConfigResolver.resolve()\x2C\n        astroVersionProvider\x2C\n        operatingSystemProvider\x2C\n        packageManager: await getPackageManager({\n          packageManagerUserAgentProvider\x2C\n          commandExecutor\n        })\x2C\n        nodeVersionProvider\n      });\n      const prompt = new ClackPrompt({ force: flags.copy });\n      const clipboard = new TinyclipClipboard({\n        logger\x2C\n        prompt\n      });\n      return await runner.run(infoCommand\x2C {\n        logger\x2C\n        debugInfoProvider\x2C\n        getDebugInfoFormatter: ({ pretty }) => new StyledDebugInfoFormatter({\n          textStyler: pretty ? textStyler : new PassthroughTextStyler()\n        })\x2C\n        clipboard\n      });\n    }\n    case "create-key": {\n      const [{ CryptoKeyGenerator }\x2C { createKeyCommand }] = await Promise.all([\n        import("./create-key/infra/crypto-key-generator.js")\x2C\n        import("./create-key/core/create-key.js")\n      ]);\n      const keyGenerator = new CryptoKeyGenerator();\n      return await runner.run(createKeyCommand\x2C { logger\x2C keyGenerator });\n    }\n    case "docs": {\n      const [\n        { TinyexecCommandExecutor }\x2C\n        { ProcessOperatingSystemProvider }\x2C\n        { ProcessCloudIdeProvider }\x2C\n        { openDocsCommand }\n      ] = await Promise.all([\n        import("./infra/tinyexec-command-executor.js")\x2C\n        import("./infra/process-operating-system-provider.js")\x2C\n        import("./docs/infra/process-cloud-ide-provider.js")\x2C\n        import("./docs/core/open-docs.js")\n      ]);\n      const commandExecutor = new TinyexecCommandExecutor();\n      const operatingSystemProvider = new ProcessOperatingSystemProvider();\n      const cloudIdeProvider = new ProcessCloudIdeProvider();\n      return await runner.run(openDocsCommand\x2C {\n        url: "https://docs.astro.build/"\x2C\n        logger\x2C\n        commandExecutor\x2C\n        operatingSystemProvider\x2C\n        cloudIdeProvider\n      });\n    }\n    case "telemetry": {\n      const { update } = await import("./telemetry/index.js");\n      const subcommand = flags._[3]?.toString();\n      await update(subcommand\x2C { flags });\n      return;\n    }\n    case "sync": {\n      const { sync } = await import("./sync/index.js");\n      await sync({ flags });\n      return;\n    }\n    case "preferences": {\n      const { preferences } = await import("./preferences/index.js");\n      const [subcommand\x2C key\x2C value] = flags._.slice(3).map((v) => v.toString());\n      const exitCode = await preferences(subcommand\x2C key\x2C value\x2C { flags });\n      return process.exit(exitCode);\n    }\n  }\n  if (flags.verbose) {\n    const { enableVerboseLogging } = await import("../core/logger/node.js");\n    enableVerboseLogging();\n  }\n  const { notify } = await import("./telemetry/index.js");\n  await notify();\n  switch (cmd) {\n    case "add": {\n      const { add } = await import("./add/index.js");\n      const packages = flags._.slice(3);\n      await add(packages\x2C { flags });\n      return;\n    }\n    case "db":\n    case "login":\n    case "logout":\n    case "link":\n    case "init": {\n      const { db } = await import("./db/index.js");\n      await db({ flags });\n      return;\n    }\n    case "dev": {\n      const { dev } = await import("./dev/index.js");\n      const server = await dev({ flags });\n      if (server) {\n        return await new Promise(() => {\n        });\n      }\n      return;\n    }\n    case "build": {\n      const { build } = await import("./build/index.js");\n      await build({ flags });\n      return;\n    }\n    case "preview": {\n      const { preview } = await import("./preview/index.js");\n      const server = await preview({ flags });\n      if (server) {\n        return await server.closed();\n      }\n      return;\n    }\n    case "check": {\n      const { check } = await import("./check/index.js");\n      const checkServer = await check(flags);\n      if (flags.watch) {\n        return await new Promise(() => {\n        });\n      } else {\n        return process.exit(typeof checkServer === "boolean" && checkServer ? 1 : 0);\n      }\n    }\n  }\n  throw new Error(`Error running ${cmd} -- no command found.`);\n}\nasync function cli(argv) {\n  const flags = yargs(argv\x2C { boolean: ["global"]\x2C alias: { g: "global" } });\n  const cmd = resolveCommand(flags);\n  try {\n    await runCommand(cmd\x2C flags);\n  } catch (err) {\n    const { throwAndExit } = await import("./throw-and-exit.js");\n    await throwAndExit(cmd\x2C err);\n  }\n}\nexport {\n  cli\n};\n
