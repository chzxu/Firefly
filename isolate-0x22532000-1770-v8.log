script-source,588,file:///mnt/d/blog/Firefly/node_modules/hast-util-to-html/lib/handle/root.js,/**\n * @import {Parents\x2C Root} from 'hast'\n * @import {State} from '../index.js'\n */\n\n/**\n * Serialize a root.\n *\n * @param {Root} node\n *   Node to handle.\n * @param {number | undefined} _1\n *   Index of `node` in `parent.\n * @param {Parents | undefined} _2\n *   Parent of `node`.\n * @param {State} state\n *   Info passed around about the current state.\n * @returns {string}\n *   Serialized node.\n */\nexport function root(node\x2C _1\x2C _2\x2C state) {\n  return state.all(node)\n}\n
