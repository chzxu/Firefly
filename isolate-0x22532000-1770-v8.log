script-source,595,file:///mnt/d/blog/Firefly/node_modules/mdast-util-gfm-table/lib/index.js,/**\n * @typedef {import('mdast').InlineCode} InlineCode\n * @typedef {import('mdast').Table} Table\n * @typedef {import('mdast').TableCell} TableCell\n * @typedef {import('mdast').TableRow} TableRow\n *\n * @typedef {import('markdown-table').Options} MarkdownTableOptions\n *\n * @typedef {import('mdast-util-from-markdown').CompileContext} CompileContext\n * @typedef {import('mdast-util-from-markdown').Extension} FromMarkdownExtension\n * @typedef {import('mdast-util-from-markdown').Handle} FromMarkdownHandle\n *\n * @typedef {import('mdast-util-to-markdown').Options} ToMarkdownExtension\n * @typedef {import('mdast-util-to-markdown').Handle} ToMarkdownHandle\n * @typedef {import('mdast-util-to-markdown').State} State\n * @typedef {import('mdast-util-to-markdown').Info} Info\n */\n\n/**\n * @typedef Options\n *   Configuration.\n * @property {boolean | null | undefined} [tableCellPadding=true]\n *   Whether to add a space of padding between delimiters and cells (default:\n *   `true`).\n * @property {boolean | null | undefined} [tablePipeAlign=true]\n *   Whether to align the delimiters (default: `true`).\n * @property {MarkdownTableOptions['stringLength'] | null | undefined} [stringLength]\n *   Function to detect the length of table cell content\x2C used when aligning\n *   the delimiters between cells (optional).\n */\n\nimport {ok as assert} from 'devlop'\nimport {markdownTable} from 'markdown-table'\nimport {defaultHandlers} from 'mdast-util-to-markdown'\n\n/**\n * Create an extension for `mdast-util-from-markdown` to enable GFM tables in\n * markdown.\n *\n * @returns {FromMarkdownExtension}\n *   Extension for `mdast-util-from-markdown` to enable GFM tables.\n */\nexport function gfmTableFromMarkdown() {\n  return {\n    enter: {\n      table: enterTable\x2C\n      tableData: enterCell\x2C\n      tableHeader: enterCell\x2C\n      tableRow: enterRow\n    }\x2C\n    exit: {\n      codeText: exitCodeText\x2C\n      table: exitTable\x2C\n      tableData: exit\x2C\n      tableHeader: exit\x2C\n      tableRow: exit\n    }\n  }\n}\n\n/**\n * @this {CompileContext}\n * @type {FromMarkdownHandle}\n */\nfunction enterTable(token) {\n  const align = token._align\n  assert(align\x2C 'expected `_align` on table')\n  this.enter(\n    {\n      type: 'table'\x2C\n      align: align.map(function (d) {\n        return d === 'none' ? null : d\n      })\x2C\n      children: []\n    }\x2C\n    token\n  )\n  this.data.inTable = true\n}\n\n/**\n * @this {CompileContext}\n * @type {FromMarkdownHandle}\n */\nfunction exitTable(token) {\n  this.exit(token)\n  this.data.inTable = undefined\n}\n\n/**\n * @this {CompileContext}\n * @type {FromMarkdownHandle}\n */\nfunction enterRow(token) {\n  this.enter({type: 'tableRow'\x2C children: []}\x2C token)\n}\n\n/**\n * @this {CompileContext}\n * @type {FromMarkdownHandle}\n */\nfunction exit(token) {\n  this.exit(token)\n}\n\n/**\n * @this {CompileContext}\n * @type {FromMarkdownHandle}\n */\nfunction enterCell(token) {\n  this.enter({type: 'tableCell'\x2C children: []}\x2C token)\n}\n\n// Overwrite the default code text data handler to unescape escaped pipes when\n// they are in tables.\n/**\n * @this {CompileContext}\n * @type {FromMarkdownHandle}\n */\nfunction exitCodeText(token) {\n  let value = this.resume()\n\n  if (this.data.inTable) {\n    value = value.replace(/\\\\([\\\\|])/g\x2C replace)\n  }\n\n  const node = this.stack[this.stack.length - 1]\n  assert(node.type === 'inlineCode')\n  node.value = value\n  this.exit(token)\n}\n\n/**\n * @param {string} $0\n * @param {string} $1\n * @returns {string}\n */\nfunction replace($0\x2C $1) {\n  // Pipes work\x2C backslashes don\u2019t (but can\u2019t escape pipes).\n  return $1 === '|' ? $1 : $0\n}\n\n/**\n * Create an extension for `mdast-util-to-markdown` to enable GFM tables in\n * markdown.\n *\n * @param {Options | null | undefined} [options]\n *   Configuration.\n * @returns {ToMarkdownExtension}\n *   Extension for `mdast-util-to-markdown` to enable GFM tables.\n */\nexport function gfmTableToMarkdown(options) {\n  const settings = options || {}\n  const padding = settings.tableCellPadding\n  const alignDelimiters = settings.tablePipeAlign\n  const stringLength = settings.stringLength\n  const around = padding ? ' ' : '|'\n\n  return {\n    unsafe: [\n      {character: '\\r'\x2C inConstruct: 'tableCell'}\x2C\n      {character: '\\n'\x2C inConstruct: 'tableCell'}\x2C\n      // A pipe\x2C when followed by a tab or space (padding)\x2C or a dash or colon\n      // (unpadded delimiter row)\x2C could result in a table.\n      {atBreak: true\x2C character: '|'\x2C after: '[\\t :-]'}\x2C\n      // A pipe in a cell must be encoded.\n      {character: '|'\x2C inConstruct: 'tableCell'}\x2C\n      // A colon must be followed by a dash\x2C in which case it could start a\n      // delimiter row.\n      {atBreak: true\x2C character: ':'\x2C after: '-'}\x2C\n      // A delimiter row can also start with a dash\x2C when followed by more\n      // dashes\x2C a colon\x2C or a pipe.\n      // This is a stricter version than the built in check for lists\x2C thematic\n      // breaks\x2C and setex heading underlines though:\n      // <https://github.com/syntax-tree/mdast-util-to-markdown/blob/51a2038/lib/unsafe.js#L57>\n      {atBreak: true\x2C character: '-'\x2C after: '[:|-]'}\n    ]\x2C\n    handlers: {\n      inlineCode: inlineCodeWithTable\x2C\n      table: handleTable\x2C\n      tableCell: handleTableCell\x2C\n      tableRow: handleTableRow\n    }\n  }\n\n  /**\n   * @type {ToMarkdownHandle}\n   * @param {Table} node\n   */\n  function handleTable(node\x2C _\x2C state\x2C info) {\n    return serializeData(handleTableAsData(node\x2C state\x2C info)\x2C node.align)\n  }\n\n  /**\n   * This function isn\u2019t really used normally\x2C because we handle rows at the\n   * table level.\n   * But\x2C if someone passes in a table row\x2C this ensures we make somewhat sense.\n   *\n   * @type {ToMarkdownHandle}\n   * @param {TableRow} node\n   */\n  function handleTableRow(node\x2C _\x2C state\x2C info) {\n    const row = handleTableRowAsData(node\x2C state\x2C info)\n    const value = serializeData([row])\n    // `markdown-table` will always add an align row\n    return value.slice(0\x2C value.indexOf('\\n'))\n  }\n\n  /**\n   * @type {ToMarkdownHandle}\n   * @param {TableCell} node\n   */\n  function handleTableCell(node\x2C _\x2C state\x2C info) {\n    const exit = state.enter('tableCell')\n    const subexit = state.enter('phrasing')\n    const value = state.containerPhrasing(node\x2C {\n      ...info\x2C\n      before: around\x2C\n      after: around\n    })\n    subexit()\n    exit()\n    return value\n  }\n\n  /**\n   * @param {Array<Array<string>>} matrix\n   * @param {Array<string | null | undefined> | null | undefined} [align]\n   */\n  function serializeData(matrix\x2C align) {\n    return markdownTable(matrix\x2C {\n      align\x2C\n      // @ts-expect-error: `markdown-table` types should support `null`.\n      alignDelimiters\x2C\n      // @ts-expect-error: `markdown-table` types should support `null`.\n      padding\x2C\n      // @ts-expect-error: `markdown-table` types should support `null`.\n      stringLength\n    })\n  }\n\n  /**\n   * @param {Table} node\n   * @param {State} state\n   * @param {Info} info\n   */\n  function handleTableAsData(node\x2C state\x2C info) {\n    const children = node.children\n    let index = -1\n    /** @type {Array<Array<string>>} */\n    const result = []\n    const subexit = state.enter('table')\n\n    while (++index < children.length) {\n      result[index] = handleTableRowAsData(children[index]\x2C state\x2C info)\n    }\n\n    subexit()\n\n    return result\n  }\n\n  /**\n   * @param {TableRow} node\n   * @param {State} state\n   * @param {Info} info\n   */\n  function handleTableRowAsData(node\x2C state\x2C info) {\n    const children = node.children\n    let index = -1\n    /** @type {Array<string>} */\n    const result = []\n    const subexit = state.enter('tableRow')\n\n    while (++index < children.length) {\n      // Note: the positional info as used here is incorrect.\n      // Making it correct would be impossible due to aligning cells?\n      // And it would need copy/pasting `markdown-table` into this project.\n      result[index] = handleTableCell(children[index]\x2C node\x2C state\x2C info)\n    }\n\n    subexit()\n\n    return result\n  }\n\n  /**\n   * @type {ToMarkdownHandle}\n   * @param {InlineCode} node\n   */\n  function inlineCodeWithTable(node\x2C parent\x2C state) {\n    let value = defaultHandlers.inlineCode(node\x2C parent\x2C state)\n\n    if (state.stack.includes('tableCell')) {\n      value = value.replace(/\\|/g\x2C '\\\\$&')\n    }\n\n    return value\n  }\n}\n
