script-source,318,file:///mnt/d/blog/Firefly/node_modules/rehype-stringify/lib/index.js,/**\n * @import {Root} from 'hast'\n * @import {Options} from 'hast-util-to-html'\n * @import {Compiler\x2C Processor} from 'unified'\n */\n\nimport {toHtml} from 'hast-util-to-html'\n\n/**\n * Plugin to add support for serializing as HTML.\n *\n * @param {Options | null | undefined} [options]\n *   Configuration (optional).\n * @returns {undefined}\n *   Nothing.\n */\nexport default function rehypeStringify(options) {\n  /** @type {Processor<undefined\x2C undefined\x2C undefined\x2C Root\x2C string>} */\n  // @ts-expect-error: TS in JSDoc generates wrong types if `this` is typed regularly.\n  const self = this\n  const settings = {...self.data('settings')\x2C ...options}\n\n  self.compiler = compiler\n\n  /**\n   * @type {Compiler<Root\x2C string>}\n   */\n  function compiler(tree) {\n    return toHtml(tree\x2C settings)\n  }\n}\n
