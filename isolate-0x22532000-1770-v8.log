script-source,756,file:///mnt/d/blog/Firefly/node_modules/mdast-util-to-markdown/lib/util/check-emphasis.js,/**\n * @import {Options\x2C State} from 'mdast-util-to-markdown'\n */\n\n/**\n * @param {State} state\n * @returns {Exclude<Options['emphasis']\x2C null | undefined>}\n */\nexport function checkEmphasis(state) {\n  const marker = state.options.emphasis || '*'\n\n  if (marker !== '*' && marker !== '_') {\n    throw new Error(\n      'Cannot serialize emphasis with `' +\n        marker +\n        '` for `options.emphasis`\x2C expected `*`\x2C or `_`'\n    )\n  }\n\n  return marker\n}\n
