script-source,428,file:///mnt/d/blog/Firefly/node_modules/mdast-util-to-hast/lib/handlers/table-cell.js,/**\n * @import {Element} from 'hast'\n * @import {TableCell} from 'mdast'\n * @import {State} from '../state.js'\n */\n\n/**\n * Turn an mdast `tableCell` node into hast.\n *\n * @param {State} state\n *   Info passed around.\n * @param {TableCell} node\n *   mdast node.\n * @returns {Element}\n *   hast node.\n */\nexport function tableCell(state\x2C node) {\n  // Note: this function is normally not called: see `table-row` for how rows\n  // and their cells are compiled.\n  /** @type {Element} */\n  const result = {\n    type: 'element'\x2C\n    tagName: 'td'\x2C // Assume body cell.\n    properties: {}\x2C\n    children: state.all(node)\n  }\n  state.patch(node\x2C result)\n  return state.applyData(node\x2C result)\n}\n
