script-source,711,file:///mnt/d/blog/Firefly/node_modules/stringify-entities/lib/util/format-basic.js,/**\n * The smallest way to encode a character.\n *\n * @param {number} code\n * @returns {string}\n */\nexport function formatBasic(code) {\n  return '&#x' + code.toString(16).toUpperCase() + ';'\n}\n
