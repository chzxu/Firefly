script-source,552,file:///mnt/d/blog/Firefly/node_modules/micromark-util-encode/index.js,const characterReferences = {'"': 'quot'\x2C '&': 'amp'\x2C '<': 'lt'\x2C '>': 'gt'}\n\n/**\n * Encode only the dangerous HTML characters.\n *\n * This ensures that certain characters which have special meaning in HTML are\n * dealt with.\n * Technically\x2C we can skip `>` and `"` in many cases\x2C but CM includes them.\n *\n * @param {string} value\n *   Value to encode.\n * @returns {string}\n *   Encoded value.\n */\nexport function encode(value) {\n  return value.replace(/["&<>]/g\x2C replace)\n\n  /**\n   * @param {string} value\n   *   Value to replace.\n   * @returns {string}\n   *   Encoded value.\n   */\n  function replace(value) {\n    return (\n      '&' +\n      characterReferences[\n        /** @type {keyof typeof characterReferences} */ (value)\n      ] +\n      ';'\n    )\n  }\n}\n
