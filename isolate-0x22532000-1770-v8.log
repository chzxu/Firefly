script-source,277,file:///mnt/d/blog/Firefly/node_modules/@astrojs/markdown-remark/dist/index.js,import rehypeRaw from "rehype-raw";\nimport rehypeStringify from "rehype-stringify";\nimport remarkGfm from "remark-gfm";\nimport remarkParse from "remark-parse";\nimport remarkRehype from "remark-rehype";\nimport remarkSmartypants from "remark-smartypants";\nimport { unified } from "unified";\nimport { VFile } from "vfile";\nimport { defaultExcludeLanguages } from "./highlight.js";\nimport { loadPlugins } from "./load-plugins.js";\nimport { rehypeHeadingIds } from "./rehype-collect-headings.js";\nimport { rehypeImages } from "./rehype-images.js";\nimport { rehypePrism } from "./rehype-prism.js";\nimport { rehypeShiki } from "./rehype-shiki.js";\nimport { remarkCollectImages } from "./remark-collect-images.js";\nimport {\n  extractFrontmatter\x2C\n  isFrontmatterValid\x2C\n  parseFrontmatter\n} from "./frontmatter.js";\nimport { rehypeHeadingIds as rehypeHeadingIds2 } from "./rehype-collect-headings.js";\nimport { rehypePrism as rehypePrism2 } from "./rehype-prism.js";\nimport { rehypeShiki as rehypeShiki2 } from "./rehype-shiki.js";\nimport { remarkCollectImages as remarkCollectImages2 } from "./remark-collect-images.js";\nimport {\n  createShikiHighlighter\n} from "./shiki.js";\nexport * from "./types.js";\nconst syntaxHighlightDefaults = {\n  type: "shiki"\x2C\n  excludeLangs: defaultExcludeLanguages\n};\nconst markdownConfigDefaults = {\n  syntaxHighlight: syntaxHighlightDefaults\x2C\n  shikiConfig: {\n    langs: []\x2C\n    theme: "github-dark"\x2C\n    themes: {}\x2C\n    wrap: false\x2C\n    transformers: []\x2C\n    langAlias: {}\n  }\x2C\n  remarkPlugins: []\x2C\n  rehypePlugins: []\x2C\n  remarkRehype: {}\x2C\n  gfm: true\x2C\n  smartypants: true\n};\nconst isPerformanceBenchmark = Boolean(process.env.ASTRO_PERFORMANCE_BENCHMARK);\nasync function createMarkdownProcessor(opts) {\n  const {\n    syntaxHighlight = markdownConfigDefaults.syntaxHighlight\x2C\n    shikiConfig = markdownConfigDefaults.shikiConfig\x2C\n    remarkPlugins = markdownConfigDefaults.remarkPlugins\x2C\n    rehypePlugins = markdownConfigDefaults.rehypePlugins\x2C\n    remarkRehype: remarkRehypeOptions = markdownConfigDefaults.remarkRehype\x2C\n    gfm = markdownConfigDefaults.gfm\x2C\n    smartypants = markdownConfigDefaults.smartypants\n  } = opts ?? {};\n  const loadedRemarkPlugins = await Promise.all(loadPlugins(remarkPlugins));\n  const loadedRehypePlugins = await Promise.all(loadPlugins(rehypePlugins));\n  const parser = unified().use(remarkParse);\n  if (!isPerformanceBenchmark) {\n    if (gfm) {\n      parser.use(remarkGfm);\n    }\n    if (smartypants !== false) {\n      const smartypantsConfig = typeof smartypants === "object" ? smartypants : {};\n      parser.use(remarkSmartypants\x2C smartypantsConfig);\n    }\n  }\n  for (const [plugin\x2C pluginOpts] of loadedRemarkPlugins) {\n    parser.use(plugin\x2C pluginOpts);\n  }\n  if (!isPerformanceBenchmark) {\n    parser.use(remarkCollectImages\x2C opts?.image);\n  }\n  parser.use(remarkRehype\x2C {\n    allowDangerousHtml: true\x2C\n    passThrough: []\x2C\n    ...remarkRehypeOptions\n  });\n  if (syntaxHighlight && !isPerformanceBenchmark) {\n    const syntaxHighlightType = typeof syntaxHighlight === "string" ? syntaxHighlight : syntaxHighlight?.type;\n    const excludeLangs = typeof syntaxHighlight === "object" ? syntaxHighlight?.excludeLangs : void 0;\n    if (syntaxHighlightType === "shiki") {\n      parser.use(rehypeShiki\x2C shikiConfig\x2C excludeLangs);\n    } else if (syntaxHighlightType === "prism") {\n      parser.use(rehypePrism\x2C excludeLangs);\n    }\n  }\n  for (const [plugin\x2C pluginOpts] of loadedRehypePlugins) {\n    parser.use(plugin\x2C pluginOpts);\n  }\n  parser.use(rehypeImages);\n  if (!isPerformanceBenchmark) {\n    parser.use(rehypeHeadingIds);\n  }\n  parser.use(rehypeRaw).use(rehypeStringify\x2C { allowDangerousHtml: true });\n  return {\n    async render(content\x2C renderOpts) {\n      const vfile = new VFile({\n        value: content\x2C\n        path: renderOpts?.fileURL\x2C\n        data: {\n          astro: {\n            frontmatter: renderOpts?.frontmatter ?? {}\n          }\n        }\n      });\n      const result = await parser.process(vfile).catch((err) => {\n        err = prefixError(err\x2C `Failed to parse Markdown file "${vfile.path}"`);\n        console.error(err);\n        throw err;\n      });\n      return {\n        code: String(result.value)\x2C\n        metadata: {\n          headings: result.data.astro?.headings ?? []\x2C\n          localImagePaths: result.data.astro?.localImagePaths ?? []\x2C\n          remoteImagePaths: result.data.astro?.remoteImagePaths ?? []\x2C\n          frontmatter: result.data.astro?.frontmatter ?? {}\n        }\n      };\n    }\n  };\n}\nfunction prefixError(err\x2C prefix) {\n  if (err?.message) {\n    try {\n      err.message = `${prefix}:\n${err.message}`;\n      return err;\n    } catch {\n    }\n  }\n  const wrappedError = new Error(`${prefix}${err ? `: ${err}` : ""}`);\n  try {\n    wrappedError.stack = err.stack;\n    wrappedError.cause = err;\n  } catch {\n  }\n  return wrappedError;\n}\nexport {\n  createMarkdownProcessor\x2C\n  createShikiHighlighter\x2C\n  extractFrontmatter\x2C\n  isFrontmatterValid\x2C\n  markdownConfigDefaults\x2C\n  parseFrontmatter\x2C\n  rehypeHeadingIds2 as rehypeHeadingIds\x2C\n  rehypePrism2 as rehypePrism\x2C\n  rehypeShiki2 as rehypeShiki\x2C\n  remarkCollectImages2 as remarkCollectImages\x2C\n  syntaxHighlightDefaults\n};\n
