fn) {\n    install(event);\n\n    const ref = new SafeWeakRef(obj);\n    ref.fn = fn;\n\n    registry ||= new SafeFinalizationRegistry(clear);\n    registry.register(obj\x2C ref);\n\n    ArrayPrototypePush(refs[event]\x2C ref);\n  }\n\n  /**\n   * Execute the given function when the process exits\x2C\n   * and clean things up when the object is gc.\n   * @param {any} obj\n   * @param {Function} fn\n   */\n  function register(obj\x2C fn) {\n    emitExperimentalWarning('process.finalization.register');\n    validateObject(obj\x2C 'obj'\x2C kValidateObjectAllowFunction);\n\n    _register('exit'\x2C obj\x2C fn);\n  }\n\n  /**\n   * Execute the given function before the process exits\x2C\n   * and clean things up when the object is gc.\n   * @param {any} obj\n   * @param {Function} fn\n   */\n  function registerBeforeExit(obj\x2C fn) {\n    emitExperimentalWarning('process.finalization.registerBeforeExit');\n    validateObject(obj\x2C 'obj'\x2C kValidateObjectAllowFunction);\n\n    _register('beforeExit'\x2C obj\x2C fn);\n  }\n\n  /**\n   * Unregister the given object from the onExit or onBeforeExit event.\n   * @param {object} obj\n   */\n  function unregister(obj) {\n    emitExperimentalWarning('process.finalization.unregister');\n    if (!registry) {\n      return;\n    }\n    registry.unregister(obj);\n    for (const event of ['exit'\x2C 'beforeExit']) {\n      refs[event] = ArrayPrototypeFilter(refs[event]\x2C (ref) => {\n        const _obj = ref.deref();\n        return _obj && _obj !== obj;\n      });\n      uninstall(event);\n    }\n  }\n\n  return {\n    register\x2C\n    registerBeforeExit\x2C\n    unregister\x2C\n  };\n}\n\nmodule.exports = {\n  createFinalization\x2C\n};\n
