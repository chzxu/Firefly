n\x09\x09 * By default\x2C if Prism is in a web worker\x2C it assumes that it is in a worker it created itself\x2C so it uses\n\x09\x09 * `addEventListener` to communicate with its parent instance. However\x2C if you're using Prism manually in your\n\x09\x09 * own worker\x2C you don't want it to do this.\n\x09\x09 *\n\x09\x09 * By setting this value to `true`\x2C Prism will not add its own listeners to the worker.\n\x09\x09 *\n\x09\x09 * You obviously have to change this value before Prism executes. To do this\x2C you can add an\n\x09\x09 * empty Prism object into the global scope before loading the Prism script like this:\n\x09\x09 *\n\x09\x09 * ```js\n\x09\x09 * window.Prism = window.Prism || {};\n\x09\x09 * Prism.disableWorkerMessageHandler = true;\n\x09\x09 * // Load Prism's script\n\x09\x09 * ```\n\x09\x09 *\n\x09\x09 * @default false\n\x09\x09 * @type {boolean}\n\x09\x09 * @memberof Prism\n\x09\x09 * @public\n\x09\x09 */\n\x09\x09disableWorkerMessageHandler: _self.Prism && _self.Prism.disableWorkerMessageHandler\x2C\n\n\x09\x09/**\n\x09\x09 * A namespace for utility methods.\n\x09\x09 *\n\x09\x09 * All function in this namespace that are not explicitly marked as _public_ are for __internal use only__ and may\n\x09\x09 * change or disappear at any time.\n\x09\x09 *\n\x09\x09 * @namespace\n\x09\x09 * @memberof Prism\n\x09\x09 */\n\x09\x09util: {\n\x09\x09\x09encode: function encode(tokens) {\n\x09\x09\x09\x09if (tokens instanceof Token) {\n\x09\x09\x09\x09\x09return new Token(tokens.type\x2C encode(tokens.content)\x2C tokens.alias);\n\x09\x09\x09\x09} else if (Array.isArray(tokens)) {\n\x09\x09\x09\x09\x09return tokens.map(encode);\n\x09\x09\x09\x09} else {\n\x09\x09\x09\x09\x09return tokens.replace(/&/g\x2C '&amp;').replace(/</g\x2C '&lt;').replace(/\\u00a0/g\x2C ' ');\n\x09\x09\x09\x09}\n\x09\x09\x09}\x2C\n\n\x09\x09\x09/**\n\x09\x09\x09 * Returns the name of the type of the given value.\n\x09\x09\x09 *\n\x09\x09\x09 * @param {any} o\n\x09\x09\x09 * @returns {string}\n\x09\x09\x09 * @example\n\x09\x09\x09 * type(null)      === 'Null'\n\x09\x09\x09 * type(undefined) === 'Undefined'\n\x09\x09\x09 * type(123)       === 'Number'\n\x09\x09\x09 * type('foo')     === 'String'\n\x09\x09\x09 * type(true)      === 'Boolean'\n\x09\x09\x09 * type([1\x2C 2])    === 'Array'\n\x09\x09\x09 * type({})        === 'Object'\n\x09\x09\x09 * type(String)    === 'Function'\n\x09\x09\x09 * type(/abc+/)    === 'RegExp'\n\x09\x09\x09 */\n\x09\x09\x09type: function (o) {\n\x09\x09\x09\x09return Object.prototype.toString.call(o).slice(8\x2C -1);\n\x09\x09\x09}\x2C\n\n\x09\x09\x09/**\n\x09\x09\x09 * Returns a unique number for the given object. Later calls will still return the same number.\n\x09\x09\x09 *\n\x09\x09\x09 * @param {Object} obj\n\x09\x09\x09 * @returns {number}\n\x09\x09\x09 */\n\x09\x09\x09objId: function (obj) {\n\x09\x09\x09\x09if (!obj['__id']) {\n\x09\x09\x09\x09\x09Object.defineProperty(obj\x2C '__id'\x2C { value: ++uniqueId });\n\x09\x09\x09\x09}\n\x09\x09\x09\x09return obj['__id'];\n\x09\x09\x09}\x2C\n\n\x09\x09\x09/**\n\x09\x09\x09 * Creates a deep clone of the given object.\n\x09\x09\x09 *\n\x09\x09\x09 * The main intended use of this function is to clone language definitions.\n\x09\x09\x09 *\n\x09\x09\x09 * @param {T} o\n\x09\x09\x09 * @param {Record<number\x2C any>} [visited]\n\x09\x09\x09 * @returns {T}\n\x09\x09\x09 * @template T\n\x09\x09\x09 */\n\x09\x09\x09clone: function deepClone(o\x2C visited) {\n\x09\x09\x09\x09visited = visited || {};\n\n\x09\x09\x09\x09var clone; var id;\n\x09\x09\x09\x09switch (_.util.type(o)) {\n\x09\x09\x09\x09\x09case 'Object':\n\x09\x09\x09\x09\x09\x09id = _.util.objId(o);\n\x09\x09\x09\x09\x09\x09if (visited[id]) {\n\x09\x09\x09\x09\x09\x09\x09return visited[id];\n\x09\x09\x09\x09\x09\x09}\n\x09\x09\x09\x09\x09\x09clone = /** @type {Record<string\x2C any>} */ ({});\n\x09\x09\x09\x09\x09\x09visited[id] = clone;\n\n\x09\x09\x09\x09\x09\x09for (var key in o) {\n\x09\x09\x09\x09\x09\x09\x09if (o.hasOwnProperty(key)) {\n\x09\x09\x09\x09\x09\x09\x09\x09clone[key] = deepClone(o[key]\x2C visited);\n\x09\x09\x09\x09\x09\x09\x09}\n\x09\x09\x09\x09\x09\x09}\n\n\x09\x09\x09\x09\x09\x09return /** @type {any} */ (clone);\n\n\x09\x09\x09\x09\x09case 'Array':\n\x09\x09\x09\x09\x09\x09id = _.util.objId(o);\n\x09\x09\x09\x09\x09\x09if (visited[id]) {\n\x09\x09\x09\x09\x09\x09\x09return visited[id];\n\x09\x09\x09\x09\x09\x09}\n\x09\x09\x09\x09\x09\x09clone = [];\n\x09\x09\x09\x09\x09\x09visited[id] = clone;\n\n\x09\x09\x09\x09\x09\x09(/** @type {Array} */(/** @type {any} */(o))).forEach(function (v\x2C i) {\n\x09\x09\x09\x09\x09\x09\x09clone[i] = deepClone(v\x2C visited);\n\x09\x09\x09\x09\x09\x09});\n\n\x09\x09\x09\x09\x09\x09return /** @type {any} */ (clone);\n\n\x09\x09\x09\x09\x09default:\n\x09\x09\x09\x09\x09\x09return o;\n\x09\x09\x09\x09}\n\x09\x09\x09}\x2C\n\n\x09\x09\x09/**\n\x09\x09\x09 * Returns the Prism language of the given element set by a `language-xxxx` or `lang-xxxx` class.\n\x09\x09\x09 *\n\x09\x09\x09 * If no language is set for the element or the element is `null` or `undefined`\x2C `none` will be returned.\n\x09\x09\x09 *\n\x09\x09\x09 * @param {Element} element\n\x09\x09\x09 * @returns {string}\n\x09\x09\x09 */\n\x09\x09\x09getLanguage: function (element) {\n\x09\x09\x09\x09while (element) {\n\x09\x09\x09\x09\x09var m = lang.exec(element.className);\n\x09\x09\x09\x09\x09if (m) {\n\x09\x09\x09\x09\x09\x09return m[1].toLowerCase();\n\x09\x09\x09\x09\x09}\n\x09\x09\x09\x09\x09element = element.parentElement;\n\x09\x09\x09\x09}\n\x09\x09\x09\x09return 'none';\n\x09\x09\x09}\x2C\n\n\x09\x09\x09/**\n\x09\x09\x09 * Sets the Prism `language-xxxx` class of the given element.\n\x09\x09\x09 *\n\x09\x09\x09 * @param {Element} element\n\x09\x09\x09 * @param {string} language\n\x09\x09\x09 * @returns {void}\n\x09\x09\x09 */\n\x09\x09\x09setLanguage: function (element\x2C language) {\n\x09\x09\x09\x09// remove all `language-xxxx` classes\n\x09\x09\x09\x09// (this might leave behind a leading space)\n\x09\x09\x09\x09element.className = element.className.replace(RegExp(lang\x2C 'gi')\x2C '');\n\n\x09\x09\x09\x09// add the new `language-xxxx` class\n\x09\x09\x09\x09// (using `classList` will automatically clean up spaces for us)\n\x09\x09\x09\x09element.classList.add('language-' + language);\n\x09\x09\x09}\x2C\n\n\x09\x09\x09/**\n\x09\x09\x09 * Returns the script element that is currently executing.\n\x09\x09\x09 *\n\x09\x09\x09 * This does __not__ work for line script element.\n\x09\x09\x09 *\n\x09\x09\x09 * @returns {HTMLScriptElement | null}\n\x09\x09\x09 */\n\x09\x09\x09currentScript: function () {\n\x09\x09\x09\x09if (typeof document === 'undefined') {\n\x09\x09\x09\x09\x09return null;\n\x09\x09\x09\x09}\n\x09\x09\x09\x09if (document.currentScript && document.currentScript.tagName === 'SCRIPT' && 1 < 2 /* hack to trip TS' flow analysis */) {\n\x09\x09\x09\x09\x09return /** @type {any} */ (document.currentScript);\n\x09\x09\x09\x09}\n\n\x09\x09\x09\x09// IE11 workaround\n\x09\x09\x09\x09// we'll get the src of the current script by parsing IE11's error stack trace\n\x09\x09\x09\x09// this will not work for inline scripts\n\n\x09\x09\x09\x09try {\n\x09\x09\x09\x09\x09throw new Error();\n\x09\x09\x09\x09} catch (err) {\n\x09\x09\x09\x09\x09// Get file src url from stack. Specifically works with the format of stack traces in IE.\n\x09\x09\x09\x09\x09// A stack will look like this:\n\x09\x09\x09\x09\x09//\n\x09\x09\x09\x09\x09// Error\n\x09\x09\x09\x09\x09//    at _.util.currentScript (http://localhost/components/prism-core.js:119:5)\n\x09\x09\x09\x09\x09//    at Global code (http://localhost/components/prism-core.js:606:1)\n\n\x09\x09\x09\x09\x09var src = (/at [^(\\r\\n]*\\((.*):[^:]+:[^:]+\\)$/i.exec(err.stack) || [])[1];\n\x09\x09\x09\x09\x09if (src) {\n\x09\x09\x09\x09\x09\x09var scripts = document.getElementsByTagName('script');\n\x09\x09\x09\x09\x09\x09for (var i in scripts) {\n\x09\x09\x09\x09\x09\x09\x09if (scripts[i].src == src) {\n\x09\x09\x09\x09\x09\x09\x09\x09return scripts[i];\n\x09\x09\x09\x09\x09\x09\x09}\n\x09\x09\x09\x09\x09\x09}\n\x09\x09\x09\x09\x09}\n\x09\x09\x09\x09\x09return null;\n\x09\x09\x09\x09}\n\x09\x09\x09}\x2C\n\n\x09\x09\x09/**\n\x09\x09\x09 * Returns whether a given class is active for `element`.\n\x09\x09\x09 *\n\x09\x09\x09 * The class can be activated if `element` or one of its ancestors has the given class and it can be deactivated\n\x09\x09\x09 * if `element` or one of its ancestors has the negated version of the given class. The _negated version_ of the\n\x09\x09\x09 * given class is just the given class with a `no-` prefix.\n\x09\x09\x09 *\n\x09\x09\x09 * Whether the class is active is determined by the closest ancestor of `element` (where `element` itself is\n\x09\x09\x09 * closest ancestor) that has the given class or the negated version of it. If neither `element` nor any of its\n\x09\x09\x09 * ancestors have the given class or the negated version of it\x2C then the default activation will be returned.\n\x09\x09\x09 *\n\x09\x09\x09 * In the paradoxical situation where the closest ancestor contains __both__ the given class and the negated\n\x09\x09\x09 * version of it\x2C the class is considered active.\n\x09\x09\x09 *\n\x09\x09\x09 * @param {Element} element\n\x09\x09\x09 * @param {string} className\n\x09\x09\x09 * @param {boolean} [defaultActivation=false]\n\x09\x09\x09 * @returns {boolean}\n\x09\x09\x09 */\n\x09\x09\x09isActive: function (element\x2C className\x2C defaultActivation) {\n\x09\x09\x09\x09var no = 'no-' + className;\n\n\x09\x09\x09\x09while (element) {\n\x09\x09\x09\x09\x09var classList = element.classList;\n\x09\x09\x09\x09\x09if (classList.contains(className)) {\n\x09\x09\x09\x09\x09\x09return true;\n\x09\x09\x09\x09\x09}\n\x09\x09\x09\x09\x09if (classList.contains(no)) {\n\x09\x09\x09\x09\x09\x09return false;\n\x09\x09\x09\x09\x09}\n\x09\x09\x09\x09\x09element = element.parentElement;\n\x09\x09\x09\x09}\n\x09\x09\x09\x09return !!defaultActivation;\n\x09\x09\x09}\n\x09\x09}\x2C\n\n\x09\x09/**\n\x09\x09 * This namespace contains all currently loaded languages and the some helper functions to create and modify languages.\n\x09\x09 *\n\x09\x09 * @namespace\n\x09\x09 * @memberof Prism\n\x09\x09 * @public\n\x09\x09 */\n\x09\x09languages: {\n\x09\x09\x09/**\n\x09\x09\x09 * The grammar for plain\x2C unformatted text.\n\x09\x09\x09 */\n\x09\x09\x09plain: plainTextGrammar\x2C\n\x09\x09\x09plaintext: plainTextGrammar\x2C\n\x09\x09\x09text: plainTextGrammar\x2C\n\x09\x09\x09txt: plainTextGrammar\x2C\n\n\x09\x09\x09/**\n\x09\x09\x09 * Creates a deep copy of the language with the given id and appends the given tokens.\n\x09\x09\x09 *\n\x09\x09\x09 * If a token in `redef` also appears in the copied language\x2C then the existing token in the copied language\n\x09\x09\x09 * will be overwritten at its original position.\n\x09\x09\x09 *\n\x09\x09\x09 * ## Best practices\n\x09\x09\x09 *\n\x09\x09\x09 * Since the position of overwriting tokens (token in `redef` that overwrite tokens in the copied language)\n\x09\x09\x09 * doesn't matter\x2C they can technically be in any order. However\x2C this can be confusing to others that trying to\n\x09\x09\x09 * understand the language definition because\x2C normally\x2C the order of tokens matters in Prism grammars.\n\x09\x09\x09 *\n\x09\x09\x09 * Therefore\x2C it is encouraged to order overwriting tokens according to the positions of the overwritten tokens.\n\x09\x09\x09 * Furthermore\x2C all non-overwriting tokens should be placed after the overwriting ones.\n\x09\x09\x09 *\n\x09\x09\x09 * @param {string} id The id of the language to extend. This has to be a key in `Prism.languages`.\n\x09\x09\x09 * @param {Grammar} redef The new tokens to append.\n\x09\x09\x09 * @returns {Grammar} The new language created.\n\x09\x09\x09 * @public\n\x09\x09\x09 * @example\n\x09\x09\x09 * Prism.languages['css-with-colors'] = Prism.languages.extend('css'\x2C {\n\x09\x09\x09 *     // Prism.languages.css already has a 'comment' token\x2C so this token will overwrite CSS' 'comment' token\n\x09\x09\x09 *     // at its original position\n\x09\x09\x09 *     'comment': { ... }\x2C\n\x09\x09\x09 *     // CSS doesn't have a 'color' token\x2C so this token will be appended\n\x09\x09\x09 *     'color': /\\b(?:red|green|blue)\\b/\n\x09\x09\x09 * });\n\x09\x09\x09 */\n\x09\x09\x09extend: function (id\x2C redef) {\n\x09\x09\x09\x09var lang = _.util.clone(_.languages[id]);\n\n\x09\x09\x09\x09for (var key in redef) {\n\x09\x09\x09\x09\x09lang[key] = redef[key];\n\x09\x09\x09\x09}\n\n\x09\x09\x09\x09return lang;\n\x09\x09\x09}\x2C\n\n\x09\x09\x09/**\n\x09\x09\x09 * Inserts tokens _before_ another token in a language definition or any other grammar.\n\x09\x09\x09 *\n\x09\x09\x09 * ## Usage\n\x09\x09\x09 *\n\x09\x09\x09 * This helper method makes it easy to modify existing languages. For example\x2C the CSS language definition\n\x09\x09\x09 * not only defines CSS highlighting for CSS documents\x2C but also needs to define highlighting for CSS embedded\n\x09\x09\x09 * in HTML through `<style>` elements. To do this\x2C it needs to modify `Prism.languages.markup` and add the\n\x09\x09\x09 * appropriate tokens. However\x2C `Prism.languages.markup` is a regular JavaScript object literal\x2C so if you do\n\x09\x09\x09 * this:\n\x09\x09\x09 *\n\x09\x09\x09 * ```js\n\x09\x09\x09 * Prism.languages.markup.style = {\n\x09\x09\x09 *     // token\n\x09\x09\x09 * };\n\x09\x09\x09 * ```\n\x09\x09\x09 *\n\x09\x09\x09 * then the `style` token will be added (and processed) at the end. `insertBefore` allows you to insert tokens\n\x09\x09\x09 * before existing tokens. For the CSS example above\x2C you would use it like this:\n\x09\x09\x09 *\n\x09\x09\x09 * ```js\n\x09\x09\x09 * Prism.languages.insertBefore('markup'\x2C 'cdata'\x2C {\n\x09\x09\x09 *     'style': {\n\x09\x09\x09 *         // token\n\x09\x09\x09 *     }\n\x09\x09\x09 * });\n\x09\x09\x09 * ```\n\x09\x09\x09 *\n\x09\x09\x09 * ## Special cases\n\x09\x09\x09 *\n\x09\x09\x09 * If the grammars of `inside` and `insert` have tokens with the same name\x2C the tokens in `inside`'s grammar\n\x09\x09\x09 * will be ignored.\n\x09\x09\x09 *\n\x09\x09\x09 * This behavior can be used to insert tokens after `before`:\n\x09\x09\x09 *\n\x09\x09\x09 * ```js\n\x09\x09\x09 * Prism.languages.insertBefore('markup'\x2C 'comment'\x2C {\n\x09\x09\x09 *     'comment': Prism.languages.markup.comment\x2C\n\x09\x09\x09 *     // tokens after 'comment'\n\x09\x09\x09 * });\n\x09\x09\x09 * ```\n\x09\x09\x09 *\n\x09\x09\x09 * ## Limitations\n\x09\x09\x09 *\n\x09\x09\x09 * The main problem `insertBefore` has to solve is iteration order. Since ES2015\x2C the iteration order for object\n\x09\x09\x09 * properties is guaranteed to be the insertion order (except for integer keys) but some browsers behave\n\x09\x09\x09 * differently when keys are deleted and re-inserted. So `insertBefore` can't be implemented by temporarily\n\x09\x09\x09 * deleting properties which is necessary to insert at arbitrary positions.\n\x09\x09\x09 *\n\x09\x09\x09 * To solve this problem\x2C `insertBefore` doesn't actually insert the given tokens into the target object.\n\x09\x09\x09 * Instead\x2C it will create a new object and replace all references to the target object with the new one. This\n\x09\x09\x09 * can be done without temporarily deleting properties\x2C so the iteration order is well-defined.\n\x09\x09\x09 *\n\x09\x09\x09 * However\x2C only references that can be reached from `Prism.languages` or `insert` will be replaced. I.e. if\n\x09\x09\x09 * you hold the target object in a variable\x2C then the value of the variable will not change.\n\x09\x09\x09 *\n\x09\x09\x09 * ```js\n\x09\x09\x09 * var oldMarkup = Prism.languages.markup;\n\x09\x09\x09 * var newMarkup = Prism.languages.insertBefore('markup'\x2C 'comment'\x2C { ... });\n\x09\x09\x09 *\n\x09\x09\x09 * assert(oldMarkup !== Prism.languages.markup);\n\x09\x09\x09 * assert(newMarkup === Prism.languages.markup);\n\x09\x09\x09 * ```\n\x09\x09\x09 *\n\x09\x09\x09 * @param {string} inside The property of `root` (e.g. a language id in `Prism.languages`) that contains the\n\x09\x09\x09 * object to be modified.\n\x09\x09\x09 * @param {string} before The key to insert before.\n\x09\x09\x09 * @param {Grammar} insert An object containing the key-value pairs to be inserted.\n\x09\x09\x09 * @param {Object<string\x2C any>} [root] The object containing `inside`\x2C i.e. the object that contains the\n\x09\x09\x09 * object to be modified.\n\x09\x09\x09 *\n\x09\x09\x09 * Defaults to `Prism.languages`.\n\x09\x09\x09 * @returns {Grammar} The new grammar object.\n\x09\x09\x09 * @public\n\x09\x09\x09 */\n\x09\x09\x09insertBefore: function (inside\x2C before\x2C insert\x2C root) {\n\x09\x09\x09\x09root = root || /** @type {any} */ (_.languages);\n\x09\x09\x09\x09var grammar = root[inside];\n\x09\x09\x09\x09/** @type {Grammar} */\n\x09\x09\x09\x09var ret = {};\n\n\x09\x09\x09\x09for (var token in grammar) {\n\x09\x09\x09\x09\x09if (grammar.hasOwnProperty(token)) {\n\n\x09\x09\x09\x09\x09\x09if (token == before) {\n\x09\x09\x09\x09\x09\x09\x09for (var newToken in insert) {\n\x09\x09\x09\x09\x09\x09\x09\x09if (insert.hasOwnProperty(newToken)) {\n\x09\x09\x09\x09\x09\x09\x09\x09\x09ret[newToken] = insert[newToken];\n\x09\x09\x09\x09\x09\x09\x09\x09}\n\x09\x09\x09\x09\x09\x09\x09}\n\x09\x09\x09\x09\x09\x09}\n\n\x09\x09\x09\x09\x09\x09// Do not insert token which also occur in insert. See #1525\n\x09\x09\x09\x09\x09\x09if (!insert.hasOwnProperty(token)) {\n\x09\x09\x09\x09\x09\x09\x09ret[token] = grammar[token];\n\x09\x09\x09\x09\x09\x09}\n\x09\x09\x09\x09\x09}\n\x09\x09\x09\x09}\n\n\x09\x09\x09\x09var old = root[inside];\n\x09\x09\x09\x09root[inside] = ret;\n\n\x09\x09\x09\x09// Update references in other language definitions\n\x09\x09\x09\x09_.languages.DFS(_.languages\x2C function (key\x2C value) {\n\x09\x09\x09\x09\x09if (value === old && key != inside) {\n\x09\x09\x09\x09\x09\x09this[key] = ret;\n\x09\x09\x09\x09\x09}\n\x09\x09\x09\x09});\n\n\x09\x09\x09\x09return ret;\n\x09\x09\x09}\x2C\n\n\x09\x09\x09// Traverse a language definition with Depth First Search\n\x09\x09\x09DFS: function DFS(o\x2C callback\x2C type\x2C visited) {\n\x09\x09\x09\x09visited = visited || {};\n\n\x09\x09\x09\x09var objId = _.util.objId;\n\n\x09\x09\x09\x09for (var i in o) {\n\x09\x09\x09\x09\x09if (o.hasOwnProperty(i)) {\n\x09\x09\x09\x09\x09\x09callback.call(o\x2C i\x2C o[i]\x2C type || i);\n\n\x09\x09\x09\x09\x09\x09var property = o[i];\n\x09\x09\x09\x09\x09\x09var propertyType = _.util.type(property);\n\n\x09\x09\x09\x09\x09\x09if (propertyType === 'Object' && !visited[objId(property)]) {\n\x09\x09\x09\x09\x09\x09\x09visited[objId(property)] = true;\n\x09\x09\x09\x09\x09\x09\x09DFS(property\x2C callback\x2C null\x2C visited);\n\x09\x09\x09\x09\x09\x09} else if (propertyType === 'Array' && !visited[objId(property)]) {\n\x09\x09\x09\x09\x09\x09\x09visited[objId(property)] = true;\n\x09\x09\x09\x09\x09\x09\x09DFS(property\x2C callback\x2C i\x2C visited);\n\x09\x09\x09\x09\x09\x09}\n\x09\x09\x09\x09\x09}\n\x09\x09\x09\x09}\n\x09\x09\x09}\n\x09\x09}\x2C\n\n\x09\x09plugins: {}\x2C\n\n\x09\x09/**\n\x09\x09 * This is the most high-level function in Prism\u2019s API.\n\x09\x09 * It fetches all the elements that have a `.language-xxxx` class and then calls {@link Prism.highlightElement} on\n\x09\x09 * each one of them.\n\x09\x09 *\n\x09\x09 * This is equivalent to `Prism.highlightAllUnder(document\x2C async\x2C callback)`.\n\x09\x09 *\n\x09\x09 * @param {boolean} [async=false] Same as in {@link Prism.highlightAllUnder}.\n\x09\x09 * @param {HighlightCallback} [callback] Same as in {@link Prism.highlightAllUnder}.\n\x09\x09 * @memberof Prism\n\x09\x09 * @public\n\x09\x09 */\n\x09\x09highlightAll: function (async\x2C callback) {\n\x09\x09\x09_.highlightAllUnder(document\x2C async\x2C callback);\n\x09\x09}\x2C\n\n\x09\x09/**\n\x09\x09 * Fetches all the descendants of `container` that have a `.language-xxxx` class and then calls\n\x09\x09 * {@link Prism.highlightElement} on each one of them.\n\x09\x09 *\n\x09\x09 * The following hooks will be run:\n\x09\x09 * 1. `before-highlightall`\n\x09\x09 * 2. `before-all-elements-highlight`\n\x09\x09 * 3. All hooks of {@link Prism.highlightElement} for each element.\n\x09\x09 *\n\x09\x09 * @param {ParentNode} container The root element\x2C whose descendants that have a `.language-xxxx` class will be highlighted.\n\x09\x09 * @param {boolean} [async=false] Whether each element is to be highlighted asynchronously using Web Workers.\n\x09\x09 * @param {HighlightCallback} [callback] An optional callback to be invoked on each element after its highlighting is done.\n\x09\x09 * @memberof Prism\n\x09\x09 * @public\n\x09\x09 */\n\x09\x09highlightAllUnder: function (container\x2C async\x2C callback) {\n\x09\x09\x09var env = {\n\x09\x09\x09\x09callback: callback\x2C\n\x09\x09\x09\x09container: container\x2C\n\x09\x09\x09\x09selector: 'code[class*="language-"]\x2C [class*="language-"] code\x2C code[class*="lang-"]\x2C [class*="lang-"] code'\n\x09\x09\x09};\n\n\x09\x09\x09_.hooks.run('before-highlightall'\x2C env);\n\n\x09\x09\x09env.elements = Array.prototype.slice.apply(env.container.querySelectorAll(env.selector));\n\n\x09\x09\x09_.hooks.run('before-all-elements-highlight'\x2C env);\n\n\x09\x09\x09for (var i = 0\x2C element; (element = env.elements[i++]);) {\n\x09\x09\x09\x09_.highlightElement(element\x2C async === true\x2C env.callback);\n\x09\x09\x09}\n\x09\x09}\x2C\n\n\x09\x09/**\n\x09\x09 * Highlights the code inside a single element.\n\x09\x09 *\n\x09\x09 * The following hooks will be run:\n\x09\x09 * 1. `before-sanity-check`\n\x09\x09 * 2. `before-highlight`\n\x09\x09 * 3. All hooks of {@link Prism.highlight}. These hooks will be run by an asynchronous worker if `async` is `true`.\n\x09\x09 * 4. `before-insert`\n\x09\x09 * 5. `after-highlight`\n\x09\x09 * 6. `complete`\n\x09\x09 *\n\x09\x09 * Some the above hooks will be skipped if the element doesn't contain any text or there is no grammar loaded for\n\x09\x09 * the element's language.\n\x09\x09 *\n\x09\x09 * @param {Element} element The element containing the code.\n\x09\x09 * It must have a class of `language-xxxx` to be processed\x2C where `xxxx` is a valid language identifier.\n\x09\x09 * @param {boolean} [async=false] Whether the element is to be highlighted asynchronously using Web Workers\n\x09\x09 * to improve performance and avoid blocking the UI when highlighting very large chunks of code. This option is\n\x09\x09 * [disabled by default](https://prismjs.com/faq.html#why-is-asynchronous-highlighting-disabled-by-default).\n\x09\x09 *\n\x09\x09 * Note: All language definitions required to highlight the code must be included in the main `prism.js` file for\n\x09\x09 * asynchronous highlighting to work. You can build your own bundle on the\n\x09\x09 * [Download page](https://prismjs.com/download.html).\n\x09\x09 * @param {HighlightCallback} [callback] An optional callback to be invoked after the highlighting is done.\n\x09\x09 * Mostly useful when `async` is `true`\x2C since in that case\x2C the highlighting is done asynchronously.\n\x09\x09 * @memberof Prism\n\x09\x09 * @public\n\x09\x09 */\n\x09\x09highlightElement: function (element\x2C async\x2C callback) {\n\x09\x09\x09// Find language\n\x09\x09\x09var language = _.util.getLanguage(element);\n\x09\x09\x09var grammar = _.languages[language];\n\n\x09\x09\x09// Set language on the element\x2C if not present\n\x09\x09\x09_.util.setLanguage(element\x2C language);\n\n\x09\x09\x09// Set language on the parent\x2C for styling\n\x09\x09\x09var parent = element.parentElement;\n\x09\x09\x09if (parent && parent.nodeName.toLowerCase() === 'pre') {\n\x09\x09\x09\x09_.util.setLanguage(parent\x2C language);\n\x09\x09\x09}\n\n\x09\x09\x09var code = element.textContent;\n\n\x09\x09\x09var env = {\n\x09\x09\x09\x09element: element\x2C\n\x09\x09\x09\x09language: language\x2C\n\x09\x09\x09\x09grammar: grammar\x2C\n\x09\x09\x09\x09code: code\n\x09\x09\x09};\n\n\x09\x09\x09function insertHighlightedCode(highlightedCode) {\n\x09\x09\x09\x09env.highlightedCode = highlightedCode;\n\n\x09\x09\x09\x09_.hooks.run('before-insert'\x2C env);\n\n\x09\x09\x09\x09env.element.innerHTML = env.highlightedCode;\n\n\x09\x09\x09\x09_.hooks.run('after-highlight'\x2C env);\n\x09\x09\x09\x09_.hooks.run('complete'\x2C env);\n\x09\x09\x09\x09callback && callback.call(env.element);\n\x09\x09\x09}\n\n\x09\x09\x09_.hooks.run('before-sanity-check'\x2C env);\n\n\x09\x09\x09// plugins may change/add the parent/element\n\x09\x09\x09parent = env.element.parentElement;\n\x09\x09\x09if (parent && parent.nodeName.toLowerCase() === 'pre' && !parent.hasAttribute('tabindex')) {\n\x09\x09\x09\x09parent.setAttribute('tabindex'\x2C '0');\n\x09\x09\x09}\n\n\x09\x09\x09if (!env.code) {\n\x09\x09\x09\x09_.hooks.run('complete'\x2C env);\n\x09\x09\x09\x09callback && callback.call(env.element);\n\x09\x09\x09\x09return;\n\x09\x09\x09}\n\n\x09\x09\x09_.hooks.run('before-highlight'\x2C env);\n\n\x09\x09\x09if (!env.grammar) {\n\x09\x09\x09\x09insertHighlightedCode(_.util.encode(env.code));\n\x09\x09\x09\x09return;\n\x09\x09\x09}\n\n\x09\x09\x09if (async && _self.Worker) {\n\x09\x09\x09\x09var worker = new Worker(_.filename);\n\n\x09\x09\x09\x09worker.onmessage = function (evt) {\n\x09\x09\x09\x09\x09insertHighlightedCode(evt.data);\n\x09\x09\x09\x09};\n\n\x09\x09\x09\x09worker.postMessage(JSON.stringify({\n\x09\x09\x09\x09\x09language: env.language\x2C\n\x09\x09\x09\x09\x09code: env.code\x2C\n\x09\x09\x09\x09\x09immediateClose: true\n\x09\x09\x09\x09}));\n\x09\x09\x09} else {\n\x09\x09\x09\x09insertHighlightedCode(_.highlight(env.code\x2C env.grammar\x2C env.language));\n\x09\x09\x09}\n\x09\x09}\x2C\n\n\x09\x09/**\n\x09\x09 * Low-level function\x2C only use if you know what you\u2019re doing. It accepts a string of text as input\n\x09\x09 * and the language definitions to use\x2C and returns a string with the HTML produced.\n\x09\x09 *\n\x09\x09 * The following hooks will be run:\n\x09\x09 * 1. `before-tokenize`\n\x09\x09 * 2. `after-tokenize`\n\x09\x09 * 3. `wrap`: On each {@link Token}.\n\x09\x09 *\n\x09\x09 * @param {string} text A string with the code to be highlighted.\n\x09\x09 * @param {Grammar} grammar An object containing the tokens to use.\n\x09\x09 *\n\x09\x09 * Usually a language definition like `Prism.languages.markup`.\n\x09\x09 * @param {string} language The name of the language definition passed to `grammar`.\n\x09\x09 * @returns {string} The highlighted HTML.\n\x09\x09 * @memberof Prism\n\x09\x09 * @public\n\x09\x09 * @example\n\x09\x09 * Prism.highlight('var foo = true;'\x2C Prism.languages.javascript\x2C 'javascript');\n\x09\x09 */\n\x09\x09highlight: function (text\x2C grammar\x2C language) {\n\x09\x09\x09var env = {\n\x09\x09\x09\x09code: text\x2C\n\x09\x09\x09\x09grammar: grammar\x2C\n\x09\x09\x09\x09language: language\n\x09\x09\x09};\n\x09\x09\x09_.hooks.run('before-tokenize'\x2C env);\n\x09\x09\x09if (!env.grammar) {\n\x09\x09\x09\x09throw new Error('The language "' + env.language + '" has no grammar.');\n\x09\x09\x09}\n\x09\x09\x09env.tokens = _.tokenize(env.code\x2C env.grammar);\n\x09\x09\x09_.hooks.run('after-tokenize'\x2C env);\n\x09\x09\x09return Token.stringify(_.util.encode(env.tokens)\x2C env.language);\n\x09\x09}\x2C\n\n\x09\x09/**\n\x09\x09 * This is the heart of Prism\x2C and the most low-level function you can use. It accepts a string of text as input\n\x09\x09 * and the language definitions to use\x2C and returns an array with the tokenized code.\n\x09\x09 *\n\x09\x09 * When the language definition includes nested tokens\x2C the function is called recursively on each of these tokens.\n\x09\x09 *\n\x09\x09 * This method could be useful in other contexts as well\x2C as a very crude parser.\n\x09\x09 *\n\x09\x09 * @param {string} text A string with the code to be highlighted.\n\x09\x09 * @param {Grammar} grammar An object containing the tokens to use.\n\x09\x09 *\n\x09\x09 * Usually a language definition like `Prism.languages.markup`.\n\x09\x09 * @returns {TokenStream} An array of strings and tokens\x2C a token stream.\n\x09\x09 * @memberof Prism\n\x09\x09 * @public\n\x09\x09 * @example\n\x09\x09 * let code = `var foo = 0;`;\n\x09\x09 * let tokens = Prism.tokenize(code\x2C Prism.languages.javascript);\n\x09\x09 * tokens.forEach(token => {\n\x09\x09 *     if (token instanceof Prism.Token && token.type === 'number') {\n\x09\x09 *         console.log(`Found numeric literal: ${token.content}`);\n\x09\x09 *     }\n\x09\x09 * });\n\x09\x09 */\n\x09\x09tokenize: function (text\x2C grammar) {\n\x09\x09\x09var rest = grammar.rest;\n\x09\x09\x09if (rest) {\n\x09\x09\x09\x09for (var token in rest) {\n\x09\x09\x09\x09\x09grammar[token] = rest[token];\n\x09\x09\x09\x09}\n\n\x09\x09\x09\x09delete grammar.rest;\n\x09\x09\x09}\n\n\x09\x09\x09var tokenList = new LinkedList();\n\x09\x09\x09addAfter(tokenList\x2C tokenList.head\x2C text);\n\n\x09\x09\x09matchGrammar(text\x2C tokenList\x2C grammar\x2C tokenList.head\x2C 0);\n\n\x09\x09\x09return toArray(tokenList);\n\x09\x09}\x2C\n\n\x09\x09/**\n\x09\x09 * @namespace\n\x09\x09 * @memberof Prism\n\x09\x09 * @public\n\x09\x09 */\n\x09\x09hooks: {\n\x09\x09\x09all: {}\x2C\n\n\x09\x09\x09/**\n\x09\x09\x09 * Adds the given callback to the list of callbacks for the given hook.\n\x09\x09\x09 *\n\x09\x09\x09 * The callback will be invoked when the hook it is registered for is run.\n\x09\x09\x09 * Hooks are usually directly run by a highlight function but you can also run hooks yourself.\n\x09\x09\x09 *\n\x09\x09\x09 * One callback function can be registered to multiple hooks and the same hook multiple times.\n\x09\x09\x09 *\n\x09\x09\x09 * @param {string} name The name of the hook.\n\x09\x09\x09 * @param {HookCallback} callback The callback function which is given environment variables.\n\x09\x09\x09 * @public\n\x09\x09\x09 */\n\x09