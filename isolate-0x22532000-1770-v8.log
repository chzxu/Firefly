flush) {\n      this.options.destination.flush();\n    }\n  }\n}\nclass AstroIntegrationLogger {\n  options;\n  label;\n  constructor(logging\x2C label) {\n    this.options = logging;\n    this.label = label;\n  }\n  /**\n   * Creates a new logger instance with a new label\x2C but the same log options.\n   */\n  fork(label) {\n    return new AstroIntegrationLogger(this.options\x2C label);\n  }\n  info(message) {\n    info(this.options\x2C this.label\x2C message);\n  }\n  warn(message) {\n    warn(this.options\x2C this.label\x2C message);\n  }\n  error(message) {\n    error(this.options\x2C this.label\x2C message);\n  }\n  debug(message) {\n    debug(this.label\x2C message);\n  }\n  /**\n   * It calls the `flush` function of the provided destination\x2C if it exists.\n   */\n  flush() {\n    if (this.options.destination.flush) {\n      this.options.destination.flush();\n    }\n  }\n  /**\n   * It calls the `close` function of the provided destination\x2C if it exists.\n   */\n  close() {\n    if (this.options.destination.close) {\n      this.options.destination.close();\n    }\n  }\n}\nexport {\n  AstroIntegrationLogger\x2C\n  AstroLogger\x2C\n  dateTimeFormat\x2C\n  debug\x2C\n  getEventPrefix\x2C\n  isLogLevelEnabled\x2C\n  levels\x2C\n  timerMessage\n};\n
