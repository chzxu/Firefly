script-source,472,file:///mnt/d/blog/Firefly/node_modules/zod/v4/locales/az.js,import * as util from "../core/util.js";\nconst error = () => {\n    const Sizable = {\n        string: { unit: "simvol"\x2C verb: "olmal\u0131d\u0131r" }\x2C\n        file: { unit: "bayt"\x2C verb: "olmal\u0131d\u0131r" }\x2C\n        array: { unit: "element"\x2C verb: "olmal\u0131d\u0131r" }\x2C\n        set: { unit: "element"\x2C verb: "olmal\u0131d\u0131r" }\x2C\n    };\n    function getSizing(origin) {\n        return Sizable[origin] ?? null;\n    }\n    const FormatDictionary = {\n        regex: "input"\x2C\n        email: "email address"\x2C\n        url: "URL"\x2C\n        emoji: "emoji"\x2C\n        uuid: "UUID"\x2C\n        uuidv4: "UUIDv4"\x2C\n        uuidv6: "UUIDv6"\x2C\n        nanoid: "nanoid"\x2C\n        guid: "GUID"\x2C\n        cuid: "cuid"\x2C\n        cuid2: "cuid2"\x2C\n        ulid: "ULID"\x2C\n        xid: "XID"\x2C\n        ksuid: "KSUID"\x2C\n        datetime: "ISO datetime"\x2C\n        date: "ISO date"\x2C\n        time: "ISO time"\x2C\n        duration: "ISO duration"\x2C\n        ipv4: "IPv4 address"\x2C\n        ipv6: "IPv6 address"\x2C\n        cidrv4: "IPv4 range"\x2C\n        cidrv6: "IPv6 range"\x2C\n        base64: "base64-encoded string"\x2C\n        base64url: "base64url-encoded string"\x2C\n        json_string: "JSON string"\x2C\n        e164: "E.164 number"\x2C\n        jwt: "JWT"\x2C\n        template_literal: "input"\x2C\n    };\n    const TypeDictionary = {\n        nan: "NaN"\x2C\n    };\n    return (issue) => {\n        switch (issue.code) {\n            case "invalid_type": {\n                const expected = TypeDictionary[issue.expected] ?? issue.expected;\n                const receivedType = util.parsedType(issue.input);\n                const received = TypeDictionary[receivedType] ?? receivedType;\n                if (/^[A-Z]/.test(issue.expected)) {\n                    return `Yanl\u0131\u015f d\u0259y\u0259r: g\xf6zl\u0259nil\u0259n instanceof ${issue.expected}\x2C daxil olan ${received}`;\n                }\n                return `Yanl\u0131\u015f d\u0259y\u0259r: g\xf6zl\u0259nil\u0259n ${expected}\x2C daxil olan ${received}`;\n            }\n            case "invalid_value":\n                if (issue.values.length === 1)\n                    return `Yanl\u0131\u015f d\u0259y\u0259r: g\xf6zl\u0259nil\u0259n ${util.stringifyPrimitive(issue.values[0])}`;\n                return `Yanl\u0131\u015f se\xe7im: a\u015fa\u011f\u0131dak\u0131lardan biri olmal\u0131d\u0131r: ${util.joinValues(issue.values\x2C "|")}`;\n            case "too_big": {\n                const adj = issue.inclusive ? "<=" : "<";\n                const sizing = getSizing(issue.origin);\n                if (sizing)\n                    return `\xc7ox b\xf6y\xfck: g\xf6zl\u0259nil\u0259n ${issue.origin ?? "d\u0259y\u0259r"} ${adj}${issue.maximum.toString()} ${sizing.unit ?? "element"}`;\n                return `\xc7ox b\xf6y\xfck: g\xf6zl\u0259nil\u0259n ${issue.origin ?? "d\u0259y\u0259r"} ${adj}${issue.maximum.toString()}`;\n            }\n            case "too_small": {\n                const adj = issue.inclusive ? ">=" : ">";\n                const sizing = getSizing(issue.origin);\n                if (sizing)\n                    return `\xc7ox ki\xe7ik: g\xf6zl\u0259nil\u0259n ${issue.origin} ${adj}${issue.minimum.toString()} ${sizing.unit}`;\n                return `\xc7ox ki\xe7ik: g\xf6zl\u0259nil\u0259n ${issue.origin} ${adj}${issue.minimum.toString()}`;\n            }\n            case "invalid_format": {\n                const _issue = issue;\n                if (_issue.format === "starts_with")\n                    return `Yanl\u0131\u015f m\u0259tn: "${_issue.prefix}" il\u0259 ba\u015flamal\u0131d\u0131r`;\n                if (_issue.format === "ends_with")\n                    return `Yanl\u0131\u015f m\u0259tn: "${_issue.suffix}" il\u0259 bitm\u0259lidir`;\n                if (_issue.format === "includes")\n                    return `Yanl\u0131\u015f m\u0259tn: "${_issue.includes}" daxil olmal\u0131d\u0131r`;\n                if (_issue.format === "regex")\n                    return `Yanl\u0131\u015f m\u0259tn: ${_issue.pattern} \u015fablonuna uy\u011fun olmal\u0131d\u0131r`;\n                return `Yanl\u0131\u015f ${FormatDictionary[_issue.format] ?? issue.format}`;\n            }\n            case "not_multiple_of":\n                return `Yanl\u0131\u015f \u0259d\u0259d: ${issue.divisor} il\u0259 b\xf6l\xfcn\u0259 bil\u0259n olmal\u0131d\u0131r`;\n            case "unrecognized_keys":\n                return `Tan\u0131nmayan a\xe7ar${issue.keys.length > 1 ? "lar" : ""}: ${util.joinValues(issue.keys\x2C "\x2C ")}`;\n            case "invalid_key":\n                return `${issue.origin} daxilind\u0259 yanl\u0131\u015f a\xe7ar`;\n            case "invalid_union":\n                return "Yanl\u0131\u015f d\u0259y\u0259r";\n            case "invalid_element":\n                return `${issue.origin} daxilind\u0259 yanl\u0131\u015f d\u0259y\u0259r`;\n            default:\n                return `Yanl\u0131\u015f d\u0259y\u0259r`;\n        }\n    };\n};\nexport default function () {\n    return {\n        localeError: error()\x2C\n    };\n}\n
