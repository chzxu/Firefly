script-source,95,node:internal/util/parse_args/parse_args,'use strict';\n\nconst {\n  ArrayPrototypeForEach\x2C\n  ArrayPrototypeMap\x2C\n  ArrayPrototypePush\x2C\n  ArrayPrototypePushApply\x2C\n  ArrayPrototypeShift\x2C\n  ArrayPrototypeSlice\x2C\n  ArrayPrototypeUnshiftApply\x2C\n  ObjectEntries\x2C\n  ObjectPrototypeHasOwnProperty: ObjectHasOwn\x2C\n  StringPrototypeCharAt\x2C\n  StringPrototypeIndexOf\x2C\n  StringPrototypeSlice\x2C\n  StringPrototypeStartsWith\x2C\n} = primordials;\n\nconst {\n  validateArray\x2C\n  validateBoolean\x2C\n  validateBooleanArray\x2C\n  validateObject\x2C\n  validateString\x2C\n  validateStringArray\x2C\n  validateUnion\x2C\n} = require('internal/validators');\n\nconst {\n  findLongOptionForShort\x2C\n  isLoneLongOption\x2C\n  isLoneShortOption\x2C\n  isLongOptionAndValue\x2C\n  isOptionValue\x2C\n  isOptionLikeValue\x2C\n  isShortOptionAndValue\x2C\n  isShortOptionGroup\x2C\n  useDefaultValueOption\x2C\n  objectGetOwn\x2C\n  optionsGetOwn\x2C\n} = require('internal/util/parse_args/utils');\n\nconst {\n  codes: {\n    ERR_INVALID_ARG_VALUE\x2C\n    ERR_PARSE_ARGS_INVALID_OPTION_VALUE\x2C\n    ERR_PARSE_ARGS_UNEXPECTED_POSITIONAL\x2C\n    ERR_PARSE_ARGS_UNKNOWN_OPTION\x2C\n  }\x2C\n} = require('internal/errors');\n\nconst {\n  kEmptyObject\x2C\n} = require('internal/util');\n\nconst { getOptionValue } = require('internal/options');\n\nfunction getMainArgs() {\n  // -p / --print internally sets --eval\x2C so this works for all cases\n  const evalValue = getOptionValue('--eval');\n\n  if (evalValue.length !== 0) {\n    return ArrayPrototypeSlice(process.argv\x2C 1);\n  }\n\n  return ArrayPrototypeSlice(process.argv\x2C 2);\n}\n\n/**\n * In strict mode\x2C throw for possible usage errors like --foo --bar\n * @param {object} token - from tokens as available from parseArgs\n */\nfunction checkOptionLikeValue(token) {\n  if (!token.inlineValue && isOptionLikeValue(token.value)) {\n    // Only show short example if user used short option.\