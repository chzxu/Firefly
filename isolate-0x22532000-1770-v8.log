script-source,615,file:///mnt/d/blog/Firefly/node_modules/parse5/dist/parser/open-element-stack.js,import { TAG_ID as $\x2C NS\x2C NUMBERED_HEADERS } from '../common/html.js';\n//Element utils\nconst IMPLICIT_END_TAG_REQUIRED = new Set([$.DD\x2C $.DT\x2C $.LI\x2C $.OPTGROUP\x2C $.OPTION\x2C $.P\x2C $.RB\x2C $.RP\x2C $.RT\x2C $.RTC]);\nconst IMPLICIT_END_TAG_REQUIRED_THOROUGHLY = new Set([\n    ...IMPLICIT_END_TAG_REQUIRED\x2C\n    $.CAPTION\x2C\n    $.COLGROUP\x2C\n    $.TBODY\x2C\n    $.TD\x2C\n    $.TFOOT\x2C\n    $.TH\x2C\n    $.THEAD\x2C\n    $.TR\x2C\n]);\nconst SCOPING_ELEMENTS_HTML = new Set([\n    $.APPLET\x2C\n    $.CAPTION\x2C\n    $.HTML\x2C\n    $.MARQUEE\x2C\n    $.OBJECT\x2C\n    $.TABLE\x2C\n    $.TD\x2C\n    $.TEMPLATE\x2C\n    $.TH\x2C\n]);\nconst SCOPING_ELEMENTS_HTML_LIST = new Set([...SCOPING_ELEMENTS_HTML\x2C $.OL\x2C $.UL]);\nconst SCOPING_ELEMENTS_HTML_BUTTON = new Set([...SCOPING_ELEMENTS_HTML\x2C $.BUTTON]);\nconst SCOPING_ELEMENTS_MATHML = new Set([$.ANNOTATION_XML\x2C $.MI\x2C $.MN\x2C $.MO\x2C $.MS\x2C $.MTEXT]);\nconst SCOPING_ELEMENTS_SVG = new Set([$.DESC\x2C $.FOREIGN_OBJECT\x2C $.TITLE]);\nconst TABLE_ROW_CONTEXT = new Set([$.TR\x2C $.TEMPLATE\x2C $.HTML]);\nconst TABLE_BODY_CONTEXT = new Set([$.TBODY\x2C $.TFOOT\x2C $.THEAD\x2C $.TEMPLATE\x2C $.HTML]);\nconst TABLE_CONTEXT = new Set([$.TABLE\x2C $.TEMPLATE\x2C $.HTML]);\nconst TABLE_CELLS = new Set([$.TD\x2C $.TH]);\n//Stack of open elements\nexport class OpenElementStack {\n    get currentTmplContentOrNode() {\n        return this._isInTemplate() ? this.treeAdapter.getTemplateContent(this.current) : this.current;\n    }\n    constructor(document\x2C treeAdapter\x2C handler) {\n        this.treeAdapter = treeAdapter;\n        this.handler = handler;\n        this.items = [];\n        this.tagIDs = [];\n        this.stackTop = -1;\n        this.tmplCount = 0;\n        this.currentTagId = $.UNKNOWN;\n        this.current = document;\n    }\n    //Index of element\n    _indexOf(element