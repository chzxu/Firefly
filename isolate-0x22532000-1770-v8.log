script-source,634,file:///mnt/d/blog/Firefly/node_modules/hast-util-to-html/lib/omission/closing.js,/**\n * @import {Element\x2C Parents} from 'hast'\n */\n\nimport {whitespace} from 'hast-util-whitespace'\nimport {siblingAfter} from './util/siblings.js'\nimport {omission} from './omission.js'\n\nexport const closing = omission({\n  body\x2C\n  caption: headOrColgroupOrCaption\x2C\n  colgroup: headOrColgroupOrCaption\x2C\n  dd\x2C\n  dt\x2C\n  head: headOrColgroupOrCaption\x2C\n  html\x2C\n  li\x2C\n  optgroup\x2C\n  option\x2C\n  p\x2C\n  rp: rubyElement\x2C\n  rt: rubyElement\x2C\n  tbody\x2C\n  td: cells\x2C\n  tfoot\x2C\n  th: cells\x2C\n  thead\x2C\n  tr\n})\n\n/**\n * Macro for `</head>`\x2C `</colgroup>`\x2C and `</caption>`.\n *\n * @param {Element} _\n *   Element.\n * @param {number | undefined} index\n *   Index of element in parent.\n * @param {Parents | undefined} parent\n *   Parent of element.\n * @returns {boolean}\n *   Whether the closing tag can be omitted.\n */\nfunction headOrColgroupOrCaption(_\x2C index\x2C parent) {\n  const next = siblingAfter(parent\x2C index\x2C true)\n  return (\n    !next ||\n    (next.type !== 'comment' &&\n      !(next.type === 'text' && whitespace(next.value.charAt(0))))\n  )\n}\n\n/**\n * Whether to omit `</html>`.\n *\n * @param {Element} _\n *   Element.\n * @param {number | undefined} index\n *   Index of element in parent.\n * @param {Parents | undefined} parent\n *   Parent of element.\n * @returns {boolean}\n *   Whether the closing tag can be omitted.\n */\nfunction html(_\x2C index\x2C parent) {\n  const next = siblingAfter(parent\x2C index)\n  return !next || next.type !== 'comment'\n}\n\n/**\n * Whether to omit `</body>`.\n *\n * @param {Element} _\n *   Element.\n * @param {number | undefined} index\n *   Index of element in parent.\n * @param {Parents | undefined} parent\n *   Parent of element.\n * @returns {boolean}\n *   Whether the closing tag can be omitted.\n */\nfunction body(_\x2C index\x2C parent