script-source,387,file:///mnt/d/blog/Firefly/node_modules/zod/v4/classic/schemas.js,import * as core from "../core/index.js";\nimport { util } from "../core/index.js";\nimport * as processors from "../core/json-schema-processors.js";\nimport { createStandardJSONSchemaMethod\x2C createToJSONSchemaMethod } from "../core/to-json-schema.js";\nimport * as checks from "./checks.js";\nimport * as iso from "./iso.js";\nimport * as parse from "./parse.js";\nexport const ZodType = /*@__PURE__*/ core.$constructor("ZodType"\x2C (inst\x2C def) => {\n    core.$ZodType.init(inst\x2C def);\n    Object.assign(inst["~standard"]\x2C {\n        jsonSchema: {\n            input: createStandardJSONSchemaMethod(inst\x2C "input")\x2C\n            output: createStandardJSONSchemaMethod(inst\x2C "output")\x2C\n        }\x2C\n    });\n    inst.toJSONSchema = createToJSONSchemaMethod(inst\x2C {});\n    inst.def = def;\n    inst.type = def.type;\n    Object.defineProperty(inst\x2C "_def"\x2C { value: def });\n    // base methods\n    inst.check = (...checks) => {\n        return inst.clone(util.mergeDefs(def\x2C {\n            checks: [\n                ...(def.checks ?? [])\x2C\n                ...checks.map((ch) => typeof ch === "function" ? { _zod: { check: ch\x2C def: { check: "custom" }\x2C onattach: [] } } : ch)\x2C\n            ]\x2C\n        })\x2C {\n            parent: true\x2C\n        });\n    };\n    inst.with = inst.check;\n    inst.clone = (def\x2C params) => core.clone(inst\x2C def\x2C params);\n    inst.brand = () => inst;\n    inst.register = ((reg\x2C meta) => {\n        reg.add(inst\x2C meta);\n        return inst;\n    });\n    // parsing\n    inst.parse = (data\x2C params) => parse.parse(inst\x2C data\x2C params\x2C { callee: inst.parse });\n    inst.safeParse = (data\x2C params) => parse.safeParse(inst\x2C data\x2C params);\n    inst.parseAsync = async (data\x2C params) => parse.parseAsync(inst\x2C data\x2C params\x2C { callee: inst.parseAsync });\n    inst.safeParseAsync