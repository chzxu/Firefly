script-source,242,node:internal/heap_utils,'use strict';\nconst {\n  ArrayPrototypeMap\x2C\n  Symbol\x2C\n  Uint8Array\x2C\n} = primordials;\nconst {\n  kUpdateTimer\x2C\n  onStreamRead\x2C\n} = require('internal/stream_base_commons');\nconst { owner_symbol } = require('internal/async_hooks').symbols;\nconst { Readable } = require('stream');\nconst {\n  validateObject\x2C\n  validateBoolean\x2C\n  validateFunction\x2C\n} = require('internal/validators');\nconst {\n  codes: {\n    ERR_INVALID_ARG_VALUE\x2C\n  }\x2C\n} = require('internal/errors');\nconst { kEmptyObject\x2C emitExperimentalWarning } = require('internal/util');\nconst {\n  queryObjects: _queryObjects\x2C\n} = internalBinding('internal_only_v8');\nconst {\n  inspect\x2C\n} = require('internal/util/inspect');\nconst kHandle = Symbol('kHandle');\n\nfunction getHeapSnapshotOptions(options = kEmptyObject) {\n  validateObject(options\x2C 'options');\n  const {\n    exposeInternals = false\x2C\n    exposeNumericValues = false\x2C\n  } = options;\n  validateBoolean(exposeInternals\x2C 'options.exposeInternals');\n  validateBoolean(exposeNumericValues\x2C 'options.exposeNumericValues');\n  return new Uint8Array([+exposeInternals\x2C +exposeNumericValues]);\n}\n\nclass HeapSnapshotStream extends Readable {\n  constructor(handle) {\n    super({ autoDestroy: true });\n    this[kHandle] = handle;\n    handle[owner_symbol] = this;\n    handle.onread = onStreamRead;\n  }\n\n  _read() {\n    if (this[kHandle])\n      this[kHandle].readStart();\n  }\n\n  _destroy(err\x2C callback) {\n    // Release the references on the handle so that\n    // it can be garbage collected.\n    this[kHandle][owner_symbol] = undefined;\n    this[kHandle] = undefined;\n    callback(err);\n  }\n\n  [kUpdateTimer]() {\n    // Does nothing\n  }\n}\n\nconst inspectOptions = {\n  __proto__: null\x2C\n  depth: 0\x2C\n};\nfunction queryObjects(ctor\x2C options = kEmptyObject) {\n  validateFunction(ctor\x2C 'constructor');\n  if (options !== kEmptyObject) {\n    validateObject(options\x2C 'options');\n  }\n  const format = options.format || 'count';\n  if (format !== 'count' && format !== 'summary') {\n    throw new ERR_INVALID_ARG_VALUE('options.format'\x2C format);\n  }\n  emitExperimentalWarning('v8.queryObjects()');\n  // Matching the console API behavior - just access the .prototype.\n  const objects = _queryObjects(ctor.prototype);\n  if (format === 'count') {\n    return objects.length;\n  }\n  // options.format is 'summary'.\n  return ArrayPrototypeMap(objects\x2C (object) => inspect(object\x2C inspectOptions));\n}\n\nmodule.exports = {\n  getHeapSnapshotOptions\x2C\n  HeapSnapshotStream\x2C\n  queryObjects\x2C\n};\n
