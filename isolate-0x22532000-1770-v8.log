script-source,430,file:///mnt/d/blog/Firefly/node_modules/mdast-util-to-hast/lib/handlers/thematic-break.js,/**\n * @import {Element} from 'hast'\n * @import {ThematicBreak} from 'mdast'\n * @import {State} from '../state.js'\n */\n\n/**\n * Turn an mdast `thematicBreak` node into hast.\n *\n * @param {State} state\n *   Info passed around.\n * @param {ThematicBreak} node\n *   mdast node.\n * @returns {Element}\n *   hast node.\n */\nexport function thematicBreak(state\x2C node) {\n  /** @type {Element} */\n  const result = {\n    type: 'element'\x2C\n    tagName: 'hr'\x2C\n    properties: {}\x2C\n    children: []\n  }\n  state.patch(node\x2C result)\n  return state.applyData(node\x2C result)\n}\n
