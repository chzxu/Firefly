script-source,273,file:///mnt/d/blog/Firefly/node_modules/astro/dist/core/config/schemas/base.js,import { markdownConfigDefaults\x2C syntaxHighlightDefaults } from "@astrojs/markdown-remark";\nimport { bundledThemes } from "shiki";\nimport * as z from "zod/v4";\nimport { FontFamilySchema } from "../../../assets/fonts/config.js";\nimport { SvgOptimizerSchema } from "../../../assets/svg/config.js";\nimport { EnvSchema } from "../../../env/schema.js";\nimport { CacheSchema\x2C RouteRulesSchema } from "../../cache/config.js";\nimport { allowedDirectivesSchema\x2C cspAlgorithmSchema\x2C cspHashSchema } from "../../csp/config.js";\nimport { SessionSchema } from "../../session/config.js";\nconst ASTRO_CONFIG_DEFAULTS = {\n  root: "."\x2C\n  srcDir: "./src"\x2C\n  publicDir: "./public"\x2C\n  outDir: "./dist"\x2C\n  cacheDir: "./node_modules/.astro"\x2C\n  base: "/"\x2C\n  trailingSlash: "ignore"\x2C\n  build: {\n    format: "directory"\x2C\n    client: "./client/"\x2C\n    server: "./server/"\x2C\n    assets: "_astro"\x2C\n    serverEntry: "entry.mjs"\x2C\n    redirects: true\x2C\n    inlineStylesheets: "auto"\x2C\n    concurrency: 1\n  }\x2C\n  image: {\n    endpoint: { entrypoint: void 0\x2C route: "/_image" }\x2C\n    service: { entrypoint: "astro/assets/services/sharp"\x2C config: {} }\x2C\n    dangerouslyProcessSVG: false\x2C\n    responsiveStyles: false\n  }\x2C\n  devToolbar: {\n    enabled: true\n  }\x2C\n  compressHTML: true\x2C\n  server: {\n    host: false\x2C\n    port: 4321\x2C\n    open: false\x2C\n    allowedHosts: []\n  }\x2C\n  integrations: []\x2C\n  markdown: markdownConfigDefaults\x2C\n  vite: {}\x2C\n  legacy: {\n    collectionsBackwardsCompat: false\n  }\x2C\n  redirects: {}\x2C\n  security: {\n    checkOrigin: true\x2C\n    allowedDomains: []\x2C\n    csp: false\x2C\n    actionBodySizeLimit: 1024 * 1024\x2C\n    serverIslandBodySizeLimit: 1024 * 1024\n  }\x2C\n  env: {\n    schema: {}\x2C\n    validateSecrets: false\n  }\x2C\n  prerenderConflictBehavior: "warn"\x2C\n  experimental: {\n    advancedRouting: false\x2C\n    clientPrerender: false\x2C\n    contentIntellisense: false\x2C\n    chromeDevtoolsWorkspace: false\x2C\n    rustCompiler: false\x2C\n    queuedRendering: {\n      enabled: false\n    }\x2C\n    logger: {\n      entrypoint: "astro/logger/node"\n    }\n  }\n};\nconst highlighterTypesSchema = z.union([z.literal("shiki")\x2C z.literal("prism")]).default(syntaxHighlightDefaults.type);\nconst quoteCharacterMapSchema = z.object({\n  double: z.string()\x2C\n  single: z.string()\n});\nconst smartypantsOptionsSchema = z.object({\n  backticks: z.union([z.boolean()\x2C z.literal("all")]).default(true)\x2C\n  closingQuotes: quoteCharacterMapSchema.default({\n    double: "\\u201D"\x2C\n    single: "\\u2019"\n  })\x2C\n  dashes: z.union([z.boolean()\x2C z.literal("inverted")\x2C z.literal("oldschool")]).default(true)\x2C\n  ellipses: z.union([z.boolean()\x2C z.literal("spaced")\x2C z.literal("unspaced")]).default(true)\x2C\n  openingQuotes: quoteCharacterMapSchema.default({\n    double: "\\u201C"\x2C\n    single: "\\u2018"\n  })\x2C\n  quotes: z.boolean().default(true)\n});\nconst AstroConfigSchema = z.object({\n  root: z.string().optional().default(ASTRO_CONFIG_DEFAULTS.root).transform((val) => new URL(val))\x2C\n  srcDir: z.string().optional().default(ASTRO_CONFIG_DEFAULTS.srcDir).transform((val) => new URL(val))\x2C\n  publicDir: z.string().optional().default(ASTRO_CONFIG_DEFAULTS.publicDir).transform((val) => new URL(val))\x2C\n  outDir: z.string().optional().default(ASTRO_CONFIG_DEFAULTS.outDir).transform((val) => new URL(val))\x2C\n  cacheDir: z.string().optional().default(ASTRO_CONFIG_DEFAULTS.cacheDir).transform((val) => new URL(val))\x2C\n  site: z.string().url().optional()\x2C\n  compressHTML: z.union([z.boolean()\x2C z.literal("jsx")]).optional().default(ASTRO_CONFIG_DEFAULTS.compressHTML)\x2C\n  base: z.string().optional().default(ASTRO_CONFIG_DEFAULTS.base)\x2C\n  trailingSlash: z.union([z.literal("always")\x2C z.literal("never")\x2C z.literal("ignore")]).optional().default(ASTRO_CONFIG_DEFAULTS.trailingSlash)\x2C\n  output: z.union([z.literal("static")\x2C z.literal("server")\x2C z.literal("hybrid")]).optional().default("static").refine((val) => val !== "hybrid"\x2C {\n    message: 'The `output: "hybrid"` option has been removed. Use `output: "static"` (the default) instead\x2C which now behaves the same way.'\n  })\x2C\n  scopedStyleStrategy: z.union([z.literal("where")\x2C z.literal("class")\x2C z.literal("attribute")]).optional().default("attribute")\x2C\n  adapter: z.object({ name: z.string()\x2C hooks: z.object({}).loose().default({}) }).optional()\x2C\n  integrations: z.preprocess(\n    // preprocess\n    (val) => Array.isArray(val) ? val.flat(Number.POSITIVE_INFINITY).filter(Boolean) : val\x2C\n    // validate\n    z.array(z.object({ name: z.string()\x2C hooks: z.object({}).loose().default({}) }))\n  ).optional().default(ASTRO_CONFIG_DEFAULTS.integrations)\x2C\n  build: z.object({\n    format: z.union([z.literal("file")\x2C z.literal("directory")\x2C z.literal("preserve")]).optional().default(ASTRO_CONFIG_DEFAULTS.build.format)\x2C\n    client: z.string().optional().default(ASTRO_CONFIG_DEFAULTS.build.client).transform((val) => new URL(val))\x2C\n    server: z.string().optional().default(ASTRO_CONFIG_DEFAULTS.build.server).transform((val) => new URL(val))\x2C\n    assets: z.string().optional().default(ASTRO_CONFIG_DEFAULTS.build.assets)\x2C\n    assetsPrefix: z.string().optional().or(z.object({ fallback: z.string() }).and(z.record(z.string()\x2C z.string()))).optional()\x2C\n    serverEntry: z.string().optional().default(ASTRO_CONFIG_DEFAULTS.build.serverEntry)\x2C\n    redirects: z.boolean().optional().default(ASTRO_CONFIG_DEFAULTS.build.redirects)\x2C\n    inlineStylesheets: z.enum(["always"\x2C "auto"\x2C "never"]).optional().default(ASTRO_CONFIG_DEFAULTS.build.inlineStylesheets)\x2C\n    concurrency: z.number().min(1).optional().default(ASTRO_CONFIG_DEFAULTS.build.concurrency)\n  }).prefault({})\x2C\n  server: z.preprocess(\n    // preprocess\n    // NOTE: Uses the "error" command here because this is overwritten by the\n    // individualized schema parser with the correct command.\n    (val) => typeof val === "function" ? val({ command: "error" }) : val\x2C\n    // validate\n    z.object({\n      open: z.union([z.string()\x2C z.boolean()]).optional().default(ASTRO_CONFIG_DEFAULTS.server.open)\x2C\n      host: z.union([z.string()\x2C z.boolean()]).optional().default(ASTRO_CONFIG_DEFAULTS.server.host)\x2C\n      port: z.number().optional().default(ASTRO_CONFIG_DEFAULTS.server.port)\x2C\n      headers: z.custom().optional()\x2C\n      allowedHosts: z.union([z.array(z.string())\x2C z.literal(true)]).optional().default(ASTRO_CONFIG_DEFAULTS.server.allowedHosts)\n    })\n  ).prefault({})\x2C\n  redirects: z.record(\n    z.string()\x2C\n    z.union([\n      z.string()\x2C\n      z.object({\n        status: z.union([\n          z.literal(300)\x2C\n          z.literal(301)\x2C\n          z.literal(302)\x2C\n          z.literal(303)\x2C\n          z.literal(304)\x2C\n          z.literal(307)\x2C\n          z.literal(308)\n        ])\x2C\n        destination: z.string()\n      })\n    ])\n  ).default(ASTRO_CONFIG_DEFAULTS.redirects)\x2C\n  prefetch: z.union([\n    z.boolean()\x2C\n    z.object({\n      prefetchAll: z.boolean().optional()\x2C\n      defaultStrategy: z.enum(["tap"\x2C "hover"\x2C "viewport"\x2C "load"]).optional()\n    })\n  ]).optional()\x2C\n  image: z.object({\n    endpoint: z.object({\n      route: z.literal("/_image").or(z.string()).default(ASTRO_CONFIG_DEFAULTS.image.endpoint.route)\x2C\n      entrypoint: z.string().optional()\n    }).default(ASTRO_CONFIG_DEFAULTS.image.endpoint)\x2C\n    service: z.object({\n      entrypoint: z.union([z.literal("astro/assets/services/sharp")\x2C z.string()]).default(ASTRO_CONFIG_DEFAULTS.image.service.entrypoint)\x2C\n      config: z.record(z.string()\x2C z.any()).default({})\n    }).default(ASTRO_CONFIG_DEFAULTS.image.service)\x2C\n    dangerouslyProcessSVG: z.boolean().default(ASTRO_CONFIG_DEFAULTS.image.dangerouslyProcessSVG)\x2C\n    domains: z.array(z.string()).default([])\x2C\n    remotePatterns: z.array(\n      z.object({\n        protocol: z.string().optional()\x2C\n        hostname: z.string().optional()\x2C\n        port: z.string().optional()\x2C\n        pathname: z.string().optional()\n      })\n    ).default([])\x2C\n    layout: z.enum(["constrained"\x2C "fixed"\x2C "full-width"\x2C "none"]).optional()\x2C\n    objectFit: z.string().optional()\x2C\n    objectPosition: z.string().optional()\x2C\n    breakpoints: z.array(z.number()).optional()\x2C\n    responsiveStyles: z.boolean().default(ASTRO_CONFIG_DEFAULTS.image.responsiveStyles)\n  }).prefault(ASTRO_CONFIG_DEFAULTS.image)\x2C\n  devToolbar: z.object({\n    enabled: z.boolean().default(ASTRO_CONFIG_DEFAULTS.devToolbar.enabled)\x2C\n    placement: z.enum(["bottom-left"\x2C "bottom-center"\x2C "bottom-right"]).optional()\n  }).default(ASTRO_CONFIG_DEFAULTS.devToolbar)\x2C\n  markdown: z.object({\n    syntaxHighlight: z.union([\n      z.object({\n        type: highlighterTypesSchema\x2C\n        excludeLangs: z.array(z.string()).optional()\n      }).default(syntaxHighlightDefaults)\x2C\n      highlighterTypesSchema\x2C\n      z.literal(false)\n    ]).default(ASTRO_CONFIG_DEFAULTS.markdown.syntaxHighlight)\x2C\n    shikiConfig: z.object({\n      langs: z.custom().array().transform((langs) => {\n        for (const lang of langs) {\n          if (typeof lang === "object") {\n            if (lang.id) {\n              lang.name = lang.id;\n            }\n            if (lang.grammar) {\n              Object.assign(lang\x2C lang.grammar);\n            }\n          }\n        }\n        return langs;\n      }).default([])\x2C\n      langAlias: z.record(z.string()\x2C z.string()).optional().default(ASTRO_CONFIG_DEFAULTS.markdown.shikiConfig.langAlias)\x2C\n      theme: z.enum(Object.keys(bundledThemes)).or(z.custom()).default(ASTRO_CONFIG_DEFAULTS.markdown.shikiConfig.theme)\x2C\n      themes: z.record(\n        z.string()\x2C\n        z.enum(Object.keys(bundledThemes)).or(z.custom())\n      ).optional().default(ASTRO_CONFIG_DEFAULTS.markdown.shikiConfig.themes)\x2C\n      defaultColor: z.union([z.literal("light")\x2C z.literal("dark")\x2C z.string()\x2C z.literal(false)]).optional()\x2C\n      wrap: z.boolean().or(z.null()).default(ASTRO_CONFIG_DEFAULTS.markdown.shikiConfig.wrap)\x2C\n      transformers: z.custom().array().default(ASTRO_CONFIG_DEFAULTS.markdown.shikiConfig.transformers)\n    }).prefault({})\x2C\n    remarkPlugins: z.union([\n      z.string()\x2C\n      z.tuple([z.string()\x2C z.any()])\x2C\n      z.custom((data) => typeof data === "function")\x2C\n      z.tuple([z.custom((data) => typeof data === "function")\x2C z.any()])\n    ]).array().default(ASTRO_CONFIG_DEFAULTS.markdown.remarkPlugins)\x2C\n    rehypePlugins: z.union([\n      z.string()\x2C\n      z.tuple([z.string()\x2C z.any()])\x2C\n      z.custom((data) => typeof data === "function")\x2C\n      z.tuple([z.custom((data) => typeof data === "function")\x2C z.any()])\n    ]).array().default(ASTRO_CONFIG_DEFAULTS.markdown.rehypePlugins)\x2C\n    remarkRehype: z.custom((data) => data instanceof Object && !Array.isArray(data)).default(ASTRO_CONFIG_DEFAULTS.markdown.remarkRehype)\x2C\n    gfm: z.boolean().default(ASTRO_CONFIG_DEFAULTS.markdown.gfm)\x2C\n    smartypants: z.union([z.boolean()\x2C smartypantsOptionsSchema]).transform((val) => {\n      if (val === true) return smartypantsOptionsSchema.parse({});\n      return val;\n    }).prefault(ASTRO_CONFIG_DEFAULTS.markdown.smartypants)\n  }).prefault({})\x2C\n  vite: z.custom((data) => data instanceof Object && !Array.isArray(data)).default(ASTRO_CONFIG_DEFAULTS.vite)\x2C\n  i18n: z.optional(\n    z.object({\n      defaultLocale: z.string()\x2C\n      locales: z.array(\n        z.union([\n          z.string()\x2C\n          z.object({\n            path: z.string()\x2C\n            codes: z.tuple([z.string()]\x2C z.string())\n          })\n        ])\n      )\x2C\n      domains: z.record(\n        z.string()\x2C\n        z.string().url(\n          "The domain value must be a valid URL\x2C and it has to start with 'https' or 'http'."\n        )\n      ).optional()\x2C\n      fallback: z.record(z.string()\x2C z.string()).optional()\x2C\n      routing: z.literal("manual").or(\n        z.object({\n          prefixDefaultLocale: z.boolean().optional().default(false)\x2C\n          redirectToDefaultLocale: z.boolean().optional().default(false)\x2C\n          fallbackType: z.enum(["redirect"\x2C "rewrite"]).optional().default("redirect")\n        })\n      ).optional().prefault({})\n    }).optional()\n  )\x2C\n  security: z.object({\n    checkOrigin: z.boolean().default(ASTRO_CONFIG_DEFAULTS.security.checkOrigin)\x2C\n    allowedDomains: z.array(\n      z.object({\n        hostname: z.string().optional()\x2C\n        protocol: z.string().optional()\x2C\n        port: z.string().optional()\n      })\n    ).optional().default(ASTRO_CONFIG_DEFAULTS.security.allowedDomains)\x2C\n    actionBodySizeLimit: z.number().optional().default(ASTRO_CONFIG_DEFAULTS.security.actionBodySizeLimit)\x2C\n    serverIslandBodySizeLimit: z.number().optional().default(ASTRO_CONFIG_DEFAULTS.security.serverIslandBodySizeLimit)\x2C\n    csp: z.union([\n      z.boolean().optional().default(ASTRO_CONFIG_DEFAULTS.security.csp)\x2C\n      z.object({\n        algorithm: cspAlgorithmSchema\x2C\n        directives: z.array(allowedDirectivesSchema).optional()\x2C\n        styleDirective: z.object({\n          resources: z.array(z.string()).optional()\x2C\n          hashes: z.array(cspHashSchema).optional()\n        }).optional()\x2C\n        scriptDirective: z.object({\n          resources: z.array(z.string()).optional()\x2C\n          hashes: z.array(cspHashSchema).optional()\x2C\n          strictDynamic: z.boolean().optional()\n        }).optional()\n      })\n    ]).optional().default(ASTRO_CONFIG_DEFAULTS.security.csp)\n  }).optional().default(ASTRO_CONFIG_DEFAULTS.security)\x2C\n  env: z.object({\n    schema: EnvSchema.optional().default(ASTRO_CONFIG_DEFAULTS.env.schema)\x2C\n    validateSecrets: z.boolean().optional().default(ASTRO_CONFIG_DEFAULTS.env.validateSecrets)\n  }).strict().optional().default(ASTRO_CONFIG_DEFAULTS.env)\x2C\n  session: SessionSchema.optional()\x2C\n  prerenderConflictBehavior: z.enum(["error"\x2C "warn"\x2C "ignore"]).optional().default(ASTRO_CONFIG_DEFAULTS.prerenderConflictBehavior)\x2C\n  fonts: z.array(FontFamilySchema).optional()\x2C\n  experimental: z.strictObject({\n    advancedRouting: z.boolean().optional().default(ASTRO_CONFIG_DEFAULTS.experimental.advancedRouting)\x2C\n    clientPrerender: z.boolean().optional().default(ASTRO_CONFIG_DEFAULTS.experimental.clientPrerender)\x2C\n    contentIntellisense: z.boolean().optional().default(ASTRO_CONFIG_DEFAULTS.experimental.contentIntellisense)\x2C\n    chromeDevtoolsWorkspace: z.boolean().optional().default(ASTRO_CONFIG_DEFAULTS.experimental.chromeDevtoolsWorkspace)\x2C\n    svgOptimizer: SvgOptimizerSchema.optional()\x2C\n    cache: CacheSchema.optional()\x2C\n    routeRules: RouteRulesSchema.optional()\x2C\n    rustCompiler: z.boolean().optional().default(ASTRO_CONFIG_DEFAULTS.experimental.rustCompiler)\x2C\n    queuedRendering: z.object({\n      enabled: z.boolean().optional().prefault(false)\x2C\n      poolSize: z.number().int().nonnegative().optional()\x2C\n      contentCache: z.boolean().optional()\n    }).optional().prefault(ASTRO_CONFIG_DEFAULTS.experimental.queuedRendering)\x2C\n    logger: z.object({\n      entrypoint: z.string()\x2C\n      config: z.record(z.string()\x2C z.any()).optional()\n    }).optional()\n  }).prefault({})\x2C\n  legacy: z.object({\n    collectionsBackwardsCompat: z.boolean().optional().default(false)\n  }).prefault({})\n});\nexport {\n  ASTRO_CONFIG_DEFAU