script-source,241,node:v8,// Copyright (c) 2014\x2C StrongLoop Inc.\n//\n// Permission to use\x2C copy\x2C modify\x2C and/or distribute this software for any\n// purpose with or without fee is hereby granted\x2C provided that the above\n// copyright notice and this permission notice appear in all copies.\n//\n// THE SOFTWARE IS PROVIDED "AS IS" AND THE AUTHOR DISCLAIMS ALL WARRANTIES\n// WITH REGARD TO THIS SOFTWARE INCLUDING ALL IMPLIED WARRANTIES OF\n// MERCHANTABILITY AND FITNESS. IN NO EVENT SHALL THE AUTHOR BE LIABLE FOR\n// ANY SPECIAL\x2C DIRECT\x2C INDIRECT\x2C OR CONSEQUENTIAL DAMAGES OR ANY DAMAGES\n// WHATSOEVER RESULTING FROM LOSS OF USE\x2C DATA OR PROFITS\x2C WHETHER IN AN\n// ACTION OF CONTRACT\x2C NEGLIGENCE OR OTHER TORTIOUS ACTION\x2C ARISING OUT OF\n// OR IN CONNECTION WITH THE USE OR PERFORMANCE OF THIS SOFTWARE.\n\n'use strict';\n\nconst {\n  Array\x2C\n  BigInt64Array\x2C\n  BigUint64Array\x2C\n  DataView\x2C\n  Error\x2C\n  Float32Array\x2C\n  Float64Array\x2C\n  Int16Array\x2C\n  Int32Array\x2C\n  Int8Array\x2C\n  JSONParse\x2C\n  ObjectPrototypeToString\x2C\n  Uint16Array\x2C\n  Uint32Array\x2C\n  Uint8Array\x2C\n  Uint8ClampedArray\x2C\n  globalThis: {\n    Float16Array\x2C\n  }\x2C\n} = primordials;\n\nconst { Buffer } = require('buffer');\nconst {\n  validateString\x2C\n  validateUint32\x2C\n  validateOneOf\x2C\n} = require('internal/validators');\nconst {\n  Serializer\x2C\n  Deserializer\x2C\n} = internalBinding('serdes');\nconst {\n  namespace: startupSnapshot\x2C\n} = require('internal/v8/startup_snapshot');\n\nlet profiler = {};\nif (internalBinding('config').hasInspector) {\n  profiler = internalBinding('profiler');\n}\n\nconst assert = require('internal/assert');\nconst { inspect } = require('internal/util/inspect');\nconst { FastBuffer } = require('internal/buffer');\nconst { getValidatedPath } = require('internal/fs/utils');\nconst {\n  createHeapSnapshotStream\x2C\n  triggerHeapSnapshot\x2C\n} = internalBinding('heap_utils');\nconst {\n  HeapSnapshotStream\x2C\n  getHeapSnapshotOptions\x2C\n  queryObjects\x2C\n} = require('internal/heap_utils');\nconst promiseHooks = require('internal/promise_hooks');\nconst { getOptionValue } = require('internal/options');\n\n/**\n * Generates a snapshot of the current V8 heap\n * and writes it to a JSON file.\n * @param {string} [filename]\n * @param {{\n *   exposeInternals?: boolean\x2C\n *   exposeNumericValues?: boolean\n * }} [options]\n * @returns {string}\n */\nfunction writeHeapSnapshot(filename\x2C options) {\n  if (filename !== undefined) {\n    filename = getValidatedPath(filename);\n  }\n  const optionArray = getHeapSnapshotOptions(options);\n  return triggerHeapSnapshot(filename\x2C optionArray);\n}\n\n/**\n * Generates a snapshot of the current V8 heap\n * and returns a Readable Stream.\n * @param {{\n *   exposeInternals?: boolean\x2C\n *   exposeNumericValues?: boolean\n * }} [options]\n * @returns {import('./stream.js').Readable}\n */\nfunction getHeapSnapshot(options) {\n  const optionArray = getHeapSnapshotOptions(options);\n  const handle = createHeapSnapshotStream(optionArray);\n  assert(handle);\n  return new HeapSnapshotStream(handle);\n}\n\n// We need to get the buffer from the binding at the callsite since\n// it's re-initialized after deserialization.\nconst binding = internalBinding('v8');\n\nconst {\n  cachedDataVersionTag\x2C\n  setFlagsFromString: _setFlagsFromString\x2C\n  isStringOneByteRepresentation: _isStringOneByteRepresentation\x2C\n  updateHeapStatisticsBuffer\x2C\n  updateHeapSpaceStatisticsBuffer\x2C\n  updateHeapCodeStatisticsBuffer\x2C\n  setHeapSnapshotNearHeapLimit: _setHeapSnapshotNearHeapLimit\x2C\n\n  // Properties for heap statistics buffer extraction.\n  kTotalHeapSizeIndex\x2C\n  kTotalHeapSizeExecutableIndex\x2C\n  kTotalPhysicalSizeIndex\x2C\n  kTotalAvailableSize\x2C\n  kUsedHeapSizeIndex\x2C\n  kHeapSizeLimitIndex\x2C\n  kDoesZapGarbageIndex\x2C\n  kMallocedMemoryIndex\x2C\n  kPeakMallocedMemoryIndex\x2C\n  kNumberOfNativeContextsIndex\x2C\n  kNumberOfDetachedContextsIndex\x2C\n  kTotalGlobalHandlesSizeIndex\x2C\n  kUsedGlobalHandlesSizeIndex\x2C\n  kExternalMemoryIndex\x2C\n\n  // Properties for heap spaces statistics buffer extraction.\n  kHeapSpaces\x2C\n  kSpaceSizeIndex\x2C\n  kSpaceUsedSizeIndex\x2C\n  kSpaceAvailableSizeIndex\x2C\n  kPhysicalSpaceSizeIndex\x2C\n\n  // Properties for heap code statistics buffer extraction.\n  kCodeAndMetadataSizeIndex\x2C\n  kBytecodeAndMetadataSizeIndex\x2C\n  kExternalScriptSourceSizeIndex\x2C\n  kCPUProfilerMetaDataSizeIndex\x2C\n\n  heapStatisticsBuffer\x2C\n  heapCodeStatisticsBuffer\x2C\n  heapSpaceStatisticsBuffer\x2C\n  getCppHeapStatistics: _getCppHeapStatistics\x2C\n  detailLevel\x2C\n} = binding;\n\nconst kNumberOfHeapSpaces = kHeapSpaces.length;\n\n/**\n * Sets V8 command-line flags.\n * @param {string} flags\n * @returns {void}\n */\nfunction setFlagsFromString(flags) {\n  validateString(flags\x2C 'flags');\n  _setFlagsFromString(flags);\n}\n\n/**\n * Return whether this string uses one byte as underlying representation or not.\n * @param {string} content\n * @returns {boolean}\n */\nfunction isStringOneByteRepresentation(content) {\n  validateString(content\x2C 'content');\n  return _isStringOneByteRepresentation(content);\n}\n\n\n/**\n * Gets the current V8 heap statistics.\n * @returns {{\n *   total_heap_size: number;\n *   total_heap_size_executable: number;\n *   total_physical_size: number;\n *   total_available_size: number;\n *   used_heap_size: number;\n *   heap_size_limit: number;\n *   malloced_memory: number;\n *   peak_malloced_memory: number;\n *   does_zap_garbage: number;\n *   number_of_native_contexts: number;\n *   number_of_detached_contexts: number;\n *   }}\n */\nfunction getHeapStatistics() {\n  const buffer = heapStatisticsBuffer;\n\n  updateHeapStatisticsBuffer();\n\n  return {\n    total_heap_size: buffer[kTotalHeapSizeIndex]\x2C\n    total_heap_size_executable: buffer[kTotalHeapSizeExecutableIndex]\x2C\n    total_physical_size: buffer[kTotalPhysicalSizeIndex]\x2C\n    total_available_size: buffer[kTotalAvailableSize]\x2C\n    used_heap_size: buffer[kUsedHeapSizeIndex]\x2C\n    heap_size_limit: buffer[kHeapSizeLimitIndex]\x2C\n    malloced_memory: buffer[kMallocedMemoryIndex]\x2C\n    peak_malloced_memory: buffer[kPeakMallocedMemoryIndex]\x2C\n    does_zap_garbage: buffer[kDoesZapGarbageIndex]\x2C\n    number_of_native_contexts: buffer[kNumberOfNativeContextsIndex]\x2C\n    number_of_detached_contexts: buffer[kNumberOfDetachedContextsIndex]\x2C\n    total_global_handles_size: buffer[kTotalGlobalHandlesSizeIndex]\x2C\n    used_global_handles_size: buffer[kUsedGlobalHandlesSizeIndex]\x2C\n    external_memory: buffer[kExternalMemoryIndex]\x2C\n  };\n}\n\n/**\n * Gets the current V8 heap space statistics.\n * @returns {{\n *   space_name: string;\n *   space_size: number;\n *   space_used_size: number;\n *   space_available_size: number;\n *   physical_space_size: number;\n *   }[]}\n */\nfunction getHeapSpaceStatistics() {\n  const heapSpaceStatistics = new Array(kNumberOfHeapSpaces);\n  const buffer = heapSpaceStatisticsBuffer;\n\n  for (let i = 0; i < kNumberOfHeapSpaces; i++) {\n    updateHeapSpaceStatisticsBuffer(i);\n    heapSpaceStatistics[i] = {\n      space_name: kHeapSpaces[i]\x2C\n      space_size: buffer[kSpaceSizeIndex]\x2C\n      space_used_size: buffer[kSpaceUsedSizeIndex]\x2C\n      space_available_size: buffer[kSpaceAvailableSizeIndex]\x2C\n      physical_space_size: buffer[kPhysicalSpaceSizeIndex]\x2C\n    };\n  }\n\n  return heapSpaceStatistics;\n}\n\n/**\n * Gets the current V8 heap code statistics.\n * @returns {{\n *   code_and_metadata_size: number;\n *   bytecode_and_metadata_size: number;\n *   external_script_source_size: number;\n *   cpu_profiler_metadata_size: number;\n *   }}\n */\nfunction getHeapCodeStatistics() {\n  const buffer = heapCodeStatisticsBuffer;\n\n  updateHeapCodeStatisticsBuffer();\n  return {\n    code_and_metadata_size: buffer[kCodeAndMetadataSizeIndex]\x2C\n    bytecode_and_metadata_size: buffer[kBytecodeAndMetadataSizeIndex]\x2C\n    external_script_source_size: buffer[kExternalScriptSourceSizeIndex]\x2C\n    cpu_profiler_metadata_size: buffer[kCPUProfilerMetaDataSizeIndex]\x2C\n  };\n}\n\nlet heapSnapshotNearHeapLimitCallbackAdded = false;\nfunction setHeapSnapshotNearHeapLimit(limit) {\n  validateUint32(limit\x2C 'limit'\x2C true);\n  if (heapSnapshotNearHeapLimitCallbackAdded ||\n      getOptionValue('--heapsnapshot-near-heap-limit') > 0\n  ) {\n    return;\n  }\n  heapSnapshotNearHeapLimitCallbackAdded = true;\n  _setHeapSnapshotNearHeapLimit(limit);\n}\n\nconst detailLevelDict = {\n  __proto__: null\x2C\n  detailed: detailLevel.DETAILED\x2C\n  brief: detailLevel.BRIEF\x2C\n};\n\nfunction getCppHeapStatistics(type = 'detailed') {\n  validateOneOf(type\x2C 'type'\x2C ['brief'\x2C 'detailed']);\n  const result = _getCppHeapStatistics(detailLevelDict[type]);\n  result.detail_level = type;\n  return result;\n}\n\n/* V8 serialization API */\n\n/* JS methods for the base objects */\nSerializer.prototype._getDataCloneError = Error;\n\n/**\n * Reads raw bytes from the deserializer's internal buffer.\n * @param {number} length\n * @returns {Buffer}\n */\nDeserializer.prototype.readRawBytes = function readRawBytes(length) {\n  const offset = this._readRawBytes(length);\n  // `this.buffer` can be a Buffer or a plain Uint8Array\x2C so just calling\n  // `.slice()` doesn't work.\n  return new FastBuffer(this.buffer.buffer\x2C\n                        this.buffer.byteOffset + offset\x2C\n                        length);\n};\n\nfunction arrayBufferViewTypeToIndex(abView) {\n  const type = ObjectPrototypeToString(abView);\n  if (type === '[object Int8Array]') return 0;\n  if (type === '[object Uint8Array]') return 1;\n  if (type === '[object Uint8ClampedArray]') return 2;\n  if (type === '[object Int16Array]') return 3;\n  if (type === '[object Uint16Array]') return 4;\n  if (type === '[object Int32Array]') return 5;\n  if (type === '[object Uint32Array]') return 6;\n  if (type === '[object Float32Array]') return 7;\n  if (type === '[object Float64Array]') return 8;\n  if (type === '[object DataView]') return 9;\n  // Index 10 is FastBuffer.\n  if (type === '[object BigInt64Array]') return 11;\n  if (type === '[object BigUint64Array]') return 12;\n  if (type === '[object Float16Array]') return 13;\n  return -1;\n}\n\nfunction arrayBufferViewIndexToType(index) {\n  if (index === 0) return Int8Array;\n  if (index === 1) return Uint8Array;\n  if (index === 2) return Uint8ClampedArray;\n  if (index === 3) return Int16Array;\n  if (index === 4) return Uint16Array;\n  if (index === 5) return Int32Array;\n  if (index === 6) return Uint32Array;\n  if (index === 7) return Float32Array;\n  if (index === 8) return Float64Array;\n  if (index === 9) return DataView;\n  if (index === 10) return FastBuffer;\n  if (index === 11) return BigInt64Array;\n  if (index === 12) return BigUint64Array;\n  if (index === 13) return Float16Array;\n  return undefined;\n}\n\nclass DefaultSerializer extends Serializer {\n  constructor() {\n    super();\n\n    this._setTreatArrayBufferViewsAsHostObjects(true);\n  }\n\n  /**\n   * Used to write some kind of host object\x2C i.e. an\n   * object that is created by native C++ bindings.\n   * @param {object} abView\n   * @returns {void}\n   */\n  _writeHostObject(abView) {\n    // Keep track of how to handle different ArrayBufferViews. The default\n    // Serializer for Node does not use the V8 methods for serializing those\n    // objects because Node's `Buffer` objects use pooled allocation in many\n    // cases\x2C and their underlying `ArrayBuffer`s would show up in the\n    // serialization. Because a) those may contain sensitive data and the user\n    // may not be aware of that and b) they are often much larger than the\n    // `Buffer` itself\x2C custom serialization is applied.\n    let i = 10;  // FastBuffer\n    if (abView.constructor !== Buffer) {\n      i = arrayBufferViewTypeToIndex(abView);\n      if (i === -1) {\n        throw new this._getDataCloneError(\n          `Unserializable host object: ${inspect(abView)}`);\n      }\n    }\n    this.writeUint32(i);\n    this.writeUint32(abView.byteLength);\n    this.writeRawBytes(new Uint8Array(abView.buffer\x2C\n                                      abView.byteOffset\x2C\n                                      abView.byteLength));\n  }\n}\n\nclass DefaultDeserializer extends Deserializer {\n  /**\n   * Used to read some kind of host object\x2C i.e. an\n   * object that is created by native C++ bindings.\n   * @returns {any}\n   */\n  _readHostObject() {\n    const typeIndex = this.readUint32();\n    const ctor = arrayBufferViewIndexToType(typeIndex);\n    const byteLength = this.readUint32();\n    const byteOffset = this._readRawBytes(byteLength);\n    const BYTES_PER_ELEMENT = ctor.BYTES_PER_ELEMENT || 1;\n\n    const offset = this.buffer.byteOffset + byteOffset;\n    if (offset % BYTES_PER_ELEMENT === 0) {\n      return new ctor(this.buffer.buffer\x2C\n                      offset\x2C\n                      byteLength / BYTES_PER_ELEMENT);\n    }\n    // Copy to an aligned buffer first.\n    const buffer_copy = Buffer.allocUnsafe(byteLength);\n    buffer_copy.set(new Uint8Array(this.buffer.buffer\x2C this.buffer.byteOffset + byteOffset\x2C byteLength));\n    return new ctor(buffer_copy.buffer\x2C\n                    buffer_copy.byteOffset\x2C\n                    byteLength / BYTES_PER_ELEMENT);\n  }\n}\n\n/**\n * Uses a `DefaultSerializer` to serialize `value`\n * into a buffer.\n * @param {any} value\n * @returns {Buffer}\n */\nfunction serialize(value) {\n  const ser = new DefaultSerializer();\n  ser.writeHeader();\n  ser.writeValue(value);\n  return ser.releaseBuffer();\n}\n\n/**\n * Uses a `DefaultDeserializer` with default options\n * to read a JavaScript value from a buffer.\n * @param {Buffer | TypedArray | DataView} buffer\n * @returns {any}\n */\nfunction deserialize(buffer) {\n  const der = new DefaultDeserializer(buffer);\n  der.readHeader();\n  return der.readValue();\n}\n\nclass GCProfiler {\n  #profiler = null;\n\n  start() {\n    if (!this.#profiler) {\n      this.#profiler = new binding.GCProfiler();\n      this.#profiler.start();\n    }\n  }\n\n  stop() {\n    if (this.#profiler) {\n      const data = this.#profiler.stop();\n      this.#profiler = null;\n      return JSONParse(data);\n    }\n  }\n}\n\nmodule.exports = {\n  cachedDataVersionTag\x2C\n  getHeapSnapshot\x2C\n  getHeapStatistics\x2C\n  getHeapSpaceStatistics\x2C\n  getHeapCodeStatistics\x2C\n  getCppHeapStatistics\x2C\n  setFlagsFromString\x2C\n  Serializer\x2C\n  Deserializer\x2C\n  DefaultSerializer\x2C\n  DefaultDeserializer\x2C\n  deserialize\x2C\n  takeCoverage: profiler.takeCoverage\x2C\n  stopCoverage: profiler.stopCoverage\x2C\n  serialize\x2C\n  writeHeapSnapshot\x2C\n  promiseHooks\x2C\n  queryObjects\x2C\n  startupSnapshot\x2C\n  setHeapSnapshotNearHeapLimit\x2C\n  GCProfiler\x2C\n  isStringOneByteRepresentation\x2C\n};\n
