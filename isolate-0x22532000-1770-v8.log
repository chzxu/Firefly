script-source,772,file:///mnt/d/blog/Firefly/node_modules/mdast-util-phrasing/lib/index.js,/**\n * @typedef {import('mdast').Html} Html\n * @typedef {import('mdast').PhrasingContent} PhrasingContent\n */\n\nimport {convert} from 'unist-util-is'\n\n/**\n * Check if the given value is *phrasing content*.\n *\n * > \ud83d\udc49 **Note**: Excludes `html`\x2C which can be both phrasing or flow.\n *\n * @param node\n *   Thing to check\x2C typically `Node`.\n * @returns\n *   Whether `value` is phrasing content.\n */\n\nexport const phrasing =\n  /** @type {(node?: unknown) => node is Exclude<PhrasingContent\x2C Html>} */\n  (\n    convert([\n      'break'\x2C\n      'delete'\x2C\n      'emphasis'\x2C\n      // To do: next major: removed since footnotes were added to GFM.\n      'footnote'\x2C\n      'footnoteReference'\x2C\n      'image'\x2C\n      'imageReference'\x2C\n      'inlineCode'\x2C\n      // Enabled by `mdast-util-math`:\n      'inlineMath'\x2C\n      'link'\x2C\n      'linkReference'\x2C\n      // Enabled by `mdast-util-mdx`:\n      'mdxJsxTextElement'\x2C\n      // Enabled by `mdast-util-mdx`:\n      'mdxTextExpression'\x2C\n      'strong'\x2C\n      'text'\x2C\n      // Enabled by `mdast-util-directive`:\n      'textDirective'\n    ])\n  )\n
