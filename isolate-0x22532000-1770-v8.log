script-source,703,file:///mnt/d/blog/Firefly/node_modules/micromark-util-html-tag-name/index.js,/**\n * List of lowercase HTML \u201cblock\u201d tag names.\n *\n * The list\x2C when parsing HTML (flow)\x2C results in more relaxed rules (condition\n * 6).\n * Because they are known blocks\x2C the HTML-like syntax doesn\u2019t have to be\n * strictly parsed.\n * For tag names not in this list\x2C a more strict algorithm (condition 7) is used\n * to detect whether the HTML-like syntax is seen as HTML (flow) or not.\n *\n * This is copied from:\n * <https://spec.commonmark.org/0.30/#html-blocks>.\n *\n * > \ud83d\udc49 **Note**: `search` was added in `CommonMark@0.31`.\n */\nexport const htmlBlockNames = [\n  'address'\x2C\n  'article'\x2C\n  'aside'\x2C\n  'base'\x2C\n  'basefont'\x2C\n  'blockquote'\x2C\n  'body'\x2C\n  'caption'\x2C\n  'center'\x2C\n  'col'\x2C\n  'colgroup'\x2C\n  'dd'\x2C\n  'details'\x2C\n  'dialog'\x2C\n  'dir'\x2C\n  'div'\x2C\n  'dl'\x2C\n  'dt'\x2C\n  'fieldset'\x2C\n  'figcaption'\x2C\n  'figure'\x2C\n  'footer'\x2C\n  'form'\x2C\n  'frame'\x2C\n  'frameset'\x2C\n  'h1'\x2C\n  'h2'\x2C\n  'h3'\x2C\n  'h4'\x2C\n  'h5'\x2C\n  'h6'\x2C\n  'head'\x2C\n  'header'\x2C\n  'hr'\x2C\n  'html'\x2C\n  'iframe'\x2C\n  'legend'\x2C\n  'li'\x2C\n  'link'\x2C\n  'main'\x2C\n  'menu'\x2C\n  'menuitem'\x2C\n  'nav'\x2C\n  'noframes'\x2C\n  'ol'\x2C\n  'optgroup'\x2C\n  'option'\x2C\n  'p'\x2C\n  'param'\x2C\n  'search'\x2C\n  'section'\x2C\n  'summary'\x2C\n  'table'\x2C\n  'tbody'\x2C\n  'td'\x2C\n  'tfoot'\x2C\n  'th'\x2C\n  'thead'\x2C\n  'title'\x2C\n  'tr'\x2C\n  'track'\x2C\n  'ul'\n]\n\n/**\n * List of lowercase HTML \u201craw\u201d tag names.\n *\n * The list\x2C when parsing HTML (flow)\x2C results in HTML that can include lines\n * without exiting\x2C until a closing tag also in this list is found (condition\n * 1).\n *\n * This module is copied from:\n * <https://spec.commonmark.org/0.30/#html-blocks>.\n *\n * > \ud83d\udc49 **Note**: `textarea` was added in `CommonMark@0.30`.\n */\nexport const htmlRawNames = ['pre'\x2C 'script'\x2C 'style'\x2C 'textarea']\n
