script-source,752,file:///mnt/d/blog/Firefly/node_modules/mdast-util-to-markdown/lib/util/pattern-in-scope.js,/**\n * @import {ConstructName\x2C Unsafe} from 'mdast-util-to-markdown'\n */\n\n/**\n * @param {Array<ConstructName>} stack\n * @param {Unsafe} pattern\n * @returns {boolean}\n */\nexport function patternInScope(stack\x2C pattern) {\n  return (\n    listInScope(stack\x2C pattern.inConstruct\x2C true) &&\n    !listInScope(stack\x2C pattern.notInConstruct\x2C false)\n  )\n}\n\n/**\n * @param {Array<ConstructName>} stack\n * @param {Unsafe['inConstruct']} list\n * @param {boolean} none\n * @returns {boolean}\n */\nfunction listInScope(stack\x2C list\x2C none) {\n  if (typeof list === 'string') {\n    list = [list]\n  }\n\n  if (!list || list.length === 0) {\n    return none\n  }\n\n  let index = -1\n\n  while (++index < list.length) {\n    if (stack.includes(list[index])) {\n      return true\n    }\n  }\n\n  return false\n}\n
