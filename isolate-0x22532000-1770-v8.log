script-source,442,file:///mnt/d/blog/Firefly/node_modules/hast-util-from-html/lib/errors.js,/**\n * @typedef ErrorInfo\n *   Info on a `parse5` error.\n * @property {string} reason\n *   Reason of error.\n * @property {string} description\n *   More info on error.\n * @property {false} [url]\n *   Turn off if this is not documented in the html5 spec (optional).\n */\n\nexport const errors = {\n  /** @type {ErrorInfo} */\n  abandonedHeadElementChild: {\n    reason: 'Unexpected metadata element after head'\x2C\n    description:\n      'Unexpected element after head. Expected the element before `</head>`'\x2C\n    url: false\n  }\x2C\n  /** @type {ErrorInfo} */\n  abruptClosingOfEmptyComment: {\n    reason: 'Unexpected abruptly closed empty comment'\x2C\n    description: 'Unexpected `>` or `->`. Expected `-->` to close comments'\n  }\x2C\n  /** @type {ErrorInfo} */\n  abruptDoctypePublicIdentifier: {\n    reason: 'Unexpected abruptly closed public identifier'\x2C\n    description:\n      'Unexpected `>`. Expected a closing `"` or `\\'` after the public identifier'\n  }\x2C\n  /** @type {ErrorInfo} */\n  abruptDoctypeSystemIdentifier: {\n    reason: 'Unexpected abruptly closed system identifier'\x2C\n    description:\n      'Unexpected `>`. Expected a closing `"` or `\\'` after the identifier identifier'\n  }\x2C\n  /** @type {ErrorInfo} */\n  absenceOfDigitsInNumericCharacterReference: {\n    reason: 'Unexpected non-digit at start of numeric character reference'\x2C\n    description:\n      'Unexpected `%c`. Expected `[0-9]` for decimal references or `[0-9a-fA-F]` for hexadecimal references'\n  }\x2C\n  /** @type {ErrorInfo} */\n  cdataInHtmlContent: {\n    reason: 'Unexpected CDATA section in HTML'\x2C\n    description:\n      'Unexpected `<![CDATA[` in HTML. Remove it\x2C use a comment\x2C or encode special characters instead'\n  }\x2C\n  /** @type {ErrorInfo} */\n  characterReferenceOutsideUnicodeRange: {\n    reason: 'Unexpected too big numeric character reference'\x2C\n    description:\n      'Unexpectedly high character reference. Expected character references to be at most hexadecimal 10ffff (or decimal 1114111)'\n  }\x2C\n  /** @type {ErrorInfo} */\n  closingOfElementWithOpenChildElements: {\n    reason: 'Unexpected closing tag with open child elements'\x2C\n    description:\n      'Unexpectedly closing tag. Expected other tags to be closed first'\x2C\n    url: false\n  }\x2C\n  /** @type {ErrorInfo} */\n  controlCharacterInInputStream: {\n    reason: 'Unexpected control character'\x2C\n    description:\n      'Unexpected control character `%x`. Expected a non-control code point\x2C 0x00\x2C or ASCII whitespace'\n  }\x2C\n  /** @type {ErrorInfo} */\n  controlCharacterReference: {\n    reason: 'Unexpected control character reference'\x2C\n    description:\n      'Unexpectedly control character in reference. Expected a non-control code point\x2C 0x00\x2C or ASCII whitespace'\n  }\x2C\n  /** @type {ErrorInfo} */\n  disallowedContentInNoscriptInHead: {\n    reason: 'Disallowed content inside `<noscript>` in `<head>`'\x2C\n    description:\n      'Unexpected text character `%c`. Only use text in `<noscript>`s in `<body>`'\x2C\n    url: false\n  }\x2C\n  /** @type {ErrorInfo} */\n  duplicateAttribute: {\n    reason: 'Unexpected duplicate attribute'\x2C\n    description:\n      'Unexpectedly double attribute. Expected attributes to occur only once'\n  }\x2C\n  /** @type {ErrorInfo} */\n  endTagWithAttributes: {\n    reason: 'Unexpected attribute on closing tag'\x2C\n    description: 'Unexpected attribute. Expected `>` instead'\n  }\x2C\n  /** @type {ErrorInfo} */\n  endTagWithTrailingSolidus: {\n    reason: 'Unexpected slash at end of closing tag'\x2C\n    description: 'Unexpected `%c-1`. Expected `>` instead'\n  }\x2C\n  /** @type {ErrorInfo} */\n  endTagWithoutMatchingOpenElement: {\n    reason: 'Unexpected unopened end tag'\x2C\n    description: 'Unexpected end tag. Expected no end tag or another end tag'\x2C\n    url: false\n  }\x2C\n  /** @type {ErrorInfo} */\n  eofBeforeTagName: {\n    reason: 'Unexpected end of file'\x2C\n    description: 'Unexpected end of file. Expected tag name instead'\n  }\x2C\n  /** @type {ErrorInfo} */\n  eofInCdata: {\n    reason: 'Unexpected end of file in CDATA'\x2C\n    description: 'Unexpected end of file. Expected `]]>` to close the CDATA'\n  }\x2C\n  /** @type {ErrorInfo} */\n  eofInComment: {\n    reason: 'Unexpected end of file in comment'\x2C\n    description: 'Unexpected end of file. Expected `-->` to close the comment'\n  }\x2C\n  /** @type {ErrorInfo} */\n  eofInDoctype: {\n    reason: 'Unexpected end of file in doctype'\x2C\n    description:\n      'Unexpected end of file. Expected a valid doctype (such as `<!doctype html>`)'\n  }\x2C\n  /** @type {ErrorInfo} */\n  eofInElementThatCanContainOnlyText: {\n    reason: 'Unexpected end of file in element that can only contain text'\x2C\n    description: 'Unexpected end of file. Expected text or a closing tag'\x2C\n    url: false\n  }\x2C\n  /** @type {ErrorInfo} */\n  eofInScriptHtmlCommentLikeText: {\n    reason: 'Unexpected end of file in comment inside script'\x2C\n    description: 'Unexpected end of file. Expected `-->` to close the comment'\n  }\x2C\n  /** @type {ErrorInfo} */\n  eofInTag: {\n    reason: 'Unexpected end of file in tag'\x2C\n    description: 'Unexpected end of file. Expected `>` to close the tag'\n  }\x2C\n  /** @type {ErrorInfo} */\n  incorrectlyClosedComment: {\n    reason: 'Incorrectly closed comment'\x2C\n    description: 'Unexpected `%c-1`. Expected `-->` to close the comment'\n  }\x2C\n  /** @type {ErrorInfo} */\n  incorrectlyOpenedComment: {\n    reason: 'Incorrectly opened comment'\x2C\n    description: 'Unexpected `%c`. Expected `<!--` to open the comment'\n  }\x2C\n  /** @type {ErrorInfo} */\n  invalidCharacterSequenceAfterDoctypeName: {\n    reason: 'Invalid sequence after doctype name'\x2C\n    description: 'Unexpected sequence at `%c`. Expected `public` or `system`'\