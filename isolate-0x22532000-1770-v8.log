script-source,476,file:///mnt/d/blog/Firefly/node_modules/zod/v4/locales/cs.js,import * as util from "../core/util.js";\nconst error = () => {\n    const Sizable = {\n        string: { unit: "znak\u016f"\x2C verb: "m\xedt" }\x2C\n        file: { unit: "bajt\u016f"\x2C verb: "m\xedt" }\x2C\n        array: { unit: "prvk\u016f"\x2C verb: "m\xedt" }\x2C\n        set: { unit: "prvk\u016f"\x2C verb: "m\xedt" }\x2C\n    };\n    function getSizing(origin) {\n        return Sizable[origin] ?? null;\n    }\n    const FormatDictionary = {\n        regex: "regul\xe1rn\xed v\xfdraz"\x2C\n        email: "e-mailov\xe1 adresa"\x2C\n        url: "URL"\x2C\n        emoji: "emoji"\x2C\n        uuid: "UUID"\x2C\n        uuidv4: "UUIDv4"\x2C\n        uuidv6: "UUIDv6"\x2C\n        nanoid: "nanoid"\x2C\n        guid: "GUID"\x2C\n        cuid: "cuid"\x2C\n        cuid2: "cuid2"\x2C\n        ulid: "ULID"\x2C\n        xid: "XID"\x2C\n        ksuid: "KSUID"\x2C\n        datetime: "datum a \u010das ve form\xe1tu ISO"\x2C\n        date: "datum ve form\xe1tu ISO"\x2C\n        time: "\u010das ve form\xe1tu ISO"\x2C\n        duration: "doba trv\xe1n\xed ISO"\x2C\n        ipv4: "IPv4 adresa"\x2C\n        ipv6: "IPv6 adresa"\x2C\n        cidrv4: "rozsah IPv4"\x2C\n        cidrv6: "rozsah IPv6"\x2C\n        base64: "\u0159et\u011bzec zak\xf3dovan\xfd ve form\xe1tu base64"\x2C\n        base64url: "\u0159et\u011bzec zak\xf3dovan\xfd ve form\xe1tu base64url"\x2C\n        json_string: "\u0159et\u011bzec ve form\xe1tu JSON"\x2C\n        e164: "\u010d\xedslo E.164"\x2C\n        jwt: "JWT"\x2C\n        template_literal: "vstup"\x2C\n    };\n    const TypeDictionary = {\n        nan: "NaN"\x2C\n        number: "\u010d\xedslo"\x2C\n        string: "\u0159et\u011bzec"\x2C\n        function: "funkce"\x2C\n        array: "pole"\x2C\n    };\n    return (issue) => {\n        switch (issue.code) {\n            case "invalid_type": {\n                const expected = TypeDictionary[issue.expected] ?? issue.expected;\n                const receivedType = util.parsedType(issue.input);\n                const received = TypeDictionary[receivedType] ?? receivedType;\n                if (/^[A-Z]/.test(issue.expected)) {\n                    return `Neplatn\xfd vstup: o\u010dek\xe1v\xe1no instanceof ${issue.expected}\x2C obdr\u017eeno ${received}`;\n                }\n                return `Neplatn\xfd vstup: o\u010dek\xe1v\xe1no ${expected}\x2C obdr\u017eeno ${received}`;\n            }\n            case "invalid_value":\n                if (issue.values.length === 1)\n                    return `Neplatn\xfd vstup: o\u010dek\xe1v\xe1no ${util.stringifyPrimitive(issue.values[0])}`;\n                return `Neplatn\xe1 mo\u017enost: o\u010dek\xe1v\xe1na jedna z hodnot ${util.joinValues(issue.values\x2C "|")}`;\n            case "too_big": {\n                const adj = issue.inclusive ? "<=" : "<";\n                const sizing = getSizing(issue.origin);\n                if (sizing) {\n                    return `Hodnota je p\u0159\xedli\u0161 velk\xe1: ${issue.origin ?? "hodnota"} mus\xed m\xedt ${adj}${issue.maximum.toString()} ${sizing.unit ?? "prvk\u016f"}`;\n                }\n                return `Hodnota je p\u0159\xedli\u0161 velk\xe1: ${issue.origin ?? "hodnota"} mus\xed b\xfdt ${adj}${issue.maximum.toString()}`;\n            }\n            case "too_small": {\n                const adj = issue.inclusive ? ">=" : ">";\n                const sizing = getSizing(issue.origin);\n                if (sizing) {\n                    return `Hodnota je p\u0159\xedli\u0161 mal\xe1: ${issue.origin ?? "hodnota"} mus\xed m\xedt ${adj}${issue.minimum.toString()} ${sizing.unit ?? "prvk\u016f"}`;\n                }\n                return `Hodnota je p\u0159\xedli\u0161 mal\xe1: ${issue.origin ?? "hodnota"} mus\xed b\xfdt ${adj}${issue.minimum.toString()}`;\n            }\n            case "invalid_format": {\n                const _issue = issue;\n                if (_issue.format === "starts_with")\n                    return `Neplatn\xfd \u0159et\u011bzec: mus\xed za\u010d\xednat na "${_issue.prefix}"`;\n                if (_issue.format === "ends_with")\n                    return `Neplatn\xfd \u0159et\u011bzec: mus\xed kon\u010dit na "${_issue.suffix}"`;\n                if (_issue.format === "includes")\n                    return `Neplatn\xfd \u0159et\u011bzec: mus\xed obsahovat "${_issue.includes}"`;\n                if (_issue.format === "regex")\n                    return `Neplatn\xfd \u0159et\u011bzec: mus\xed odpov\xeddat vzoru ${_issue.pattern}`;\n                return `Neplatn\xfd form\xe1t ${FormatDictionary[_issue.format] ?? issue.format}`;\n            }\n            case "not_multiple_of":\n                return `Neplatn\xe9 \u010d\xedslo: mus\xed b\xfdt n\xe1sobkem ${issue.divisor}`;\n            case "unrecognized_keys":\n                return `Nezn\xe1m\xe9 kl\xed\u010de: ${util.joinValues(issue.keys\x2C "\x2C ")}`;\n            case "invalid_key":\n                return `Neplatn\xfd kl\xed\u010d v ${issue.origin}`;\n            case "invalid_union":\n                return "Neplatn\xfd vstup";\n            case "invalid_element":\n                return `Neplatn\xe1 hodnota v ${issue.origin}`;\n            default:\n                return `Neplatn\xfd vstup`;\n        }\n    };\n};\nexport default function () {\n    return {\n        localeError: error()\x2C\n    };\n}\n
