script-source,393,file:///mnt/d/blog/Firefly/node_modules/zod/v4/core/json-schema-processors.js,import { extractDefs\x2C finalize\x2C initializeContext\x2C process\x2C } from "./to-json-schema.js";\nimport { getEnumValues } from "./util.js";\nconst formatMap = {\n    guid: "uuid"\x2C\n    url: "uri"\x2C\n    datetime: "date-time"\x2C\n    json_string: "json-string"\x2C\n    regex: ""\x2C // do not set\n};\n// ==================== SIMPLE TYPE PROCESSORS ====================\nexport const stringProcessor = (schema\x2C ctx\x2C _json\x2C _params) => {\n    const json = _json;\n    json.type = "string";\n    const { minimum\x2C maximum\x2C format\x2C patterns\x2C contentEncoding } = schema._zod\n        .bag;\n    if (typeof minimum === "number")\n        json.minLength = minimum;\n    if (typeof maximum === "number")\n        json.maxLength = maximum;\n    // custom pattern overrides format\n    if (format) {\n        json.format = formatMap[format] ?? format;\n        if (json.format === "")\n            delete json.format; // empty format is not valid\n        // JSON Schema format: "time" requires a full time with offset or Z\n        // z.iso.time() does not include timezone information\x2C so format: "time" should never be used\n        if (format === "time") {\n            delete json.format;\n        }\n    }\n    if (contentEncoding)\n        json.contentEncoding = contentEncoding;\n    if (patterns && patterns.size > 0) {\n        const regexes = [...patterns];\n        if (regexes.length === 1)\n            json.pattern = regexes[0].source;\n        else if (regexes.length > 1) {\n            json.allOf = [\n                ...regexes.map((regex) => ({\n                    ...(ctx.target === "draft-07" || ctx.target === "draft-04" || ctx.target === "openapi-3.0"\n                        ? { type: "string" }\n                        : {})\x2C\n                    pattern: regex.source\x2C\n                }))\x2C\n            ];\n        }\n    }\n};\nexport const numberProcessor = (schema\x2C ctx\x2C _json\x2C _params) => {\n    const json = _json;\n    const { minimum\x2C maximum\x2C format\x2C multipleOf\x2C exclusiveMaximum\x2C exclusiveMinimum } = schema._zod.bag;\n    if (typeof format === "string" && format.includes("int"))\n        json.type = "integer";\n    else\n        json.type = "number";\n    if (typeof exclusiveMinimum === "number") {\n        if (ctx.target === "draft-04" || ctx.target === "openapi-3.0") {\n            json.minimum = exclusiveMinimum;\n            json.exclusiveMinimum = true;\n        }\n        else {\n            json.exclusiveMinimum = exclusiveMinimum;\n        }\n    }\n    if (typeof minimum === "number") {\n        json.minimum = minimum;\n        if (typeof exclusiveMinimum === "number" && ctx.target !== "draft-04") {\n            if (exclusiveMinimum >= minimum)\n                delete json.minimum;\n            else\n                delete json.exclusiveMinimum;\n        }\n    }\n    if (typeof exclusiveMaximum === "number") {\n        if (ctx.target === "draft-04" || ctx.target === "openapi-3.0") {\n            json.maximum = exclusiveMaximum;\n            json.exclusiveMaximum = true;\n        }\n        else {\n            json.exclusiveMaximum = exclusiveMaximum;\n        }\n    }\n    if (typeof maximum === "number") {\n        json.maximum = maximum;\n        if (typeof exclusiveMaximum === "number" && ctx.target !== "draft-04") {\n            if (exclusiveMaximum <= maximum)\n                delete json.maximum;\n            else\n                delete json.exclusiveMaximum;\n        }\n    }\n    if (typeof multipleOf === "number")\n        json.multipleOf = multipleOf;\n};\nexport const booleanProcessor = (_schema\x2C _ctx\x2C json\x2C _params) => {\n    json.type = "boolean";\n};\nexport const bigintProcessor = (_schema\x2C ctx\x2C _json\x2C _params) => {\n    if (ctx.unrepresentable === "throw") {\n        throw new Error("BigInt cannot be represented in JSON Schema");\n    }\n};\nexport const symbolProcessor = (_schema\x2C ctx\x2C _json\x2C _params) => {\n    if (ctx.unrepresentable === "throw") {\n        throw new Error("Symbols cannot be represented in JSON Schema");\n    }\n};\nexport const nullProcessor = (_schema\x2C ctx\x2C json\x2C _params) => {\n    if (ctx.target === "openapi-3.0") {\n        json.type = "string";\n        json.nullable = true;\n        json.enum = [null];\n    }\n    else {\n        json.type = "null";\n    }\n};\nexport const undefinedProcessor = (_schema\x2C ctx\x2C _json\x2C _params) => {\n    if (ctx.unrepresentable === "throw") {\n        throw new Error("Undefined cannot be represented in JSON Schema");\n    }\n};\nexport const voidProcessor = (_schema\x2C ctx\x2C _json\x2C _params) => {\n    if (ctx.unrepresentable === "throw") {\n        throw new Error("Void cannot be represented in JSON Schema");\n    }\n};\nexport const neverProcessor = (_schema\x2C _ctx\x2C json\x2C _params) => {\n    json.not = {};\n};\nexport const anyProcessor = (_schema\x2C _ctx\x2C _json\x2C _params) => {\n    // empty schema accepts anything\n};\nexport const unknownProcessor = (_schema\x2C _ctx\x2C _json\x2C _params) => {\n    // empty schema accepts anything\n};\nexport const dateProcessor = (_schema\x2C ctx\x2C _json\x2C _params) => {\n    if (ctx.unrepresentable === "throw") {\n        throw new Error("Date cannot be represented in JSON Schema");\n    }\n};\nexport const enumProcessor = (schema\x2C _ctx\x2C json\x2C _params) => {\n    const def = schema._zod.def;\n    const values = getEnumValues(def.entries);\n    // Number enums can have both string and number values\n    if (values.every((v) => typeof v === "number"))\n        json.type = "number";\n    if (values.every((v) => typeof v === "string"))\n        json.type = "string";\n    json.enum = values;\n};\nexport const literalProcessor = (schema\x2C ctx\x2C json\x2C _params) => {\n    const def = schema._zod.def;\n    const vals = [];\n    for (const val of def.values) {\n        if (val === undefined) {\n            if (ctx.unrepresentable === "throw") {\n                throw new Error("Literal `undefined` cannot be represented in JSON Schema");\n            }\n            else {\n                // do not add to vals\n            }\n        }\n        else if (typeof val === "bigint") {\n            if (ctx.unrepresentable === "throw") {\n                throw new Error("BigInt literals cannot be represented in JSON Schema");\n            }\n            else {\n                vals.push(Number(val));\n            }\n        }\n        else {\n            vals.push(val);\n        }\n    }\n    if (vals.length === 0) {\n        // do nothing (an undefined literal was stripped)\n    }\n    else if (vals.length === 1) {\n        const val = vals[0];\n        json.type = val === null ? "null" : typeof val;\n        if (ctx.target === "draft-04" || ctx.target === "openapi-3.0") {\n            json.enum = [val];\n        }\n        else {\n            json.const = val;\n        }\n    }\n    else {\n        if (vals.every((v) => typeof v === "number"))\n            json.type = "number";\n        if (vals.every((v) => typeof v === "string"))\n            json.type = "string";\n        if (vals.every((v) => typeof v === "boolean"))\n            json.type = "boolean";\n        if (vals.every((v) => v === null))\n            json.type = "null";\n        json.enum = vals;\n    }\n};\nexport const nanProcessor = (_schema\x2C ctx\x2C _json\x2C _params) => {\n    if (ctx.unrepresentable === "throw") {\n        throw new Error("NaN cannot be represented in JSON Schema");\n    }\n};\nexport const templateLiteralProcessor = (schema\x2C _ctx\x2C json\x2C _params) => {\n    const _json = json;\n    const pattern = schema._zod.pattern;\n    if (!pattern)\n        throw new Error("Pattern not found in template literal");\n    _json.type = "string";\n    _json.pattern = pattern.source;\n};\nexport const fileProcessor = (schema\x2C _ctx\x2C json\x2C _params) => {\n    const _json = json;\n    const file = {\n        type: "string"\x2C\n        format: "binary"\x2C\n        contentEncoding: "binary"\x2C\n    };\n    const { minimum\x2C maximum\x2C mime } = schema._zod.bag;\n    if (minimum !== undefined)\n        file.minLength = minimum;\n    if (maximum !== undefined)\n        file.maxLength = maximum;\n    if (mime) {\n        if (mime.length === 1) {\n            file.contentMediaType = mime[0];\n            Object.assign(_json\x2C file);\n        }\n        else {\n            Object.assign(_json\x2C file); // shared props at root\n            _json.anyOf = mime.map((m) => ({ contentMediaType: m })); // only contentMediaType differs\n        }\n    }\n    else {\n        Object.assign(_json\x2C file);\n    }\n};\nexport const successProcessor = (_schema\x2C _ctx\x2C json\x2C _params) => {\n    json.type = "boolean";\n};\nexport const customProcessor = (_schema\x2C ctx\x2C _json\x2C _params) => {\n    if (ctx.unrepresentable === "throw") {\n        throw new Error("Custom types cannot be represented in JSON Schema");\n    }\n};\nexport const functionProcessor = (_schema\x2C ctx\x2C _json\x2C _params) => {\n    if (ctx.unrepresentable === "throw") {\n        throw new Error("Function types cannot be represented in JSON Schema");\n    }\n};\nexport const transformProcessor = (_schema\x2C ctx\x2C _json\x2C _params) => {\n    if (ctx.unrepresentable === "throw") {\n        throw new Error("Transforms cannot be represented in JSON Schema");\n    }\n};\nexport const mapProcessor = (_schema\x2C ctx\x2C _json\x2C _params) => {\n    if (ctx.unrepresentable === "throw") {\n        throw new Error("Map cannot be represented in JSON Schema");\n    }\n};\nexport const setProcessor = (_schema\x2C ctx\x2C _json\x2C _params) => {\n    if (ctx.unrepresentable === "throw") {\n        throw new Error("Set cannot be represented in JSON Schema");\n    }\n};\n// ==================== COMPOSITE TYPE PROCESSORS ====================\nexport const arrayProcessor = (schema\x2C ctx\x2C _json\x2C params) => {\n    const json = _json;\n    const def = schema._zod.def;\n    const { minimum\x2C maximum } = schema._zod.bag;\n    if (typeof minimum === "number")\n        json.minItems = minimum;\n    if (typeof maximum === "number")\n        json.maxItems = maximum;\n    json.type = "array";\n    json.items = process(def.element\x2C ctx\x2C { ...params\x2C path: [...params.path\x2C "items"] });\n};\nexport const objectProcessor = (schema\x2C ctx\x2C _json\x2C params) => {\n    const json = _json;\n    const def = schema._zod.def;\n    json.type = "object";\n    json.properties = {};\n    const shape = def.shape;\n    for (const key in shape) {\n        json.properties[key] = process(shape[key]\x2C ctx\x2C {\n            ...params\x2C\n            path: [...params.path\x2C "properties"\x2C key]\x2C\n        });\n    }\n    // required keys\n    const allKeys = new Set(Object.keys(shape));\n    const requiredKeys = new Set([...allKeys].filter((key) => {\n        const v = def.shape[key]._zod;\n        if (ctx.io === "input") {\n            return v.optin === undefined;\n        }\n        else {\n            return v.optout === undefined;\n        }\n    }));\n    if (requiredKeys.size > 0) {\n        json.required = Array.from(requiredKeys);\n    }\n    // catchall\n    if (def.catchall?._zod.def.type === "never") {\n        // strict\n        json.additionalProperties = false;\n    }\n    else if (!def.catchall) {\n        // regular\n        if (ctx.io === "output")\n            json.additionalProperties = false;\n    }\n    else if (def.catchall) {\n        json.additionalProperties = process(def.catchall\x2C ctx\x2C {\n            ...params\x2C\n            path: [...params.path\x2C "additionalProperties"]\x2C\n        });\n    }\n};\nexport const unionProcessor = (schema\x2C ctx\x2C json\x2C params) => {\n    const def = schema._zod.def;\n    // Exclusive unions (inclusive === false) use oneOf (exactly one match) instead of anyOf (one or more matches)\n    // This includes both z.xor() and discriminated unions\n    const isExclusive = def.inclusive === false;\n    const options = def.options.map((x\x2C i) => process(x\x2C ctx\x2C {\n        ...params\x2C\n        path: [...params.path\x2C isExclusive ? "oneOf" : "anyOf"\x2C i]\x2C\n    }));\n    if (isExclusive) {\n        json.oneOf = options;\n    }\n    else {\n        json.anyOf = options;\n    }\n};\nexport const intersectionProcessor = (schema\x2C ctx\x2C json\x2C params) => {\n    const def = schema._zod.def;\n    const a = process(def.left\x2C ctx\x2C {\n        ...params\x2C\n        path: [...params.path\x2C "allOf"\x2C 0]\x2C\n    });\n    const b = process(def.right\x2C ctx\x2C {\n        ...params\x2C\n        path: [...params.path\x2C "allOf"\x2C 1]\x2C\n    });\n    const isSimpleIntersection = (val) => "allOf" in val && Object.keys(val).length === 1;\n    const allOf = [\n        ...(isSimpleIntersection(a) ? a.allOf : [a])\x2C\n        ...(isSimpleIntersection(b) ? b.allOf : [b])\x2C\n    ];\n    json.allOf = allOf;\n};\nexport const tupleProcessor = (schema\x2C ctx\x2C _json\x2C params) => {\n    const json = _json;\n    const def = schema._zod.def;\n    json.type = "array";\n    const prefixPath = ctx.target === "draft-2020-12" ? "prefixItems" : "items";\n    const restPath = ctx.target === "draft-2020-12" ? "items" : ctx.target === "openapi-3.0" ? "items" : "additionalItems";\n    const prefixItems = def.items.map((x\x2C i) => process(x\x2C ctx\x2C {\n        ...params\x2C\n        path: [...params.path\x2C prefixPath\x2C i]\x2C\n    }));\n    const rest = def.rest\n        ? process(def.rest\x2C ctx\x2C {\n            ...params\x2C\n            path: [...params.path\x2C restPath\x2C ...(ctx.target === "openapi-3.0" ? [def.items.length] : [])]\x2C\n        })\n        : null;\n    if (ctx.target === "draft-2020-12") {\n        json.prefixItems = prefixItems;\n        if (rest) {\n            json.items = rest;\n        }\n    }\n    else if (ctx.target === "openapi-3.0") {\n        json.items = {\n            anyOf: prefixItems\x2C\n        };\n        if (rest) {\n            json.items.anyOf.push(rest);\n        }\n        json.minItems = prefixItems.length;\n        if (!rest) {\n            json.maxItems = prefixItems.length;\n        }\n    }\n    else {\n        json.items = prefixItems;\n        if (rest) {\n            json.additionalItems = rest;\n        }\n    }\n    // length\n    const { minimum\x2C maximum } = schema._zod.bag;\n    if (typeof minimum === "number")\n        json.minItems = minimum;\n    if (typeof maximum === "number")\n        json.maxItems = maximum;\n};\nexport const recordProcessor = (schema\x2C ctx\x2C _json\x2C params) => {\n    const json = _json;\n    const def = schema._zod.def;\n    json.type = "object";\n    // For looseRecord with regex patterns\x2C use patternProperties\n    // This correctly represents "only validate keys matching the pattern" semantics\n    // and composes well with allOf (intersections)\n    const keyType = def.keyType;\n    const keyBag = keyType._zod.bag;\n    const patterns = keyBag?.patterns;\n    if (def.mode === "loose" && patterns && patterns.size > 0) {\n        // Use patternProperties for looseRecord with regex patterns\n        const valueSchema = process(def.valueType\x2C ctx\x2C {\n            ...params\x2C\n            path: [...params.path\x2C "patternProperties"\x2C "*"]\x2C\n        });\n        json.patternProperties = {};\n        for (const pattern of patterns) {\n            json.patternProperties[pattern.source] = valueSchema;\n        }\n    }\n    else {\n        // Default behavior: use propertyNames + additionalProperties\n        if (ctx.target === "draft-07" || ctx.target === "draft-2020-12") {\n            json.propertyNames = process(def.keyType\x2C ctx\x2C {\n                ...params\x2C\n                path: [...params.path\x2C "propertyNames"]\x2C\n            });\n        }\n        json.additionalProperties = process(def.valueType\x2C ctx\x2C {\n            ...params\x2C\n            path: [...params.path\x2C "additionalProperties"]\x2C\n        });\n    }\n    // Add required for keys with discrete values (enum\x2C literal\x2C etc.)\n    const keyValues = keyType._zod.values;\n    if (keyValues) {\n        const validKeyValues = [...keyValues].filter((v) => typeof v === "string" || typeof v === "number");\n        if (validKeyValues.length > 0) {\n            json.required = validKeyValues;\n        }\n    }\n};\nexport const nullableProcessor = (schema\x2C ctx\x2C json\x2C params) => {\n    const def = schema._zod.def;\n    const inner = process(def.innerType\x2C ctx\x2C params);\n    const seen = ctx.seen.get(schema);\n    if (ctx.target === "openapi-3.0") {\n        seen.ref = def.innerType;\n        json.nullable = true;\n    }\n    else {\n        json.anyOf = [inner\x2C { type: "null" }];\n    }\n};\nexport const nonoptionalProcessor = (schema\x2C ctx\x2C _json\x2C params) => {\n    const def = schema._zod.def;\n    process(def.innerType\x2C ctx\x2C params);\n    const seen = ctx.seen.get(schema);\n    seen.ref = def.innerType;\n};\nexport const defaultProcessor = (schema\x2C ctx\x2C json\x2C params) => {\n    const def = schema._zod.def;\n    process(def.innerType\x2C ctx\x2C params);\n    const seen = ctx.seen.get(schema);\n    seen.ref = def.innerType;\n    json.default = JSON.parse(JSON.stringify(def.defaultValue));\n};\nexport const prefaultProcessor = (schema\x2C ctx\x2C json\x2C params) => {\n    const def = schema._zod.def;\n    process(def.innerType\x2C ctx\x2C params);\n    const seen = ctx.seen.get(schema);\n    seen.ref = def.innerType;\n    if (ctx.io === "input")\n        json._prefault = JSON.parse(JSON.stringify(def.defaultValue));\n};\nexport const catchProcessor = (schema\x2C ctx\x2C json\x2C params) => {\n    const def = schema._zod.def;\n    process(def.innerType\x2C ctx\x2C params);\n    const seen = ctx.seen.get(schema);\n    seen.ref = def.innerType;\n    let catchValue;\n    try {\n        catchValue = def.catchValue(undefined);\n    }\n    catch {\n        throw new Error("Dynamic catch values are not supported in JSON Schema");\n    }\n    json.default = catchValue;\n};\nexport const pipeProcessor = (schema\x2C ctx\x2C _json\x2C params) => {\n    const def = schema._zod.def;\n    const innerType = ctx.io === "input" ? (def.in._zod.def.type === "transform" ? def.out : def.in) : def.out;\n    process(innerType\x2C ctx\x2C params);\n    const seen = ctx.seen.get(schema);\n    seen.ref = innerType;\n};\nexport const readonlyProcessor = (schema\x2C ctx\x2C json\x2C params) => {\n    const def = schema._zod.def;\n    process(def.innerType\x2C ctx\x2C params);\n    const seen = ctx.seen.get(schema);\n    seen.ref = def.innerType;\n    json.readOnly = true;\n};\nexport const promiseProcessor = (schema\x2C ctx\x2C _json\x2C params) => {\n    const def = schema._zod.def;\n    process(def.innerType\x2C ctx\x2C params);\n    const seen = ctx.seen.get(schema);\n    seen.ref = def.innerType;\n};\nexport const optionalProcessor = (schema\x2C ctx\x2C _json\x2C params) => {\n    const def = schema._zod.def;\n    process(def.innerType\x2C ctx\x2C params);\n    const seen = ctx.seen.get(schema);\n    seen.ref = def.innerType;\n};\nexport const lazyProcessor = (schema\x2C ctx\x2C _json\x2C params) => {\n    const innerType = schema._zod.innerType;\n    process(innerType\x2C ctx\x2C params);\n    const seen = ctx.seen.get(schema);\n    seen.ref = innerType;\n};\n// ==================== ALL PROCESSORS ====================\nexport const allProcessors = {\n    string: stringProcessor\x2C\n    number: numberProcessor\x2C\n    boolean: booleanProcessor\x2C\n    bigint: bigintProcessor\x2C\n    symbol: symbolProcessor\x2C\n    null: nullProcessor\x2C\n    undefined: undefinedProcessor\x2C\n    void: voidProcessor\x2C\n    never: neverProcessor\x2C\n    any: anyProcessor\x2C\n    unknown: unknownProcessor\x2C\n    date: dateProcessor\x2C\n    enum: enumProcessor\x2C\n    literal: literalProcessor\x2C\n    nan: nanProcessor\x2C\n    template_literal: templateLiteralProcessor\x2C\n    file: fileProcessor\x2C\n    success: successProcessor\x2C\n    custom: customProcessor\x2C\n    function: functionProcessor\x2C\n    transform: transformProcessor\x2C\n    map: mapProcessor\x2C\n    set: setProcessor\x2C\n    array: arrayProcessor\x2C\n    object: objectProcessor\x2C\n    union: unionProcessor\x2C\n    intersection: intersectionProcessor\x2C\n    tuple: tupleProcessor\x2C\n    record: recordProcessor\x2C\n    nullable: nullableProcessor\x2C\n    nonoptional: nonoptionalProcessor\x2C\n    default: defaultProcessor\x2C\n    prefault: prefaultProcessor\x2C\n    catch: catchProcessor\x2C\n    pipe: pipeProcessor\x2C\n    readonly: readonlyProcessor\x2C\n    promise: promiseProcessor\x2C\n    optional: optionalProcessor\x2C\n    lazy: lazyProcessor\x2C\n};\nexport function toJSONSchema(input\x2C params) {\n    if ("_idmap" in input) {\n        // Registry case\n        const registry = input;\n        const ctx = initializeContext({ ...params\x2C processors: allProcessors });\n        const defs = {};\n        // First pass: process all schemas to build the seen map\n        for (const entry of registry._idmap.entries()) {\n            const [_\x2C schema] = entry;\n            process(schema\x2C ctx);\n        }\n        const schemas = {};\n        const external = {\n            registry\x2C\n            uri: params?.uri\x2C\n            defs\x2C\n        };\n        // Update the context with external configuration\n        ctx.external = external;\n        // Second pass: emit each schema\n        for (const entry of registry._idmap.entries()) {\n            const [key\x2C schema] = entry;\n            extractDefs(ctx\x2C schema);\n            schemas[key] = finalize(ctx\x2C schema);\n        }\n        if (Object.key