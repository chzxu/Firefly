script-source,185,node:internal/crypto/webcrypto,'use strict';\n\nconst {\n  ArrayPrototypeIncludes\x2C\n  JSONParse\x2C\n  JSONStringify\x2C\n  ObjectDefineProperties\x2C\n  ObjectDefineProperty\x2C\n  ReflectApply\x2C\n  ReflectConstruct\x2C\n  StringPrototypeRepeat\x2C\n  SymbolToStringTag\x2C\n} = primordials;\n\nconst {\n  kWebCryptoKeyFormatRaw\x2C\n  kWebCryptoKeyFormatPKCS8\x2C\n  kWebCryptoKeyFormatSPKI\x2C\n  kWebCryptoCipherEncrypt\x2C\n  kWebCryptoCipherDecrypt\x2C\n} = internalBinding('crypto');\n\nconst {\n  getOptionValue\x2C\n} = require('internal/options');\n\nconst { TextDecoder\x2C TextEncoder } = require('internal/encoding');\n\nconst {\n  codes: {\n    ERR_ILLEGAL_CONSTRUCTOR\x2C\n    ERR_INVALID_THIS\x2C\n  }\x2C\n} = require('internal/errors');\n\nconst {\n  CryptoKey\x2C\n  importGenericSecretKey\x2C\n} = require('internal/crypto/keys');\n\nconst {\n  asyncDigest\x2C\n} = require('internal/crypto/hash');\n\nconst {\n  getBlockSize\x2C\n  normalizeAlgorithm\x2C\n  normalizeHashName\x2C\n  validateMaxBufferLength\x2C\n  kHandle\x2C\n  kKeyObject\x2C\n} = require('internal/crypto/util');\n\nconst {\n  kEnumerableProperty\x2C\n  lazyDOMException\x2C\n} = require('internal/util');\n\nconst {\n  getRandomValues: _getRandomValues\x2C\n  randomUUID: _randomUUID\x2C\n} = require('internal/crypto/random');\n\nlet webidl;\n\nasync function digest(algorithm\x2C data) {\n  if (this !== subtle) throw new ERR_INVALID_THIS('SubtleCrypto');\n\n  webidl ??= require('internal/crypto/webidl');\n  const prefix = "Failed to execute 'digest' on 'SubtleCrypto'";\n  webidl.requiredArguments(arguments.length\x2C 2\x2C { prefix });\n  algorithm = webidl.converters.AlgorithmIdentifier(algorithm\x2C {\n    prefix\x2C\n    context: '1st argument'\x2C\n  });\n  data = webidl.converters.BufferSource(data\x2C {\n    prefix\x2C\n    context: '2nd argument'\x2C\n  });\n\n  algorithm = normalizeAlgorithm(algorithm\x2C 'digest');\n\n  return await ReflectApply(asyncDigest\x2C this\x2C [algorithm\x2C data]);\n}\n\nfunction randomUUID() {\n  if (this !== crypto) throw new ERR_INVALID_THIS('Crypto');\n  return _randomUUID();\n}\n\nasync function generateKey(\n  algorithm\x2C\n  extractable\x2C\n  keyUsages) {\n  if (this !== subtle) throw new ERR_INVALID_THIS('SubtleCrypto');\n\n  webidl ??= require('internal/crypto/webidl');\n  const prefix = "Failed to execute 'generateKey' on 'SubtleCrypto'";\n  webidl.requiredArguments(arguments.length\x2C 3\x2C { prefix });\n  algorithm = webidl.converters.AlgorithmIdentifier(algorithm\x2C {\n    prefix\x2C\n    context: '1st argument'\x2C\n  });\n  extractable = webidl.converters.boolean(extractable\x2C {\n    prefix\x2C\n    context: '2nd argument'\x2C\n  });\n  keyUsages = webidl.converters['sequence<KeyUsage>'](keyUsages\x2C {\n    prefix\x2C\n    context: '3rd argument'\x2C\n  });\n\n  algorithm = normalizeAlgorithm(algorithm\x2C 'generateKey');\n  let result;\n  let resultType;\n  switch (algorithm.name) {\n    case 'RSASSA-PKCS1-v1_5':\n      // Fall through\n    case 'RSA-PSS':\n      // Fall through\n    case 'RSA-OAEP':\n      resultType = 'CryptoKeyPair';\n      result = await require('internal/crypto/rsa')\n        .rsaKeyGenerate(algorithm\x2C extractable\x2C keyUsages);\n      break;\n    case 'Ed25519':\n      // Fall through\n    case 'Ed448':\n      // Fall through\n    case 'X25519':\n      // Fall through\n    case 'X448':\n      resultType = 'CryptoKeyPair';\n      result = await require('internal/crypto/cfrg')\n        .cfrgGenerateKey(algorithm\x2C extractable\x2C keyUsages);\n      break;\n    case 'ECDSA':\n      // Fall through\n    case 'ECDH':\n      resultType = 'CryptoKeyPair';\n      result = await require('internal/crypto/ec')\n        .ecGenerateKey(algorithm\x2C extractable\x2C keyUsages);\n      break;\n    case 'HMAC':\n      resultType = 'CryptoKey';\n      result = await require('internal/crypto/mac')\n        .hmacGenerateKey(algorithm\x2C extractable\x2C keyUsages);\n      break;\n    case 'AES-CTR':\n      // Fall through\n    case 'AES-CBC':\n      // Fall through\n    case 'AES-GCM':\n      // Fall through\n    case 'AES-KW':\n      resultType = 'CryptoKey';\n      result = await require('internal/crypto/aes')\n        .aesGenerateKey(algorithm\x2C extractable\x2C keyUsages);\n      break;\n    default:\n      throw lazyDOMException('Unrecognized algorithm name'\x2C 'NotSupportedError');\n  }\n\n  if (\n    (resultType === 'CryptoKey' &&\n      (result.type === 'secret' || result.type === 'private') &&\n      result.usages.length === 0) ||\n    (resultType === 'CryptoKeyPair' && result.privateKey.usages.length === 0)\n  ) {\n    throw lazyDOMException(\n      'Usages cannot be empty when creating a key.'\x2C\n      'SyntaxError');\n  }\n\n  return result;\n}\n\nasync function deriveBits(algorithm\x2C baseKey\x2C length = null) {\n  if (this !== subtle) throw new ERR_INVALID_THIS('SubtleCrypto');\n\n  webidl ??= require('internal/crypto/webidl');\n  const prefix = "Failed to execute 'deriveBits' on 'SubtleCrypto'";\n  webidl.requiredArguments(arguments.length\x2C 2\x2C { prefix });\n  algorithm = webidl.converters.AlgorithmIdentifier(algorithm\x2C {\n    prefix\x2C\n    context: '1st argument'\x2C\n  });\n  baseKey = webidl.converters.CryptoKey(baseKey\x2C {\n    prefix\x2C\n    context: '2nd argument'\x2C\n  });\n  if (length !== null) {\n    length = webidl.converters['unsigned long'](length\x2C {\n      prefix\x2C\n      context: '3rd argument'\x2C\n    });\n  }\n\n  algorithm = normalizeAlgorithm(algorithm\x2C 'deriveBits');\n  if (!ArrayPrototypeIncludes(baseKey.usages\x2C 'deriveBits')) {\n    throw lazyDOMException(\n      'baseKey does not have deriveBits usage'\x2C\n      'InvalidAccessError');\n  }\n  if (baseKey.algorithm.name !== algorithm.name)\n    throw lazyDOMException('Key algorithm mismatch'\x2C 'InvalidAccessError');\n  switch (algorithm.name) {\n    case 'X25519':\n      // Fall through\n    case 'X448':\n      // Fall through\n    case 'ECDH':\n      return await require('internal/crypto/diffiehellman')\n        .ecdhDeriveBits(algorithm\x2C baseKey\x2C length);\n    case 'HKDF':\n      return await require('internal/crypto/hkdf')\n        .hkdfDeriveBits(algorithm\x2C baseKey\x2C length);\n    case 'PBKDF2':\n      return await require('internal/crypto/pbkdf2')\n        .pbkdf2DeriveBits(algorithm\x2C baseKey\x2C length);\n  }\n  throw lazyDOMException('Unrecognized algorithm name'\x2C 'NotSupportedError');\n}\n\nfunction getKeyLength({ name\x2C length\x2C hash }) {\n  switch (name) {\n    case 'AES-CTR':\n    case 'AES-CBC':\n    case 'AES-GCM':\n    case 'AES-KW':\n      if (length !== 128 && length !== 192 && length !== 256)\n        throw lazyDOMException('Invalid key length'\x2C 'OperationError');\n\n      return length;\n    case 'HMAC':\n      if (length === undefined) {\n        return getBlockSize(hash?.name);\n      }\n\n      if (typeof length === 'number' && length !== 0) {\n        return length;\n      }\n\n      throw lazyDOMException('Invalid key length'\x2C 'OperationError');\n    case 'HKDF':\n    case 'PBKDF2':\n      return null;\n  }\n}\n\nasync function deriveKey(\n  algorithm\x2C\n  baseKey\x2C\n  derivedKeyAlgorithm\x2C\n  extractable\x2C\n  keyUsages) {\n  if (this !== subtle) throw new ERR_INVALID_THIS('SubtleCrypto');\n\n  webidl ??= require('internal/crypto/webidl');\n  const prefix = "Failed to execute 'deriveKey' on 'SubtleCrypto'";\n  webidl.requiredArguments(arguments.length\x2C 5\x2C { prefix });\n  algorithm = webidl.converters.AlgorithmIdentifier(algorithm\x2C {\n    prefix\x2C\n    context: '1st argument'\x2C\n  });\n  baseKey = webidl.converters.CryptoKey(baseKey\x2C {\n    prefix\x2C\n    context: '2nd argument'\x2C\n  });\n  derivedKeyAlgorithm = webidl.converters.AlgorithmIdentifier(derivedKeyAlgorithm\x2C {\n    prefix\x2C\n    context: '3rd argument'\x2C\n  });\n  extractable = webidl.converters.boolean(extractable\x2C {\n    prefix\x2C\n    context: '4th argument'\x2C\n  });\n  keyUsages = webidl.converters['sequence<KeyUsage>'](keyUsages\x2C {\n    prefix\x2C\n    context: '5th argument'\x2C\n  });\n\n  algorithm = normalizeAlgorithm(algorithm\x2C 'deriveBits');\n  derivedKeyAlgorithm = normalizeAlgorithm(derivedKeyAlgorithm\x2C 'importKey');\n  if (!ArrayPrototypeIncludes(baseKey.usages\x2C 'deriveKey')) {\n    throw lazyDOMException(\n      'baseKey does not have deriveKey usage'\x2C\n      'InvalidAccessError');\n  }\n  if (baseKey.algorithm.name !== algorithm.name)\n    throw lazyDOMException('Key algorithm mismatch'\x2C 'InvalidAccessError');\n\n  const length = getKeyLength(normalizeAlgorithm(arguments[2]\x2C 'get key length'));\n  let bits;\n  switch (algorithm.name) {\n    case 'X25519':\n      // Fall through\n    case 'X448':\n      // Fall through\n    case 'ECDH':\n      bits = await require('internal/crypto/diffiehellman')\n        .ecdhDeriveBits(algorithm\x2C baseKey\x2C length);\n      break;\n    case 'HKDF':\n      bits = await require('internal/crypto/hkdf')\n        .hkdfDeriveBits(algorithm\x2C baseKey\x2C length);\n      break;\n    case 'PBKDF2':\n      bits = await require('internal/crypto/pbkdf2')\n        .pbkdf2DeriveBits(algorithm\x2C baseKey\x2C length);\n      break;\n    default:\n      throw lazyDOMException('Unrecognized algorithm name'\x2C 'NotSupportedError');\n  }\n\n  return ReflectApply(\n    importKey\x2C\n    this\x2C\n    ['raw'\x2C bits\x2C derivedKeyAlgorithm\x2C extractable\x2C keyUsages]\x2C\n  );\n}\n\nasync function exportKeySpki(key) {\n  switch (key.algorithm.name) {\n    case 'RSASSA-PKCS1-v1_5':\n      // Fall through\n    case 'RSA-PSS':\n      // Fall through\n    case 'RSA-OAEP':\n      return await require('internal/crypto/rsa')\n        .rsaExportKey(key\x2C kWebCryptoKeyFormatSPKI);\n    case 'ECDSA':\n      // Fall through\n    case 'ECDH':\n      return await require('internal/crypto/ec')\n        .ecExportKey(key\x2C kWebCryptoKeyFormatSPKI);\n    case 'Ed25519':\n      // Fall through\n    case 'Ed448':\n      // Fall through\n    case 'X25519':\n      // Fall through\n    case 'X448':\n      return await require('internal/crypto/cfrg')\n        .cfrgExportKey(key\x2C kWebCryptoKeyFormatSPKI);\n    default:\n      return undefined;\n  }\n}\n\nasync function exportKeyPkcs8(key) {\n  switch (key.algorithm.name) {\n    case 'RSASSA-PKCS1-v1_5':\n      // Fall through\n    case 'RSA-PSS':\n      // Fall through\n    case 'RSA-OAEP':\n      return await require('internal/crypto/rsa')\n        .rsaExportKey(key\x2C kWebCryptoKeyFormatPKCS8);\n    case 'ECDSA':\n      // Fall through\n    case 'ECDH':\n      return await require('internal/crypto/ec')\n        .ecExportKey(key\x2C kWebCryptoKeyFormatPKCS8);\n    case 'Ed25519':\n      // Fall through\n    case 'Ed448':\n      // Fall through\n    case 'X25519':\n      // Fall through\n    case 'X448':\n      return await require('internal/crypto/cfrg')\n        .cfrgExportKey(key\x2C kWebCryptoKeyFormatPKCS8);\n    default:\n      return undefined;\n  }\n}\n\nasync function exportKeyRawPublic(key) {\n  switch (key.algorithm.name) {\n    case 'ECDSA':\n      // Fall through\n    case 'ECDH':\n      return await require('internal/crypto/ec')\n        .ecExportKey(key\x2C kWebCryptoKeyFormatRaw);\n    case 'Ed25519':\n      // Fall through\n    case 'Ed448':\n      // Fall through\n    case 'X25519':\n      // Fall through\n    case 'X448':\n      return await require('internal/crypto/cfrg')\n        .cfrgExportKey(key\x2C kWebCryptoKeyFormatRaw);\n    default:\n      return undefined;\n  }\n}\n\nasync function exportKeyRawSecret(key) {\n  switch (key.algorithm.name) {\n    case 'AES-CTR':\n      // Fall through\n    case 'AES-CBC':\n      // Fall through\n    case 'AES-GCM':\n      // Fall through\n    case 'AES-KW':\n      // Fall through\n    case 'HMAC':\n      return key[kKeyObject][kHandle].export().buffer;\n    default:\n      return un