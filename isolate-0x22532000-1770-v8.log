script-source,167,file:///mnt/d/blog/Firefly/node_modules/astro/dist/core/errors/utils.js,function positionAt(offset\x2C text) {\n  const lineOffsets = getLineOffsets(text);\n  offset = Math.max(0\x2C Math.min(text.length\x2C offset));\n  let low = 0;\n  let high = lineOffsets.length;\n  if (high === 0) {\n    return {\n      line: 0\x2C\n      column: offset\n    };\n  }\n  while (low <= high) {\n    const mid = Math.floor((low + high) / 2);\n    const lineOffset = lineOffsets[mid];\n    if (lineOffset === offset) {\n      return {\n        line: mid\x2C\n        column: 0\n      };\n    } else if (offset > lineOffset) {\n      low = mid + 1;\n    } else {\n      high = mid - 1;\n    }\n  }\n  const line = low - 1;\n  return { line\x2C column: offset - lineOffsets[line] };\n}\nfunction getLineOffsets(text) {\n  const lineOffsets = [];\n  let isLineStart = true;\n  for (let i = 0; i < text.length; i++) {\n    if (isLineStart) {\n      lineOffsets.push(i);\n      isLineStart = false;\n    }\n    const ch = text.charAt(i);\n    isLineStart = ch === "\\r" || ch === "\\n";\n    if (ch === "\\r" && i + 1 < text.length && text.charAt(i + 1) === "\\n") {\n      i++;\n    }\n  }\n  if (isLineStart && text.length > 0) {\n    lineOffsets.push(text.length);\n  }\n  return lineOffsets;\n}\nfunction isYAMLException(err) {\n  return err instanceof Error && err.name === "YAMLException";\n}\nfunction formatYAMLException(e) {\n  return {\n    name: e.name\x2C\n    id: e.mark.name\x2C\n    loc: { file: e.mark.name\x2C line: e.mark.line + 1\x2C column: e.mark.column }\x2C\n    message: e.reason\x2C\n    stack: e.stack ?? ""\n  };\n}\nfunction isTOMLError(err) {\n  return err instanceof Error && err.name === "TomlError";\n}\nfunction formatTOMLError(e) {\n  return {\n    name: e.name\x2C\n    id: e.name\x2C\n    loc: { line: e.line + 1\x2C column: e.column }\x2C\n    message: e.message\x2C\n    stack: e.stack ?? ""\n  };\n}\nfunction createSafeError(err) {\n  if (err instanceof Error || err?.name && err.message) {\n    return err;\n  } else {\n    const error = new Error(JSON.stringify(err));\n    error.hint = `To get as much information as possible from your errors\x2C make sure to throw Error objects instead of \\`${typeof err}\\`. See https://developer.mozilla.org/en-US/docs/Web/JavaScript/Reference/Global_Objects/Error for more information.`;\n    return error;\n  }\n}\nfunction normalizeLF(code) {\n  return code.replace(/\\r\\n|\\r(?!\\n)|\\n/g\x2C "\\n");\n}\nexport {\n  createSafeError\x2C\n  formatTOMLError\x2C\n  formatYAMLException\x2C\n  isTOMLError\x2C\n  isYAMLException\x2C\n  normalizeLF\x2C\n  positionAt\n};\n
