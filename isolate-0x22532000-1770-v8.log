script-source,166,file:///mnt/d/blog/Firefly/node_modules/astro/dist/core/errors/errors-data.js,const UnknownCompilerError = {\n  name: "UnknownCompilerError"\x2C\n  title: "Unknown compiler error."\x2C\n  hint: "This is almost always a problem with the Astro compiler\x2C not your code. Please open an issue at https://astro.build/issues/compiler."\n};\nconst ClientAddressNotAvailable = {\n  name: "ClientAddressNotAvailable"\x2C\n  title: "`Astro.clientAddress` is not available in current adapter."\x2C\n  message: (adapterName) => `\\`Astro.clientAddress\\` is not available in the \\`${adapterName}\\` adapter. File an issue with the adapter to add support.`\n};\nconst PrerenderClientAddressNotAvailable = {\n  name: "PrerenderClientAddressNotAvailable"\x2C\n  title: "`Astro.clientAddress` cannot be used inside prerendered routes."\x2C\n  message: (name) => `\\`Astro.clientAddress\\` cannot be used inside prerendered route ${name}`\n};\nconst StaticClientAddressNotAvailable = {\n  name: "StaticClientAddressNotAvailable"\x2C\n  title: "`Astro.clientAddress` is not available in prerendered pages."\x2C\n  message: "`Astro.clientAddress` is only available on pages that are server-rendered."\x2C\n  hint: "See https://docs.astro.build/en/guides/on-demand-rendering/ for more information on how to enable SSR."\n};\nconst NoMatchingStaticPathFound = {\n  name: "NoMatchingStaticPathFound"\x2C\n  title: "No static path found for requested path."\x2C\n  message: (pathName) => `A \\`getStaticPaths()\\` route pattern was matched\x2C but no matching static path was found for requested path \\`${pathName}\\`.`\x2C\n  hint: (possibleRoutes) => `Possible dynamic routes being matched: ${possibleRoutes.join("\x2C ")}.`\n};\nconst OnlyResponseCanBeReturned = {\n  name: "OnlyResponseCanBeReturned"\x2C\n  title: "Invalid type returned by Astro page."\x2C\n  message: (route\x2C returnedValue) => `Route \\`${route ? route : ""}\\` returned a \\`${returnedValue}\\`. Only a [Response](https://developer.mozilla.org/en-US/docs/Web/API/Response) can be returned from Astro files.`\x2C\n  hint: "See https://docs.astro.build/en/guides/on-demand-rendering/#response for more information."\n};\nconst MissingMediaQueryDirective = {\n  name: "MissingMediaQueryDirective"\x2C\n  title: "Missing value for `client:media` directive."\x2C\n  message: 'Media query not provided for `client:media` directive. A media query similar to `client:media="(max-width: 600px)"` must be provided'\n};\nconst NoMatchingRenderer = {\n  name: "NoMatchingRenderer"\x2C\n  title: "No matching renderer found."\x2C\n  message: (componentName\x2C componentExtension\x2C plural\x2C validRenderersCount) => `Unable to render \\`${componentName}\\`.\n\n${validRenderersCount > 0 ? `There ${plural ? "are" : "is"} ${validRenderersCount} renderer${plural ? "s" : ""} configured in your \\`astro.config.mjs\\` file\x2C\nbut ${plural ? "none were" : "it was not"} able to server-side render \\`${componentName}\\`.` : `No valid renderer was found ${componentExtension ? `for the \\`.${componentExtension}\\` file extension.` : `for this file extension.`}`}`\x2C\n  hint: (probableRenderers) => `Did you mean to enable the ${probableRenderers} integration?\n\nSee https://docs.astro.build/en/guides/framework-components/ for more information on how to install and configure integrations.`\n};\nconst NoClientEntrypoint = {\n  name: "NoClientEntrypoint"\x2C\n  title: "No client entrypoint specified in renderer."\x2C\n  message: (componentName\x2C clientDirective\x2C rendererName) => `\\`${componentName}\\` component has a \\`client:${clientDirective}\\` directive\x2C but no client entrypoint was provided by \\`${rendererName}\\`.`\x2C\n  hint: "See https://docs.astro.build/en/reference/integrations-reference/#addrenderer-option for more information on how to configure your renderer."\n};\nconst NoClientOnlyHint = {\n  name: "NoClientOnlyHint"\x2C\n  title: "Missing hint on client:only directive."\x2C\n  message: (componentName) => `Unable to render \\`${componentName}\\`. When using the \\`client:only\\` hydration strategy\x2C Astro needs a hint to use the correct renderer.`\x2C\n  hint: (probableRenderers) => `Did you mean to pass \\`client:only="${probableRenderers}"\\`? See https://docs.astro.build/en/reference/directives-reference/#clientonly for more information on client:only`\n};\nconst InvalidGetStaticPathParam = {\n  name: "InvalidGetStaticPathParam"\x2C\n  title: "Invalid value returned by a `getStaticPaths` path."\x2C\n  message: (paramType) => `Invalid params given to \\`getStaticPaths\\` path. Expected an \\`object\\`\x2C got \\`${paramType}\\``\x2C\n  hint: "See https://docs.astro.build/en/reference/routing-reference/#getstaticpaths for more information on getStaticPaths."\n};\nconst InvalidGetStaticPathsEntry = {\n  name: "InvalidGetStaticPathsEntry"\x2C\n  title: "Invalid entry inside getStaticPath's return value"\x2C\n  message: (entryType) => `Invalid entry returned by getStaticPaths. Expected an object\x2C got \\`${entryType}\\``\x2C\n  hint: "If you're using a `.map` call\x2C you might be looking for `.flatMap()` instead. See https://docs.astro.build/en/reference/routing-reference/#getstaticpaths for more information on getStaticPaths."\n};\nconst InvalidGetStaticPathsReturn = {\n  name: "InvalidGetStaticPathsReturn"\x2C\n  title: "Invalid value returned by getStaticPaths."\x2C\n  message: (returnType) => `Invalid type returned by \\`getStaticPaths\\`. Expected an \\`array\\`\x2C got \\`${returnType}\\``\x2C\n  hint: "See https://docs.astro.build/en/reference/routing-reference/#getstaticpaths for more information on getStaticPaths."\n};\nconst GetStaticPathsExpectedParams = {\n  name: "GetStaticPathsExpectedParams"\x2C\n  title: "Missing params property on `getStaticPaths` route."\x2C\n  message: "Missing or empty required `params` property on `getStaticPaths` route."\x2C\n  hint: "See https://docs.astro.build/en/reference/routing-reference/#getstaticpaths for more information on getStaticPaths."\n};\nconst GetStaticPathsInvalidRouteParam = {\n  name: "GetStaticPathsInvalidRouteParam"\x2C\n  title: "Invalid route parameter returned by `getStaticPaths()`."\x2C\n  message: (key\x2C value\x2C valueType) => `Invalid \\`getStaticPaths()\\` route parameter for \\`${key}\\`. Expected a string or undefined\x2C received \\`${valueType}\\` (\\`${value}\\`)`\x2C\n  hint: "See https://docs.astro.build/en/reference/routing-reference/#getstaticpaths for more information on getStaticPaths."\n};\nconst GetStaticPathsRequired = {\n  name: "GetStaticPathsRequired"\x2C\n  title: "`getStaticPaths()` function required for dynamic routes."\x2C\n  message: "`getStaticPaths()` function is required for dynamic routes. Make sure that you `export` a `getStaticPaths` function from your dynamic route."\x2C\n  hint: `See https://docs.astro.build/en/guides/routing/#dynamic-routes for more information on dynamic routes.\n\n\x09If you meant for this route to be server-rendered\x2C set \\`export const prerender = false;\\` in the page.`\n};\nconst ReservedSlotName = {\n  name: "ReservedSlotName"\x2C\n  title: "Invalid slot name."\x2C\n  message: (slotName) => `Unable to create a slot named \\`${slotName}\\`. \\`${slotName}\\` is a reserved slot name. Please update the name of this slot.`\n};\nconst NoAdapterInstalled = {\n  name: "NoAdapterInstalled"\x2C\n  title: "Cannot use Server-side Rendering without an adapter."\x2C\n  message: `Cannot use server-rendered pages without an adapter. Please install and configure the appropriate server adapter for your final deployment.`\x2C\n  hint: "See https://docs.astro.build/en/guides/on-demand-rendering/ for more information."\n};\nconst AdapterSupportOutputMismatch = {\n  name: "AdapterSupportOutputMismatch"\x2C\n  title: "Adapter does not support server output."\x2C\n  message: (adapterName) => `The \\`${adapterName}\\` adapter is configured to output a static website\x2C but the project contains server-rendered pages. Please install and configure the appropriate server adapter for your final deployment.`\n};\nconst NoAdapterInstalledServerIslands = {\n  name: "NoAdapterInstalledServerIslands"\x2C\n  title: "Cannot use Server Islands without an adapter."\x2C\n  message: `Cannot use server islands without an adapter. Please install and configure the appropriate server adapter for your final deployment.`\x2C\n  hint: "See https://docs.astro.build/en/guides/on-demand-rendering/ for more information."\n};\nconst NoMatchingImport = {\n  name: "NoMatchingImport"\x2C\n  title: "No import found for component."\x2C\n  message: (componentName) => `Could not render \\`${componentName}\\`. No matching import has been found for \\`${componentName}\\`.`\x2C\n  hint: "Please make sure the component is properly imported."\n};\nconst InvalidPrerenderExport = {\n  name: "InvalidPrerenderExport"\x2C\n  title: "Invalid prerender export."\x2C\n  message(prefix\x2C suffix\x2C isHydridOutput) {\n    const defaultExpectedValue = isHydridOutput ? "false" : "true";\n    let msg = `A \\`prerender\\` export has been detected\x2C but its value cannot be statically analyzed.`;\n    if (prefix !== "const") msg += `\nExpected \\`const\\` declaration but got \\`${prefix}\\`.`;\n    if (suffix !== "true")\n      msg += `\nExpected \\`${defaultExpectedValue}\\` value but got \\`${suffix}\\`.`;\n    return msg;\n  }\x2C\n  hint: "Mutable values declared at runtime are not supported. Please make sure to use exactly `export const prerender = true`."\n};\nconst InvalidComponentArgs = {\n  name: "InvalidComponentArgs"\x2C\n  title: "Invalid component arguments."\x2C\n  message: (name) => `Invalid arguments passed to${name ? ` <${name}>` : ""} component.`\x2C\n  hint: "Astro components cannot be rendered directly via function call\x2C such as `Component()` or `{items.map(Component)}`."\n};\nconst PageNumberParamNotFound = {\n  name: "PageNumberParamNotFound"\x2C\n  title: "Page number param not found."\x2C\n  message: (paramName) => `[paginate()] page number param \\`${paramName}\\` not found in your filepath.`\x2C\n  hint: "Rename your file to `[page].astro` or `[...page].astro`."\n};\nconst ImageMissingAlt = {\n  name: "ImageMissingAlt"\x2C\n  title: 'Image missing required "alt" property.'\x2C\n  message: 'Image missing "alt" property. "alt" text is required to describe important images on the page.'\x2C\n  hint: 'Use an empty string ("") for decorative images.'\n};\nconst InvalidImageService = {\n  name: "InvalidImageService"\x2C\n  title: "Error while loading image service."\x2C\n  message: "There was an error loading the configured image service. Please see the stack trace for more information."\n};\nconst MissingImageDimension = {\n  name: "MissingImageDimension"\x2C\n  title: "Missing image dimensions"\x2C\n  message: (missingDimension\x2C imageURL) => `Missing ${missingDimension === "both" ? "width and height attributes" : `${missingDimension} attribute`} for ${imageURL}. When using remote images\x2C both dimensions are required in order to avoid CLS.`\x2C\n  hint: "If your image is inside your `src` folder\x2C you probably meant to import it instead. See [the Imports guide for more information](https://docs.astro.build/en/guides/imports/#other-assets). You can also use `inferSize={true}` for remote images to get the original dimensions."\n};\nconst FailedToFetchRemoteImageDimensions = {\n  name: "FailedToFetchRemoteImageDimensions"\x2C\n  title: "Failed to retrieve remote image dimensions"\x2C\n  message: (imageURL) => `Failed to get the dimensions for ${imageURL}.`\x2C\n  hint: "Verify your remote image URL is accurate\x2C and that you are not using `inferSize` with a file located in your `public/` folder."\n};\nconst RemoteImageNotAllowed = {\n  name: "RemoteImageNotAllowed"\x2C\n  title: "Remote image is not allowed"\x2C\n  message: (imageURL) => `Remote image ${imageURL} is not allowed by your image configuration.`\x2C\n  hint: "Update `image.domains` or `image.remotePatterns`\x2C or remove `inferSize` for this image."\n};\nconst UnsupportedImageFormat = {\n  name: "UnsupportedImageFormat"\x2C\n  title: "Unsupported image format"\x2C\n  message: (format\x2C imagePath\x2C supportedFormats) => `Received unsupported format \\`${format}\\` from \\`${imagePath}\\`. Currently only ${supportedFormats.join(\n    "\x2C "\n  )} are supported by our image services.`\x2C\n  hint: "Using an `img` tag directly instead of the `Image` component might be what you're looking for."\n};\nconst UnsupportedImageConversion = {\n  name: "UnsupportedImageConversion"\x2C\n  title: "Unsupported image conversion"\x2C\n  message: "Converting between vector (such as SVGs) and raster (such as PNGs and JPEGs) images is not currently supported."\n};\nconst CannotOptimizeSvg = {\n  name: "CannotOptimizeSvg"\x2C\n  title: "Cannot optimize SVG"\x2C\n  message: (path\x2C name) => `An error occurred while optimizing SVG file "${path}" with the "${name}" optimizer.`\x2C\n  hint: "Review the included error message provided for guidance."\n};\nconst PrerenderDynamicEndpointPathCollide = {\n  name: "PrerenderDynamicEndpointPathCollide"\x2C\n  title: "Prerendered dynamic endpoint has path collision."\x2C\n  message: (pathname) => `Could not render \\`${pathname}\\` with an \\`undefined\\` param as the generated path will collide during prerendering. Prevent passing \\`undefined\\` as \\`params\\` for the endpoint's \\`getStaticPaths()\\` function\x2C or add an additional extension to the endpoint's filename.`\x2C\n  hint: (filename) => `Rename \\`${filename}\\` to \\`${filename.replace(/\\.(?:js|ts)/\x2C (m) => `.json` + m)}\\``\n};\nconst PrerenderRouteConflict = {\n  name: "PrerenderRouteConflict"\x2C\n  title: "Prerendered route generates the same path as another route."\x2C\n  message: (winningRoute\x2C thisRoute\x2C pathname) => `Could not render \\`${pathname}\\` from route \\`${thisRoute}\\` as it conflicts with higher priority route \\`${winningRoute}\\`.`\x2C\n  hint: (winningRoute\x2C thisRoute) => `Ensure \\`${thisRoute}\\` and \\`${winningRoute}\\` don't generate the same static paths.`\n};\nconst ExpectedImage = {\n  name: "ExpectedImage"\x2C\n  title: "Expected src to be an image."\x2C\n  message: (src\x2C typeofOptions\x2C fullOptions) => `Expected \\`src\\` property for \\`getImage\\` or \\`<Image />\\` to be either an ESM imported image or a string with the path of a remote image. Received \\`${src}\\` (type: \\`${typeofOptions}\\`).\n\nFull serialized options received: \\`${fullOptions}\\`.`\x2C\n  hint: "This error can often happen because of a wrong path. Make sure the path to your image is correct. If you're passing an async function\x2C make sure to call and await it."\n};\nconst ExpectedImageOptions = {\n  name: "ExpectedImageOptions"\x2C\n  title: "Expected image options."\x2C\n  message: (options) => `Expected getImage() parameter to be an object. Received \\`${options}\\`.`\n};\nconst ExpectedNotESMImage = {\n  name: "ExpectedNotESMImage"\x2C\n  title: "Expected image options\x2C not an ESM-imported image."\x2C\n  message: "An ESM-imported image cannot be passed directly to `getImage()`. Instead\x2C pass an object with the image in the `src` property."\x2C\n  hint: "Try changing `getImage(myImage)` to `getImage({ src: myImage })`"\n};\nconst GetImageNotUsedOnServer = {\n  name: "GetImageNotUsedOnServer"\x2C\n  title: "`getImage()` must be used on the server."\x2C\n  message: "`getImage()` should only be used on the server. To use images on the client\x2C render the `src` from `getImage()` during the server render\x2C then pass it to the client for usage."\x2C\n  hint: "See https://docs.astro.build/en/reference/modules/astro-assets/#getimage for more information on getImage()."\n};\nconst IncompatibleDescriptorOptions = {\n  name: "IncompatibleDescriptorOptions"\x2C\n  title: "Cannot set both `densities` and `widths`"\x2C\n  message: "Only one of `densities` or `widths` can be specified. In most cases\x2C you'll probably want to use only `widths` if you require specific widths."\x2C\n  hint: "Those attributes are used to construct a `srcset` attribute\x2C which cannot have both `x` and `w` descriptors."\n};\nconst ImageNotFound = {\n  name: "ImageNotFound"\x2C\n  title: "Image not found."\x2C\n  message: (imagePath) => `Could not find requested image \\`${imagePath}\\`. Does it exist?`\x2C\n  hint: "This is often caused by a typo in the image path. Please make sure the file exists\x2C and is spelled correctly."\n};\nconst NoImageMetadata = {\n  name: "NoImageMetadata"\x2C\n  title: "Could not process image metadata."\x2C\n  message: (imagePath) => `Could not process image metadata${imagePath ? ` for \\`${imagePath}\\`` : ""}.`\x2C\n  hint: "This is often caused by a corrupted or malformed image. Re-exporting the image from your image editor may fix this issue."\n};\nconst CouldNotTransformImage = {\n  name: "CouldNotTransformImage"\x2C\n  title: "Could not transform image."\x2C\n  message: (imagePath) => `Could not transform image \\`${imagePath}\\`. See the stack trace for more information.`\x2C\n  hint: "This is often caused by a corrupted or malformed image. Re-exporting the image from your image editor may fix this issue."\n};\nconst ResponseSentError = {\n  name: "ResponseSentError"\x2C\n  title: "Unable to set response."\x2C\n  message: "The response has already been sent to the browser and cannot be altered."\n};\nconst MiddlewareNoDataOrNextCalled = {\n  name: "MiddlewareNoDataOrNextCalled"\x2C\n  title: "The middleware didn't return a `Response`."\x2C\n  message: "Make sure your middleware returns a `Response` object\x2C either directly or by returning the `Response` from calling the `next` function."\n};\nconst MiddlewareNotAResponse = {\n  name: "MiddlewareNotAResponse"\x2C\n  title: "The middleware returned something that is not a `Response` object."\x2C\n  message: "Any data returned from middleware must be a valid `Response` object."\n};\nconst EndpointDidNotReturnAResponse = {\n  name: "EndpointDidNotReturnAResponse"\x2C\n  title: "The endpoint did not return a `Response`."\x2C\n  message: "An endpoint must return either a `Response`\x2C or a `Promise` that resolves with a `Response`."\n};\nconst LocalsNotAnObject = {\n  name: "LocalsNotAnObject"\x2C\n  title: "Value assigned to `locals` is not accepted."\x2C\n  message: "`locals` can only be assigned to an object. Other values like numbers\x2C strings\x2C etc. are not accepted."\x2C\n  hint: "If you tried to remove some information from the `locals` object\x2C try to use `delete` or set the property to `undefined`."\n};\nconst LocalsReassigned = {\n  name: "LocalsReassigned"\x2C\n  title: "`locals` must not be reassigned."\x2C\n  message: "`locals` cannot be assigned directly."\x2C\n  hint: "Set a `locals` property instead."\n};\nconst AstroResponseHeadersReassigned = {\n  name: "AstroResponseHeadersReassigned"\x2C\n  title: "`Astro.response.headers` must not be reassigned."\x2C\n  message: "Individual headers can be added to and removed from `Astro.response.headers`\x2C but it must not be replaced with another instance of `Headers` altogether."\x2C\n  hint: "Consider using `Astro.response.headers.add()`\x2C and `Astro.response.headers.delete()`."\n};\nconst MiddlewareCantBeLoaded = {\n  name: "MiddlewareCantBeLoaded"\x2C\n  title: "Can't load the middleware."\x2C\n  message: "An unknown error was thrown while loading your middleware."\n};\nconst LocalImageUsedWrongly = {\n  name: "LocalImageUsedWrongly"\x2C\n  title: "Local images must be imported."\x2C\n  message: (imageFilePath) => `\\`Image\\`'s and \\`getImage\\`'s \\`src\\` parameter must be an imported image or an URL\x2C it cannot be a string filepath. Received \\`${imageFilePath}\\`.`\x2C\n  hint: "If you want to use an image from your `src` folder\x2C you need to either import it or if the image is coming from a content collection\x2C use the [image() schema helper](https://docs.astro.build/en/guides/images/#images-in-content-collections). See https://docs.astro.build/en/guides/images/#src-required for more information on the `src` property."\n};\nconst AstroGlobUsedOutside = {\n  name: "AstroGlobUsedOutside"\x2C\n  title: "Astro.glob() used outside of an Astro file."\x2C\n  message: (globStr) => `\\`Astro.glob(${globStr})\\` can only be used in \\`.astro\\` files. \\`import.meta.glob(${globStr})\\` can be used instead to achieve a similar result.`\x2C\n  hint: "See Vite's documentation on `import.meta.glob` for more information: https://vite.dev/guide/features.html#glob-import"\n};\nconst AstroGlobNoMatch = {\n  name: "AstroGlobNoMatch"\x2C\n  title: "Astro.glob() did not match any files."\x2C\n  message: (globStr) => `\\`Astro.glob(${globStr})\\` did not return any matching files.`\x2C\n  hint: "Check the pattern for typos."\n};\nconst RedirectWithNoLocation = {\n  name: "RedirectWithNoLocation"\x2C\n  title: "A redirect must be given a location with the `Location` header."\n};\nconst UnsupportedExternalRedirect = {\n  name: "UnsupportedExternalRedirect"\x2C\n  title: "Unsupported or malformed URL."\x2C\n  message: (from\x2C to) => `The destination URL in the external redirect from "${from}" to "${to}" is unsupported.`\x2C\n  hint: "An external redirect must start with http or https\x2C and must be a valid URL."\n};\nconst InvalidRedirectDestination = {\n  name: "InvalidRedirectDestination"\x2C\n  title: "Invalid redirect destination."\x2C\n  message: (from\x2C to) => `The redirect from "${from}" to "${to}" is invalid. The destination "${to}" does not match any existing route in your project.`\x2C\n  hint: 'If you are redirecting to a specific page of a dynamic route (e.g.\x2C "/posts/[slug]/1")\x2C this is not supported. The destination must be either a static path or a route pattern that matches an existing page (e.g.\x2C "/posts/[slug]/[page]").'\n};\nconst InvalidDynamicRoute = {\n  name: "InvalidDynamicRoute"\x2C\n  title: "Invalid dynamic route."\x2C\n  message: (route\x2C invalidParam\x2C received) => `The ${invalidParam} param for route ${route} is invalid. Received **${received}**.`\n};\nconst MissingSharp = {\n  name: "MissingSharp"\x2C\n  title: "Could not find Sharp."\x2C\n  message: "Could not find Sharp. Please install Sharp (`sharp`) manually into your project or migrate to another image service."\x2C\n  hint: "See Sharp's installation instructions for more information: https://sharp.pixelplumbing.com/install. If you are not relying on `astro:assets` to optimize\x2C transform\x2C or process any images\x2C you can configure a passthrough image service instead of installing Sharp. See https://docs.astro.build/en/reference/errors/missing-sharp for more information.\\n\\nSee https://docs.astro.build/en/guides/images/#default-image-service for more information on how to migrate to another image service."\n};\nconst UnknownViteError = {\n  name: "UnknownViteError"\x2C\n  title: "Unknown Vite Error."\n};\nconst FailedToLoadModuleSSR = {\n  name: "FailedToLoadModuleSSR"\x2C\n  title: "Could not import file."\x2C\n  message: (importName) => `Could not import \\`${importName}\\`.`\x2C\n  hint: "This is often caused by a typo in the import path. Please make sure the file exists."\n};\nconst InvalidGlob = {\n  name: "InvalidGlob"\x2C\n  title: "Invalid glob pattern."\x2C\n  message: (globPattern) => `Invalid glob pattern: \\`${globPattern}\\`. Glob patterns must start with './'\x2C '../' or '/'.`\x2C\n  hint: "See https://docs.astro.build/en/guides/imports/#glob-patterns for more information on supported glob patterns."\n};\nconst FailedToFindPageMapSSR = {\n  name: "FailedToFindPageMapSSR"\x2C\n  title: "Astro couldn't find the correct page to render"\x2C\n  message: "Astro couldn't find the correct page to render\x2C probably because it wasn't correctly mapped for SSR usage. This is an internal error. Please file an issue."\n};\nconst MissingLocale = {\n  name: "MissingLocaleError"\x2C\n  title: "The provided locale does not exist."\x2C\n  message: (locale) => `The locale/path \\`${locale}\\` does not exist in the configured \\`i18n.locales\\`.`\n};\nconst MissingIndexForInternationalization = {\n  name: "MissingIndexForInternationalizationError"\x2C\n  title: "Index page not found."\x2C\n  message: (defaultLocale) => `Could not find index page. A root index page is required in order to create a redirect to the index URL of the default locale. (\\`/${defaultLocale}\\`)`\x2C\n  hint: (src) => `Create an index page (\\`index.astro\x2C index.md\x2C etc.\\`) in \\`${src}\\`.`\n};\nconst IncorrectStrategyForI18n = {\n  name: "IncorrectStrategyForI18n"\x2C\n  title: "You can't use the current function with the current strategy"\x2C\n  message: (functionName) => `The function \\`${functionName}\\` can only be used when the \\`i18n.routing.strategy\\` is set to \\`"manual"\\`.`\n};\nconst NoPrerenderedRoutesWithDomains = {\n  name: "NoPrerenderedRoutesWithDomains"\x2C\n  title: "Prerendered routes aren't supported when internationalization domains are enabled."\x2C\n  message: (component) => `Static pages aren't yet supported with multiple domains. To enable this feature\x2C you must disable prerendering for the page ${component}`\n};\nconst MissingMiddlewareForInternationalization = {\n  name: "MissingMiddlewareForInternationalization"\x2C\n  title: "Enabled manual internationalization routing without having a middleware."\x2C\n  message: "Your configuration setting `i18n.routing: 'manual'` requires you to provide your own i18n `middleware` file."\n};\nconst InvalidI18nMiddlewareConfiguration = {\n  name: "InvalidI18nMiddlewareConfiguration"\x2C\n  title: "Invalid internationalization middleware configuration"\x2C\n  message: "The option `redirectToDefaultLocale` can be enabled only when `prefixDefaultLocale` is also set to `true`; otherwise\x2C redirects might cause infinite loops. Enable the option `prefixDefaultLocale` to continue to use `redirectToDefaultLocale`\x2C or ensure both are set to `false`."\n};\nconst CantRenderPage = {\n  name: "CantRenderPage"\x2C\n  title: "Astro can't render the route."\x2C\n  message: "Astro cannot find any content to render for this route. There is no file or redirect associated with this route."\x2C\n  hint: "If you expect to find a route here\x2C this may be an Astro bug. Please file an issue/restart the dev server"\n};\nconst UnhandledRejection = {\n  name: "UnhandledRejection"\x2C\n  title: "Unhandled rejection"\x2C\n  message: (stack) => `Astro detected an unhandled rejection. Here's the stack trace:\n${stack}`\x2C\n  hint: "Make sure your promises all have an `await` or a `.catch()` handler."\n};\nconst i18nNotEnabled = {\n  name: "i18nNotEnabled"\x2C\n  title: "i18n Not Enabled"\x2C\n  message: "The `astro:i18n` module cannot be used without enabling i18n in your Astro config."\x2C\n  hint: "See https://docs.astro.build/en/guides/internationalization for a guide on setting up i18n."\n};\nconst i18nNoLocaleFoundInPath = {\n  name: "i18nNoLocaleFoundInPath"\x2C\n  title: "The path doesn't contain any locale"\x2C\n  message: "You tried to use an i18n utility on a path that doesn't contain any locale. You can use `pathHasLocale` first to determine if the path has a locale."\n};\nconst RouteNotFound = {\n  name: "RouteNotFound"\x2C\n  title: "Route not found."\x2C\n  message: `Astro could not find a route that matches the one you requested.`\n};\nconst EnvInvalidVariables = {\n  name: "EnvInvalidVariables"\x2C\n  title: "Invalid Environment Variables"\x2C\n  message: (errors) => `The following environment variables defined in \\`env.schema\\` are invalid:\n\n${errors.map((err) => `- ${err}`).join("\\n")}\n`\n};\nconst EnvPrefixConflictsWithSecret = {\n  name: "EnvPrefixConflictsWithSecret"\x2C\n  title: "envPrefix conflicts with secret environment variables"\x2C\n  message: (conflicts) => `The following environment variables are declared with \\`access: "secret"\\` in \\`env.schema\\`\x2C but their names match a prefix in \\`vite.envPrefix\\`\x2C which would expose them in client-side bundles:\n\n${conflicts.map((c) => `- ${c}`).join("\\n")}\n\nEither remove the conflicting prefixes from \\`vite.envPrefix\\`\x2C or rename these variables to use a prefix not in \\`vite.envPrefix\\`.`\n};\nconst ServerOnlyModule = {\n  name: "ServerOnlyModule"\x2C\n  title: "Module is only available server-side"\x2C\n  message: (name) => `The "${name}" module is only available server-side.`\n};\nconst RewriteWithBodyUsed = {\n  name: "RewriteWithBodyUsed"\x2C\n  title: "Cannot use Astro.rewrite after the request body has been read"\x2C\n  message: "Astro.rewrite() cannot be used if the request body has already been read. If you need to read the body\x2C first clone the request."\n};\nconst ForbiddenRewrite = {\n  name: "ForbiddenRewrite"\x2C\n  title: "Forbidden rewrite to a static route."\x2C\n  message: (from\x2C to\x2C component) => `You tried to rewrite the on-demand route '${from}' with the static route '${to}'\x2C when using the 'server' output. \n\nThe static route '${to}' is rendered by the component\n'${component}'\x2C which is marked as prerendered. This is a forbidden operation because during the build\x2C the component '${component}' is compiled to an\nHTML file\x2C which can't be retrieved at runtime by Astro.`\x2C\n  hint: (component) => `Add \\`export const prerender = false\\` to the component '${component}'\x2C or use a Astro.redirect().`\n};\nconst UnknownFilesystemError = {\n  name: "UnknownFilesystemError"\x2C\n  title: "An unknown error occurred while reading or writing files to disk."\x2C\n  hint: "It can be caused by many things\x2C eg. missing permissions or a file not existing we attempt to read. Check the error cause for more details."\n};\nconst CannotExtractFontType = {\n  name: "CannotExtractFontType"\x2C\n  title: "Cannot extract the font type from the given URL."\x2C\n  message: (url) => `An error occurred while trying to extract the font type from ${url}`\x2C\n  hint: "Open an issue at https://github.com/withastro/astro/issues."\n};\nconst CannotDetermineWeightAndStyleFromFontFile = {\n  name: "CannotDetermineWeightAndStyleFromFontFile"\x2C\n  title: "Cannot determine weight and style from font file."\x2C\n  message: (family\x2C url) => `An error occurred while determining the \\`weight\\` and \\`style\\` from local family "${family}" font file: ${url}`\x2C\n  hint: "Update your family config and set `weight` and `style` manually instead."\n};\nconst CannotFetchFontFile = {\n  name: "CannotFetchFontFile"\x2C\n  title: "Cannot fetch the given font file."\x2C\n  message: (url) => `An error occurred while fetching the font file from ${url}`\x2C\n  hint: "This is often caused by connectivity issues. If the error persists\x2C open an issue at https://github.com/withastro/astro/issues."\n};\nconst FontFamilyNotFound = {\n  name: "FontFamilyNotFound"\x2C\n  title: "Font family not found"\x2C\n  message: (family) => `No data was found for the \\`"${family}"\\` family passed to the \\`<Font>\\` component.`\x2C\n  hint: "This is often caused by a typo. Check that the `<Font />` component is using a `cssVariable` specified in your config."\n};\nconst FontFileUrlNotFound = {\n  name: "FontFileUrlNotFound"\x2C\n  title: "Font file URL not found"\x2C\n  message: (url) => `The \\`"${url}"\\` URL passed to the \\`experimental_getFontFileURL()\\` function is invalid.`\x2C\n  hint: "Make sure you pass a valid URL\x2C obtained via the `fontData` object."\n};\nconst MissingGetFontFileRequestUrl = {\n  name: "MissingGetFontFileRequestUrl"\x2C\n  title: "`experimental_getFontFileURL()` requires the request URL with on-demand rendering."\x2C\n  hint: "Pass the request URL as the 2nd argument\x2C for example `Astro.url`."\n};\nconst UnavailableAstroGlobal = {\n  name: "UnavailableAstroGlobal"\x2C\n  title: "Unavailable Astro global in getStaticPaths()"\x2C\n  message: (name) => `The Astro global is not available in this scope. Please remove "Astro.${name}" from your getStaticPaths() function.`\n};\nconst UnableToLoadLogger = {\n  name: "UnableToLoadLogger"\x2C\n  title: "Unable to load the logger."\x2C\n  message: (path) => `Couldn't load the logger at given path "${path}".`\n};\nconst LoggerConfigurationNotSerializable = {\n  name: "LoggerConfigurationNotSerializable"\x2C\n  title: "The configuration of the logger is not serializable"\n};\nconst UnknownCSSError = {\n  name: "UnknownCSSError"\x2C\n  title: "Unknown CSS Error."\n};\nconst CSSSyntaxError = {\n  name: "CSSSyntaxError"\x2C\n  title: "CSS Syntax Error."\n};\nconst UnknownMarkdownError = {\n  name: "UnknownMarkdownError"\x2C\n  title: "Unknown Markdown Error."\n};\nconst MarkdownFrontmatterParseError = {\n  name: "MarkdownFrontmatterParseError"\x2C\n  title: "Failed to parse Markdown frontmatter."\n};\nconst InvalidFrontmatterInjectionError = {\n  name: "InvalidFrontmatterInjectionError"\x2C\n  title: "Invalid frontmatter injection."\x2C\n  message: 'A remark or rehype plugin attempted to inject invalid frontmatter. Ensure "astro.frontmatter" is set to a valid JSON object that is not `null` or `undefined`.'\x2C\n  hint: "See the frontmatter injection docs https://docs.astro.build/en/guides/markdown-content/#modifying-frontmatter-programmatically for more information."\n};\nconst MdxIntegrationMissingError = {\n  name: "MdxIntegrationMissingError"\x2C\n  title: "MDX integration missing."\x2C\n  message: (file) => `Unable to render ${file}. Ensure that the \\`@astrojs/mdx\\` integration is installed.`\x2C\n  hint: "See the MDX integration docs for installation and usage instructions: https://docs.astro.build/en/guides/integrations-guide/mdx/"\n};\nconst UnknownConfigError = {\n  name: "UnknownConfigError"\x2C\n  title: "Unknown configuration error."\n};\nconst ConfigNotFound = {\n  name: "ConfigNotFound"\x2C\n  title: "Specified configuration file not found."\x2C\n  message: (configFile) => `Unable to resolve \\`--config "${configFile}"\\`. Does the file exist?`\n};\nconst ConfigLegacyKey = {\n  name: "ConfigLegacyKey"\x2C\n  title: "Legacy configuration detected."\x2C\n  message: (legacyConfigKey) => `Legacy configuration detected: \\`${legacyConfigKey}\\`.`\x2C\n  hint: "Please update your configuration to the new format.\\nSee https://astro.build/config for more information."\n};\nconst UnknownCLIError = {\n  name: "UnknownCLIError"\x2C\n  title: "Unknown CLI Error."\n};\nconst GenerateContentTypesError = {\n  name: "GenerateContentTypesError"\x2C\n  title: "Failed to generate content types."\x2C\n  message: (errorMessage) => `\\`astro sync\\` command failed to generate content collection types: ${errorMessage}`\x2C\n  hint: (fileName) => `This error is often caused by a syntax error inside your content\x2C or your content configuration file. Check your ${fileName ?? "content config"} file for typos.`\n};\nconst UnknownContentCollectionError = {\n  name: "UnknownContentCollectionError"\x2C\n  title: "Unknown Content Collection Error."\n};\nconst RenderUndefinedEntryError = {\n  name: "RenderUndefinedEntryError"\x2C\n  title: "Attempted to render an undefined content collection entry."\x2C\n  hint: "Check if the entry is undefined before passing it to `render()`"\n};\nconst GetEntryDeprecationError = {\n  name: "GetEntryDeprecationError"\x2C\n  title: "Invalid use of `getDataEntryById` or `getEntryBySlug` function."\x2C\n  message: (collection\x2C method) => `The \\`${method}\\` function is deprecated and cannot be used to query the "${collection}" collection. Use \\`getEntry\\` instead.`\x2C\n  hint: "See https://docs.astro.build/en/guides/upgrade-to/v6/#removed-legacy-content-collections for more information."\n};\nconst InvalidContentEntryFrontmatterError = {\n  name: "InvalidContentEntryFrontmatterError"\x2C\n  title: "Content entry frontmatter does not match schema."\x2C\n  message(collection\x2C entryId\x2C error) {\n    return [\n      `**${String(collection)} \\u2192 ${String(\n        entryId\n      )}** frontmatter does not match collection schema.`\x2C\n      ...error.issues.map((issue) => `  **${issue.path.join(".")}**: ${issue.message}`)\n    ].join("\\n");\n  }\x2C\n  hint: "See https://docs.astro.build/en/guides/content-collections/ for more information on content schemas."\n};\nconst InvalidContentEntryDataError = {\n  name: "InvalidContentEntryDataError"\x2C\n  title: "Content entry data does not match schema."\x2C\n  message(collection\x2C entryId\x2C error) {\n    return [\n      `**${String(collection)} \\u2192 ${String(entryId)}** data does not match collection schema.\n`\x2C\n      ...error.issues.map((issue) => `  **${issue.path.join(".")}**: ${issue.message}`)\x2C\n      ""\n    ].join("\\n");\n  }\x2C\n  hint: "See https://docs.astro.build/en/guides/content-collections/ for more information on content schemas."\n};\nconst LegacyContentConfigError = {\n  name: "LegacyContentConfigError"\x2C\n  title: "Legacy content config file found."\x2C\n  message: (filename) => `Found legacy content config file in "${filename}". Please move this file to "src/content.config.${filename.split(".").at(-1)}" and ensure each collection has a loader defined.`\x2C\n  hint: "See https://docs.astro.build/en/guides/upgrade-to/v6/#removed-legacy-content-collections for more information on updating collections."\n};\nconst ContentCollectionMissingLoader = {\n  name: "ContentCollectionMissingLoader"\x2C\n  title: "Content collection is missing a `loader` definition."\x2C\n  message: (file = "your content config file") => `Collections must have a \\`loader\\` defined. Check your collection definitions in ${file}.`\x2C\n  hint: "See https://docs.astro.build/en/guides/content-collections/ for more information on content loaders and https://docs.astro.build/en/guides/upgrade-to/v6/#removed-legacy-content-collections for more information on migrating from legacy collections."\n};\nconst ContentCollectionInvalidType = {\n  name: "ContentCollectionInvalidType"\x2C\n  title: "Content collection has an invalid `type` field."\x2C\n  message: (type\x2C file = "your content config file") => `Invalid collection type "${type}". Remove the type from your collection definition in ${file}.`\x2C\n  hint: "See https://docs.astro.build/en/guides/upgrade-to/v6/#removed-legacy-content-collections for more information on migrating from legacy collections."\n};\nconst ContentLoaderReturnsInvalidId = {\n  name: "ContentLoaderReturnsInvalidId"\x2C\n  title: "Content loader returned an entry with an invalid `id`."\x2C\n  message(collection\x2C entry) {\n    return [\n      `The content loader for the collection **${String(collection)}** returned an entry with an invalid \\`id\\`:`\x2C\n      JSON.stringify(entry\x2C null\x2C 2)\n    ].join("\\n");\n  }\x2C\n  hint: "Make sure that the `id` of the entry is a string. See https://docs.astro.build/en/guides/content-collections/ for more information on content loaders."\n};\nconst ContentEntryDataError = {\n  name: "ContentEntryDataError"\x2C\n  title: "Content entry data does not match schema."\x2C\n  message(collection\x2C entryId\x2C error) {\n    return [\n      `**${String(collection)} \\u2192 ${String(entryId)}** data does not match collection schema.\n`\x2C\n      ...error.issues.map((issue) => `  **${issue.path.join(".")}**: ${issue.message}`)\x2C\n      ""\n    ].join("\\n");\n  }\x2C\n  hint: "See https://docs.astro.build/en/guides/content-collections/ for more information on content schemas."\n};\nconst LiveContentConfigError = {\n  name: "LiveContentConfigError"\x2C\n  title: "Error in live content config."\x2C\n  message: (error\x2C filename) => `${error} Check your collection definitions in ${filename ?? "your live content config file"}.`\x2C\n  hint: "See https://docs.astro.build/en/reference/modules/astro-content/#definelivecollection for more information on defining live content collections."\n};\nconst ContentLoaderInvalidDataError = {\n  name: "ContentLoaderInvalidDataError"\x2C\n  title: "Content entry is missing an ID"\x2C\n  message(collection\x2C extra) {\n    return `**${String(collection)}** entry is missing an ID.\n${extra}`;\n  }\x2C\n  hint: "See https://docs.astro.build/en/guides/content-collections/ for more information on content loaders."\n};\nconst InvalidContentEntrySlugError = {\n  name: "InvalidContentEntrySlugError"\x2C\n  title: "Invalid content entry slug."\x2C\n  message(collection\x2C entryId) {\n    return `${String(collection)} \\u2192 ${String(\n      entryId\n    )} has an invalid slug. \\`slug\\` must be a string.`;\n  }\x2C\n  hint: "See https://docs.astro.build/en/guides/content-collections/ for more on the `slug` field."\n};\nconst ContentSchemaContainsSlugError = {\n  name: "ContentSchemaContainsSlugError"\x2C\n  title: "Content Schema should not contain `slug`."\x2C\n  message: (collectionName) => `A content collection schema should not contain \\`slug\\` since it is reserved for slug generation. Remove this from your ${collectionName} collection schema.`\x2C\n  hint: "See https://docs.astro.build/en/guides/content-collections/ for more on the `slug` field."\n};\nconst MixedContentDataCollectionError = {\n  name: "MixedContentDataCollectionError"\x2C\n  title: "Content and data cannot be in same collection."\x2C\n  message: (collectionName) => `**${collectionName}** contains a mix of content and data entries. All entries must be of the same type.`\x2C\n  hint: "Store data entries in a new collection separate from your content collection."\n};\nconst ContentCollectionTypeMismatchError = {\n  name: "ContentCollectionTypeMismatchError"\x2C\n  title: "Collection contains entries of a different type."\x2C\n  message: (collection\x2C expectedType\x2C actualType) => `${collection} contains ${expectedType} entries\x2C but is configured as a ${actualType} collection.`\n};\nconst DataCollectionEntryParseError = {\n  name: "DataCollectionEntryParseError"\x2C\n  title: "Data collection entry failed to parse."\x2C\n  message(entryId\x2C errorMessage) {\n    return `**${entryId}** failed to parse: ${errorMessage}`;\n  }\x2C\n  hint: "Ensure your data entry is an object with valid JSON (for `.json` entries)\x2C YAML (for `.yaml` entries) or TOML (for `.toml` entries)."\n};\nconst DuplicateContentEntrySlugError = {\n  name: "DuplicateContentEntrySlugError"\x2C\n  title: "Duplicate content entry slug."\x2C\n  message(collection\x2C slug\x2C preExisting\x2C alsoFound) {\n    return `**${collection}** contains multiple entries with the same slug: \\`${slug}\\`. Slugs must be unique.\n\nEntries: \n- ${preExisting}\n- ${alsoFound}`;\n  }\n};\nconst UnsupportedConfigTransformError = {\n  name: "UnsupportedConfigTransformError"\x2C\n  title: "Unsupported transform in content config."\x2C\n  message: (parseError) => `\\`transform()\\` functions in your content config must return valid JSON\x2C or data types compatible with the devalue library (including Dates\x2C Maps\x2C and Sets).\nFull error: ${parseError}`\x2C\n  hint: "See the devalue library for all supported types: https://github.com/rich-harris/devalue"\n};\nconst FileParserNotFound = {\n  name: "FileParserNotFound"\x2C\n  title: "File parser not found"\x2C\n  message: (fileName) => `No parser was found for '${fileName}'. Pass a parser function (e.g. \\`parser: csv\\`) to the \\`file\\` loader.`\n};\nconst FileGlobNotSupported = {\n  name: "FileGlobNotSupported"\x2C\n  title: "Glob patterns are not supported in the file loader"\x2C\n  message: "Glob patterns are not supported in the `file` loader. Use the `glob` loader instead."\x2C\n  hint: `See Astro's file loader https://docs.astro.build/en/reference/content-loader-reference/#file-loader for supported usage.`\n};\nconst ActionsWithoutServerOutputError = {\n  name: "ActionsWithoutServerOutputError"\x2C\n  title: "Actions must be used with server output."\x2C\n  message: "A server is required to create callable backend functions. To deploy routes to a server\x2C add an adapter to your Astro config and configure your route for on-demand rendering"\x2C\n  hint: "Add an adapter and enable on-demand rendering: https://docs.astro.build/en/guides/on-demand-rendering/"\n};\nconst ActionsReturnedInvalidDataError = {\n  name: "ActionsReturnedInvalidDataError"\x2C\n  title: "Action handler returned invalid data."\x2C\n  message: (error) => `Action handler returned invalid data. Handlers should return serializable data types like objects\x2C arrays\x2C strings\x2C and numbers. Parse error: ${error}`\x2C\n  hint: "See the devalue library for all supported types: https://github.com/rich-harris/devalue"\n};\nconst ActionNotFoundError = {\n  name: "ActionNotFoundError"\x2C\n  title: "Action not found."\x2C\n  message: (actionName) => `The server received a request for an action named \\`${actionName}\\` but could not find a match. If you renamed an action\x2C check that you've updated your \\`actions/index\\` file and your calling code to match.`\x2C\n  hint: "You can run `astro check` to detect type errors caused by mismatched action names."\n};\nconst ActionCalledFromServerError = {\n  name: "ActionCalledFromServerError"\x2C\n  title: "Action unexpected called from the server."\x2C\n  message: "Action called from a server page or endpoint without using `Astro.callAction()`. This wrapper must be used to call actions from server code."\x2C\n  hint: "See the `Astro.callAction()` reference for usage examples: https://docs.astro.build/en/reference/api-reference/#callaction"\n};\nconst UnknownError = { name: "UnknownError"\x2C title: "Unknown Error." };\nconst ActionsCantBeLoaded = {\n  name: "ActionsCantBeLoaded"\x2C\n  title: "Can't load the Astro actions."\x2C\n  message: "An unknown error was thrown while loading the Astro actions file."\n};\nconst SessionStorageInitError = {\n  name: "SessionStorageInitError"\x2C\n  title: "Session storage could not be initialized."\x2C\n  message: (error\x2C driver) => `Error when initializing session storage${driver ? ` with driver \\`${driver}\\`` : ""}. \\`${error ?? ""}\\``\x2C\n  hint: "For more information\x2C see https://docs.astro.build/en/guides/sessions/"\n};\nconst SessionStorageSaveError = {\n  name: "SessionStorageSaveError"\x2C\n  title: "Session data could not be saved."\x2C\n  message: (error\x2C driver) => `Error when saving session data${driver ? ` with driver \\`${driver}\\`` : ""}. \\`${error ?? ""}\\``\x2C\n  hint: "For more information\x2C see https://docs.astro.build/en/guides/sessions/"\n};\nconst CacheProviderNotFound = {\n  name: "CacheProviderNotFound"\x2C\n  title: "Cache provider not found."\x2C\n  message: (provider) => `Could not resolve the cache provider \\`${provider}\\`. Make sure the package is installed.`\x2C\n  hint: "If your adapter provides a default cache provider\x2C you may not need to set one explicitly. Check your adapter's documentation."\n};\nconst CacheNotEnabled = {\n  name: "CacheNotEnabled"\x2C\n  title: "Cache is not enabled."\x2C\n  message: "`Astro.cache` is not available because the cache feature is not enabled. To use caching\x2C configure a cache provider in your Astro config under `experimental.cache`."\x2C\n  hint: 'Use an adapter that provides a default cache provider\x2C or set one explicitly: `experimental: { cache: { provider: "..." } }`. See https://docs.astro.build/en/reference/experimental-flags/route-caching/.'\n};\nconst CacheQueryConfigConflict = {\n  name: "CacheQueryConfigConflict"\x2C\n  title: "Conflicting cache query configuration."\x2C\n  message: "`query.include` and `query.exclude` cannot be used together. Use `include` to allowlist specific parameters\x2C or `exclude` to blocklist them."\x2C\n  hint: "When using `include`\x2C all parameters not in the list are automatically excluded\x2C making `exclude` redundant."\n};\nexport {\n  ActionCalledFromServerError\x2C\n  ActionNotFoundError\x2C\n  ActionsCantBeLoaded\x2C\n  ActionsReturnedInvalidDataError\x2C\n  ActionsWithoutServerOutputError\x2C\n  AdapterSupport