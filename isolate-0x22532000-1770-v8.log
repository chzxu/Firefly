script-source,592,file:///mnt/d/blog/Firefly/node_modules/mdast-util-gfm-autolink-literal/lib/index.js,/**\n * @import {RegExpMatchObject\x2C ReplaceFunction} from 'mdast-util-find-and-replace'\n * @import {CompileContext\x2C Extension as FromMarkdownExtension\x2C Handle as FromMarkdownHandle\x2C Transform as FromMarkdownTransform} from 'mdast-util-from-markdown'\n * @import {ConstructName\x2C Options as ToMarkdownExtension} from 'mdast-util-to-markdown'\n * @import {Link\x2C PhrasingContent} from 'mdast'\n */\n\nimport {ccount} from 'ccount'\nimport {ok as assert} from 'devlop'\nimport {unicodePunctuation\x2C unicodeWhitespace} from 'micromark-util-character'\nimport {findAndReplace} from 'mdast-util-find-and-replace'\n\n/** @type {ConstructName} */\nconst inConstruct = 'phrasing'\n/** @type {Array<ConstructName>} */\nconst notInConstruct = ['autolink'\x2C 'link'\x2C 'image'\x2C 'label']\n\n/**\n * Create an extension for `mdast-util-from-markdown` to enable GFM autolink\n * literals in markdown.\n *\n * @returns {FromMarkdownExtension}\n *   Extension for `mdast-util-to-markdown` to enable GFM autolink literals.\n */\nexport function gfmAutolinkLiteralFromMarkdown() {\n  return {\n    transforms: [transformGfmAutolinkLiterals]\x2C\n    enter: {\n      literalAutolink: enterLiteralAutolink\x2C\n      literalAutolinkEmail: enterLiteralAutolinkValue\x2C\n      literalAutolinkHttp: enterLiteralAutolinkValue\x2C\n      literalAutolinkWww: enterLiteralAutolinkValue\n    }\x2C\n    exit: {\n      literalAutolink: exitLiteralAutolink\x2C\n      literalAutolinkEmail: exitLiteralAutolinkEmail\x2C\n      literalAutolinkHttp: exitLiteralAutolinkHttp\x2C\n      literalAutolinkWww: exitLiteralAutolinkWww\n    }\n  }\n}\n\n/**\n * Create an extension for `mdast-util-to-markdown` to enable GFM autolink\n * literals in markdown.\n *\n * @returns {ToMarkdownExtension}\n *   Extension for `mdast-util-to-markdown` to enable GFM autolink literals.\n */\nexport function gfmAutolinkLiteralToMarkdown() {\n  return {\n    unsafe: [\n      {\n        character: '@'\x2C\n        before: '[+\\\\-.\\\\w]'\x2C\n        after: '[\\\\-.\\\\w]'\x2C\n        inConstruct\x2C\n        notInConstruct\n      }\x2C\n      {\n        character: '.'\x2C\n        before: '[Ww]'\x2C\n        after: '[\\\\-.\\\\w]'\x2C\n        inConstruct\x2C\n        notInConstruct\n      }\x2C\n      {\n        character: ':'\x2C\n        before: '[ps]'\x2C\n        after: '\\\\/'\x2C\n        inConstruct\x2C\n        notInConstruct\n      }\n    ]\n  }\n}\n\n/**\n * @this {CompileContext}\n * @type {FromMarkdownHandle}\n */\nfunction enterLiteralAutolink(token) {\n  this.enter({type: 'link'\x2C title: null\x2C url: ''\x2C children: []}\x2C token)\n}\n\n/**\n * @this {CompileContext}\n * @type {FromMarkdownHandle}\n */\nfunction enterLiteralAutolinkValue(token) {\n  this.config.enter.autolinkProtocol.call(this\x2C token)\n}\n\n/**\n * @this {CompileContext}\n * @type {FromMarkdownHandle}\n */\nfunction exitLiteralAutolinkHttp(token) {\n  this.config.exit.autolinkProtocol.call(this\x2C token)\n}\n\n/**\n * @this {CompileContext}\n * @type {FromMarkdownHandle}\n */\nfunction exitLiteralAutolinkWww(token) {\n  this.config.exit.data.call(this\x2C token)\n  const node = this.stack[this.stack.length - 1]\n  assert(node.type === 'link')\n  node.url = 'http://' + this.sliceSerialize(token)\n}\n\n/**\n * @this {CompileContext}\n * @type {FromMarkdownHandle}\n */\nfunction exitLiteralAutolinkEmail(token) {\n  this.config.exit.autolinkEmail.call(this\x2C token)\n}\n\n/**\n * @this {CompileContext}\n * @type {FromMarkdownHandle}\n */\nfunction exitLiteralAutolink(token) {\n  this.exit(token)\n}\n\n/** @type {FromMarkdownTransform} */\nfunction transformGfmAutolinkLiterals(tree) {\n  findAndReplace(\n    tree\x2C\n    [\n      [/(https?:\\/\\/|www(?=\\.))([-.\\w]+)([^ \\t\\r\\n]*)/gi\x2C findUrl]\x2C\n      [/(?<=^|\\s|\\p{P}|\\p{S})([-.\\w+]+)@([-\\w]+(?:\\.[-\\w]+)+)/gu\x2C findEmail]\n    ]\x2C\n    {ignore: ['link'\x2C 'linkReference']}\n  )\n}\n\n/**\n * @type {ReplaceFunction}\n * @param {string} _\n * @param {string} protocol\n * @param {string} domain\n * @param {string} path\n * @param {RegExpMatchObject} match\n * @returns {Array<PhrasingContent> | Link | false}\n */\n// eslint-disable-next-line max-params\nfunction findUrl(_\x2C protocol\x2C domain\x2C path\x2C match) {\n  let prefix = ''\n\n  // Not an expected previous character.\n  if (!previous(match)) {\n    return false\n  }\n\n  // Treat `www` as part of the domain.\n  if (/^w/i.test(protocol)) {\n    domain = protocol + domain\n    protocol = ''\n    prefix = 'http://'\n  }\n\n  if (!isCorrectDomain(domain)) {\n    return false\n  }\n\n  const parts = splitUrl(domain + path)\n\n  if (!parts[0]) return false\n\n  /** @type {Link} */\n  const result = {\n    type: 'link'\x2C\n    title: null\x2C\n    url: prefix + protocol + parts[0]\x2C\n    children: [{type: 'text'\x2C value: protocol + parts[0]}]\n  }\n\n  if (parts[1]) {\n    return [result\x2C {type: 'text'\x2C value: parts[1]}]\n  }\n\n  return result\n}\n\n/**\n * @type {ReplaceFunction}\n * @param {string} _\n * @param {string} atext\n * @param {string} label\n * @param {RegExpMatchObject} match\n * @returns {Link | false}\n */\nfunction findEmail(_\x2C atext\x2C label\x2C match) {\n  if (\n    // Not an expected previous character.\n    !previous(match\x2C true) ||\n    // Label ends in not allowed character.\n    /[-\\d_]$/.test(label)\n  ) {\n    return false\n  }\n\n  return {\n    type: 'link'\x2C\n    title: null\x2C\n    url: 'mailto:' + atext + '@' + label\x2C\n    children: [{type: 'text'\x2C value: atext + '@' + label}]\n  }\n}\n\n/**\n * @param {string} domain\n * @returns {boolean}\n */\nfunction isCorrectDomain(domain) {\n  const parts = domain.split('.')\n\n  if (\n    parts.length < 2 ||\n    (parts[parts.length - 1] &&\n      (/_/.test(parts[parts.length - 1]) ||\n        !/[a-zA-Z\\d]/.test(parts[parts.length - 1]))) ||\n    (parts[parts.length - 2] &&\n      (/_/.test(parts[parts.length - 2]) ||\n        !/[a-zA-Z\\d]/.test(parts[parts.length - 2])))\n  ) {\n    return false\n  }\n\n  return true\n}\n\n/**\n * @param {string} url\n * @returns {[string\x2C string | undefined]}\n */\nfunction splitUrl(url) {\n  const trailExec = /[!"&')\x2C.:;<>?\\]}]+$/.exec(url)\n\n  if (!trailExec) {\n    return [url\x2C undefined]\n  }\n\n  url = url.slice(0\x2C trailExec.index)\n\n  let trail = trailExec[0]\n  let closingParenIndex = trail.indexOf(')')\n  const openingParens = ccount(url\x2C '(')\n  let closingParens = ccount(url\x2C ')')\n\n  while (closingParenIndex !== -1 && openingParens > closingParens) {\n    url += trail.slice(0\x2C closingParenIndex + 1)\n    trail = trail.slice(closingParenIndex + 1)\n    closingParenIndex = trail.indexOf(')')\n    closingParens++\n  }\n\n  return [url\x2C trail]\n}\n\n/**\n * @param {RegExpMatchObject} match\n * @param {boolean | null | undefined} [email=false]\n * @returns {boolean}\n */\nfunction previous(match\x2C email) {\n  const code = match.input.charCodeAt(match.index - 1)\n\n  return (\n    (match.index === 0 ||\n      unicodeWhitespace(code) ||\n      unicodePunctuation(code)) &&\n    // If it\u2019s an email\x2C the previous character should not be a slash.\n    (!email || code !== 47)\n  )\n}\n
