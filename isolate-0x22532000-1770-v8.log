script-source,285,file:///mnt/d/blog/Firefly/node_modules/astro/dist/core/session/config.js,import * as z from "zod/v4";\nconst SessionDriverConfigSchema = z.object({\n  config: z.record(z.string()\x2C z.any()).optional()\x2C\n  entrypoint: z.union([z.string()\x2C z.instanceof(URL)])\n});\nconst SessionSchema = z.object({\n  driver: z.union([\n    z.string().superRefine(() => {\n      console.warn(\n        `Using deprecated \\`session.driver\\` string signature. Learn how to migrate: https://docs.astro.build/en/guides/upgrade-to/v6/#deprecated-session-driver-string-signature`\n      );\n    })\x2C\n    SessionDriverConfigSchema\n  ]).optional()\x2C\n  options: z.record(z.string()\x2C z.any()).optional()\x2C\n  cookie: z.union([\n    z.object({\n      name: z.string().optional()\x2C\n      domain: z.string().optional()\x2C\n      path: z.string().optional()\x2C\n      maxAge: z.number().optional()\x2C\n      sameSite: z.union([z.enum(["strict"\x2C "lax"\x2C "none"])\x2C z.boolean()]).optional()\x2C\n      secure: z.boolean().optional()\n    })\x2C\n    z.string().transform((name) => ({ name }))\n  ]).optional()\x2C\n  ttl: z.number().optional()\n});\nexport {\n  SessionDriverConfigSchema\x2C\n  SessionSchema\n};\n
