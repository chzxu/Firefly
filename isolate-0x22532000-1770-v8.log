script-source,145,file:///mnt/d/blog/Firefly/node_modules/astro/dist/cli/infra/logger-help-display.js,import { formatVersion } from "../utils/format-version.js";\nclass LoggerHelpDisplay {\n  #logger;\n  #textStyler;\n  #astroVersionProvider;\n  // TODO: find something better\n  #flags;\n  constructor({\n    logger\x2C\n    textStyler\x2C\n    astroVersionProvider\x2C\n    flags\n  }) {\n    this.#logger = logger;\n    this.#textStyler = textStyler;\n    this.#astroVersionProvider = astroVersionProvider;\n    this.#flags = flags;\n  }\n  shouldFire() {\n    return !!(this.#flags.help || this.#flags.h);\n  }\n  show({ commandName\x2C description\x2C headline\x2C tables\x2C usage }) {\n    const linebreak = () => "";\n    const title = (label) => `  ${this.#textStyler.bgWhite(this.#textStyler.black(` ${label} `))}`;\n    const table = (rows\x2C { padding }) => {\n      const split = process.stdout.columns < 60;\n      let raw = "";\n      for (const row of rows) {\n        if (split) {\n          raw += `    ${row[0]}\n    `;\n        } else {\n          raw += `${`${row[0]}`.padStart(padding)}`;\n        }\n        raw += "  " + this.#textStyler.dim(row[1]) + "\\n";\n      }\n      return raw.slice(0\x2C -1);\n    };\n    let message = [];\n    if (headline) {\n      message.push(\n        linebreak()\x2C\n        `${formatVersion({ name: commandName\x2C textStyler: this.#textStyler\x2C astroVersionProvider: this.#astroVersionProvider })} ${headline}`\n      );\n    }\n    if (usage) {\n      message.push(\n        linebreak()\x2C\n        `  ${this.#textStyler.green(commandName)} ${this.#textStyler.bold(usage)}`\n      );\n    }\n    if (tables) {\n      let calculateTablePadding2 = function(rows) {\n        return rows.reduce((val\x2C [first]) => Math.max(val\x2C first.length)\x2C 0) + 2;\n      };\n      var calculateTablePadding = calculateTablePadding2;\n      const tableEntries = Object.entries(tables);\n      const padding = Math.max(...tableEntries.map(([\x2C rows]) => calculateTablePadding2(rows)));\n      for (const [tableTitle\x2C tableRows] of tableEntries) {\n        message.push(linebreak()\x2C title(tableTitle)\x2C table(tableRows\x2C { padding }));\n      }\n    }\n    if (description) {\n      message.push(linebreak()\x2C `${description}`);\n    }\n    this.#logger.info("SKIP_FORMAT"\x2C message.join("\\n") + "\\n");\n  }\n}\nexport {\n  LoggerHelpDisplay\n};\n
