script-source,724,file:///mnt/d/blog/Firefly/node_modules/mdast-util-to-markdown/lib/handle/blockquote.js,/**\n * @import {Blockquote\x2C Parents} from 'mdast'\n * @import {Info\x2C Map\x2C State} from 'mdast-util-to-markdown'\n */\n\n/**\n * @param {Blockquote} node\n * @param {Parents | undefined} _\n * @param {State} state\n * @param {Info} info\n * @returns {string}\n */\nexport function blockquote(node\x2C _\x2C state\x2C info) {\n  const exit = state.enter('blockquote')\n  const tracker = state.createTracker(info)\n  tracker.move('> ')\n  tracker.shift(2)\n  const value = state.indentLines(\n    state.containerFlow(node\x2C tracker.current())\x2C\n    map\n  )\n  exit()\n  return value\n}\n\n/** @type {Map} */\nfunction map(line\x2C _\x2C blank) {\n  return '>' + (blank ? '' : ' ') + line\n}\n
