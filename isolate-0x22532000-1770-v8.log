script-source,418,file:///mnt/d/blog/Firefly/node_modules/mdast-util-to-hast/lib/handlers/inline-code.js,/**\n * @import {Element\x2C Text} from 'hast'\n * @import {InlineCode} from 'mdast'\n * @import {State} from '../state.js'\n */\n\n/**\n * Turn an mdast `inlineCode` node into hast.\n *\n * @param {State} state\n *   Info passed around.\n * @param {InlineCode} node\n *   mdast node.\n * @returns {Element}\n *   hast node.\n */\nexport function inlineCode(state\x2C node) {\n  /** @type {Text} */\n  const text = {type: 'text'\x2C value: node.value.replace(/\\r?\\n|\\r/g\x2C ' ')}\n  state.patch(node\x2C text)\n\n  /** @type {Element} */\n  const result = {\n    type: 'element'\x2C\n    tagName: 'code'\x2C\n    properties: {}\x2C\n    children: [text]\n  }\n  state.patch(node\x2C result)\n  return state.applyData(node\x2C result)\n}\n
