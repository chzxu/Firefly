script-source,275,file:///mnt/d/blog/Firefly/node_modules/astro/dist/core/config/schemas/relative.js,import path from "node:path";\nimport { fileURLToPath\x2C pathToFileURL } from "node:url";\nimport * as z from "zod/v4";\nimport { appendForwardSlash\x2C prependForwardSlash\x2C removeTrailingForwardSlash } from "../../path.js";\nimport { ASTRO_CONFIG_DEFAULTS\x2C AstroConfigSchema } from "./base.js";\nfunction resolveDirAsUrl(dir\x2C root) {\n  let resolvedDir = path.resolve(root\x2C dir);\n  if (!resolvedDir.endsWith(path.sep)) {\n    resolvedDir += path.sep;\n  }\n  return pathToFileURL(resolvedDir);\n}\nfunction createRelativeSchema(cmd\x2C fileProtocolRoot) {\n  let originalBuildClient;\n  let originalBuildServer;\n  const AstroConfigRelativeSchema = AstroConfigSchema.extend({\n    root: z.string().default(ASTRO_CONFIG_DEFAULTS.root).transform((val) => resolveDirAsUrl(val\x2C fileProtocolRoot))\x2C\n    srcDir: z.string().default(ASTRO_CONFIG_DEFAULTS.srcDir).transform((val) => resolveDirAsUrl(val\x2C fileProtocolRoot))\x2C\n    compressHTML: z.union([z.boolean()\x2C z.literal("jsx")]).optional().default(ASTRO_CONFIG_DEFAULTS.compressHTML)\x2C\n    publicDir: z.string().default(ASTRO_CONFIG_DEFAULTS.publicDir).transform((val) => resolveDirAsUrl(val\x2C fileProtocolRoot))\x2C\n    outDir: z.string().default(ASTRO_CONFIG_DEFAULTS.outDir).transform((val) => resolveDirAsUrl(val\x2C fileProtocolRoot))\x2C\n    cacheDir: z.string().default(ASTRO_CONFIG_DEFAULTS.cacheDir).transform((val) => resolveDirAsUrl(val\x2C fileProtocolRoot))\x2C\n    build: z.object({\n      format: z.union([z.literal("file")\x2C z.literal("directory")\x2C z.literal("preserve")]).optional().default(ASTRO_CONFIG_DEFAULTS.build.format)\x2C\n      // NOTE: `client` and `server` are transformed relative to the default outDir first\x2C\n      // later we'll fix this to be relative to the actual `outDir`\n      client: z.string().optional().default(ASTRO_CONFIG_DEFAULTS.build.client).transform((val) => {\n        originalBuildClient = val;\n        return resolveDirAsUrl(\n          val\x2C\n          path.resolve(fileProtocolRoot\x2C ASTRO_CONFIG_DEFAULTS.outDir)\n        );\n      })\x2C\n      server: z.string().optional().default(ASTRO_CONFIG_DEFAULTS.build.server).transform((val) => {\n        originalBuildServer = val;\n        return resolveDirAsUrl(\n          val\x2C\n          path.resolve(fileProtocolRoot\x2C ASTRO_CONFIG_DEFAULTS.outDir)\n        );\n      })\x2C\n      assets: z.string().optional().default(ASTRO_CONFIG_DEFAULTS.build.assets)\x2C\n      assetsPrefix: z.string().optional().or(z.object({ fallback: z.string() }).and(z.record(z.string()\x2C z.string())).optional())\x2C\n      serverEntry: z.string().optional().default(ASTRO_CONFIG_DEFAULTS.build.serverEntry)\x2C\n      redirects: z.boolean().optional().default(ASTRO_CONFIG_DEFAULTS.build.redirects)\x2C\n      inlineStylesheets: z.enum(["always"\x2C "auto"\x2C "never"]).optional().default(ASTRO_CONFIG_DEFAULTS.build.inlineStylesheets)\x2C\n      concurrency: z.number().min(1).optional().default(ASTRO_CONFIG_DEFAULTS.build.concurrency)\n    }).optional().prefault({})\x2C\n    server: z.preprocess(\n      // preprocess\n      (val) => {\n        if (typeof val === "function") {\n          return val({ command: cmd === "dev" ? "dev" : "preview" });\n        }\n        return val;\n      }\x2C\n      // validate\n      z.object({\n        open: z.union([z.string()\x2C z.boolean()]).optional().default(ASTRO_CONFIG_DEFAULTS.server.open)\x2C\n        host: z.union([z.string()\x2C z.boolean()]).optional().default(ASTRO_CONFIG_DEFAULTS.server.host)\x2C\n        port: z.number().optional().default(ASTRO_CONFIG_DEFAULTS.server.port)\x2C\n        headers: z.custom().optional()\x2C\n        allowedHosts: z.union([z.array(z.string())\x2C z.literal(true)]).optional().default(ASTRO_CONFIG_DEFAULTS.server.allowedHosts)\n      })\n    ).prefault({})\n  }).transform((config) => {\n    if (config.outDir.toString() !== resolveDirAsUrl(ASTRO_CONFIG_DEFAULTS.outDir\x2C fileProtocolRoot).toString()) {\n      const outDirPath = fileURLToPath(config.outDir);\n      config.build.client = resolveDirAsUrl(originalBuildClient\x2C outDirPath);\n      config.build.server = resolveDirAsUrl(originalBuildServer\x2C outDirPath);\n    }\n    if (config.trailingSlash === "never") {\n      config.base = prependForwardSlash(removeTrailingForwardSlash(config.base));\n      config.image.endpoint.route = prependForwardSlash(\n        removeTrailingForwardSlash(config.image.endpoint.route)\n      );\n    } else if (config.trailingSlash === "always") {\n      config.base = prependForwardSlash(appendForwardSlash(config.base));\n      config.image.endpoint.route = prependForwardSlash(\n        appendForwardSlash(config.image.endpoint.route)\n      );\n    } else {\n      config.base = prependForwardSlash(config.base);\n      config.image.endpoint.route = prependForwardSlash(config.image.endpoint.route);\n    }\n    return config;\n  });\n  return AstroConfigRelativeSchema;\n}\nexport {\n  createRelativeSchema\n};\n
