script-source,399,file:///mnt/d/blog/Firefly/node_modules/mdast-util-gfm/lib/index.js,/**\n * @import {Extension as FromMarkdownExtension} from 'mdast-util-from-markdown'\n * @import {Options} from 'mdast-util-gfm'\n * @import {Options as ToMarkdownExtension} from 'mdast-util-to-markdown'\n */\n\nimport {\n  gfmAutolinkLiteralFromMarkdown\x2C\n  gfmAutolinkLiteralToMarkdown\n} from 'mdast-util-gfm-autolink-literal'\nimport {\n  gfmFootnoteFromMarkdown\x2C\n  gfmFootnoteToMarkdown\n} from 'mdast-util-gfm-footnote'\nimport {\n  gfmStrikethroughFromMarkdown\x2C\n  gfmStrikethroughToMarkdown\n} from 'mdast-util-gfm-strikethrough'\nimport {gfmTableFromMarkdown\x2C gfmTableToMarkdown} from 'mdast-util-gfm-table'\nimport {\n  gfmTaskListItemFromMarkdown\x2C\n  gfmTaskListItemToMarkdown\n} from 'mdast-util-gfm-task-list-item'\n\n/**\n * Create an extension for `mdast-util-from-markdown` to enable GFM (autolink\n * literals\x2C footnotes\x2C strikethrough\x2C tables\x2C tasklists).\n *\n * @returns {Array<FromMarkdownExtension>}\n *   Extension for `mdast-util-from-markdown` to enable GFM (autolink literals\x2C\n *   footnotes\x2C strikethrough\x2C tables\x2C tasklists).\n */\nexport function gfmFromMarkdown() {\n  return [\n    gfmAutolinkLiteralFromMarkdown()\x2C\n    gfmFootnoteFromMarkdown()\x2C\n    gfmStrikethroughFromMarkdown()\x2C\n    gfmTableFromMarkdown()\x2C\n    gfmTaskListItemFromMarkdown()\n  ]\n}\n\n/**\n * Create an extension for `mdast-util-to-markdown` to enable GFM (autolink\n * literals\x2C footnotes\x2C strikethrough\x2C tables\x2C tasklists).\n *\n * @param {Options | null | undefined} [options]\n *   Configuration (optional).\n * @returns {ToMarkdownExtension}\n *   Extension for `mdast-util-to-markdown` to enable GFM (autolink literals\x2C\n *   footnotes\x2C strikethrough\x2C tables\x2C tasklists).\n */\nexport function gfmToMarkdown(options) {\n  return {\n    extensions: [\n      gfmAutolinkLiteralToMarkdown()\x2C\n      gfmFootnoteToMarkdown(options)\x2C\n      gfmStrikethroughToMarkdown()\x2C\n      gfmTableToMarkdown(options)\x2C\n      gfmTaskListItemToMarkdown()\n    ]\n  }\n}\n
