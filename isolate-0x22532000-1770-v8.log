(m) && m.length >= 2) {\n                    key = m[1];\n                    if (checkAllAliases(key\x2C flags.arrays)) {\n                        // array format = '--foo a b c'\n                        i = eatArray(i\x2C key\x2C args);\n                    }\n                    else if (checkAllAliases(key\x2C flags.nargs) !== false) {\n                        // nargs format = '--foo a b c'\n                        // should be truthy even if: flags.nargs[key] === 0\n                        i = eatNargs(i\x2C key\x2C args);\n                    }\n                    else {\n                        next = args[i + 1];\n                        if (next !== undefined && (!next.match(/^-/) ||\n                            next.match(negative)) &&\n                            !checkAllAliases(key\x2C flags.bools) &&\n                            !checkAllAliases(key\x2C flags.counts)) {\n                            setArg(key\x2C next);\n                            i++;\n                        }\n                        else if (/^(true|false)$/.test(next)) {\n                            setArg(key\x2C next);\n                            i++;\n                        }\n                        else {\n                            setArg(key\x2C defaultValue(key));\n                        }\n                    }\n                }\n                // dot-notation flag separated by '='.\n            }\n            else if (arg.match(/^-.\\..+=/)) {\n                m = arg.match(/^-([^=]+)=([\\s\\S]*)$/);\n                if (m !== null && Array.isArray(m) && m.length >= 3) {\n                    setArg(m[1]\x2C m[2]);\n                }\n                // dot-notation flag separated by space.\n            }\n            else if (arg.match(/^-.\\..+/) && !arg.match(negative)) {\n                next = args[i + 1];\n                m = arg.match(/^-(.\\..+)/);\n                if (m !== null && Array.isArray(m) && m.length >= 2) {\n                    key = m[1];\n                    if (next !== undefined && !next.match(/^-/) &&\n                        !checkAllAliases(key\x2C flags.bools) &&\n                        !checkAllAliases(key\x2C flags.counts)) {\n                        setArg(key\x2C next);\n                        i++;\n                    }\n                    else {\n                        setArg(key\x2C defaultValue(key));\n                    }\n                }\n            }\n            else if (arg.match(/^-[^-]+/) && !arg.match(negative)) {\n                letters = arg.slice(1\x2C -1).split('');\n                broken = false;\n                for (let j = 0; j < letters.length; j++) {\n                    next = arg.slice(j + 2);\n                    if (letters[j + 1] && letters[j + 1] === '=') {\n                        value = arg.slice(j + 3);\n                        key = letters[j];\n                        if (checkAllAliases(key\x2C flags.arrays)) {\n                            // array format = '-f=a b c'\n                            i = eatArray(i\x2C key\x2C args\x2C value);\n                        }\n                        else if (checkAllAliases(key\x2C flags.nargs) !== false) {\n                            // nargs format = '-f=monkey washing cat'\n                            i = eatNargs(i\x2C key\x2C args\x2C value);\n                        }\n                        else {\n                            setArg(key\x2C value);\n                        }\n                        broken = true;\n                        break;\n                    }\n                    if (next === '-') {\n                        setArg(letters[j]\x2C next);\n                        continue;\n                    }\n                    // current letter is an alphabetic character and next value is a number\n                    if (/[A-Za-z]/.test(letters[j]) &&\n                        /^-?\\d+(\\.\\d*)?(e-?\\d+)?$/.test(next) &&\n                        checkAllAliases(next\x2C flags.bools) ===