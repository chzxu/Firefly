script-source,467,file:///mnt/d/blog/Firefly/node_modules/zod/v4/core/api.js,import * as checks from "./checks.js";\nimport * as registries from "./registries.js";\nimport * as schemas from "./schemas.js";\nimport * as util from "./util.js";\n// @__NO_SIDE_EFFECTS__\nexport function _string(Class\x2C params) {\n    return new Class({\n        type: "string"\x2C\n        ...util.normalizeParams(params)\x2C\n    });\n}\n// @__NO_SIDE_EFFECTS__\nexport function _coercedString(Class\x2C params) {\n    return new Class({\n        type: "string"\x2C\n        coerce: true\x2C\n        ...util.normalizeParams(params)\x2C\n    });\n}\n// @__NO_SIDE_EFFECTS__\nexport function _email(Class\x2C params) {\n    return new Class({\n        type: "string"\x2C\n        format: "email"\x2C\n        check: "string_format"\x2C\n        abort: false\x2C\n        ...util.normalizeParams(params)\x2C\n    });\n}\n// @__NO_SIDE_EFFECTS__\nexport function _guid(Class\x2C params) {\n    return new Class({\n        type: "string"\x2C\n        format: "guid"\x2C\n        check: "string_format"\x2C\n        abort: false\x2C\n        ...util.normalizeParams(params)\x2C\n    });\n}\n// @__NO_SIDE_EFFECTS__\nexport function _uuid(Class\x2C params) {\n    return new Class({\n        type: "string"\x2C\n        format: "uuid"\x2C\n        check: "string_format"\x2C\n        abort: false\x2C\n        ...util.normalizeParams(params)\x2C\n    });\n}\n// @__NO_SIDE_EFFECTS__\nexport function _uuidv4(Class\x2C params) {\n    return new Class({\n        type: "string"\x2C\n        format: "uuid"\x2C\n        check: "string_format"\x2C\n        abort: false\x2C\n        version: "v4"\x2C\n        ...util.normalizeParams(params)\x2C\n    });\n}\n// @__NO_SIDE_EFFECTS__\nexport function _uuidv6(Class\x2C params) {\n    return new Class({\n        type: "string"\x2C\n        format: "uuid"\x2C\n        check: "string_format"\x2C\n        abort: false\x2C\n        version: "v6"\x2C\n        ...util.normalizeParams(params)\x2C\n    });\n}\n// @__NO_SIDE_EFFECTS__\nexport function _uuidv7(Class\x2C params) {\n    return new Class({\n        type: "string"\x2C\n        format: "uuid"\x2C\n        check: "string_format"\x2C\n        abort: false\x2C\n        version: "v7"\x2C\n        ...util.normalizeParams(params)\x2C\n    });\n}\n// @__NO_SIDE_EFFECTS__\nexport function _url(Class\x2C params) {\n    return new Class({\n        type: "string"\x2C\n        format: "url"\x2C\n        check: "string_format"\x2C\n        abort: false\x2C\n        ...util.normalizeParams(params)\x2C\n    });\n}\n// @__NO_SIDE_EFFECTS__\nexport function _emoji(Class\x2C params) {\n    return new Class({\n        type: "string"\x2C\n        format: "emoji"\x2C\n        check: "string_format"\x2C\n        abort: false\x2C\n        ...util.normalizeParams(params)\x2C\n    });\n}\n// @__NO_SIDE_EFFECTS__\nexport function _nanoid(Class\x2C params) {\n    return new Class({\n        type: "string"\x2C\n        format: "nanoid"\x2C\n        check: "string_format"\x2C\n        abort: false\x2C\n        ...util.normalizeParams(params)\x2C\n    });\n}\n// @__NO_SIDE_EFFECTS__\nexport function _cuid(Class\x2C params) {\n    return new Class({\n        type: "string"\x2C\n        format: "cuid"\x2C\n        check: "string_format"\x2C\n        abort: false\x2C\n        ...util.normalizeParams(params)\x2C\n    });\n}\n// @__NO_SIDE_EFFECTS__\nexport function _cuid2(Class\x2C params) {\n    return new Class({\n        type: "string"\x2C\n        format: "cuid2"\x2C\n        check: "string_format"\x2C\n        abort: false\x2C\n        ...util.normalizeParams(params)\x2C\n    });\n}\n// @__NO_SIDE_EFFECTS__\nexport function _ulid(Class\x2C params) {\n    return new Class({\n        type: "string"\x2C\n        format: "ulid"\x2C\n        check: "string_format"\x2C\n        abort: false\x2C\n        ...util.normalizeParams(params)\x2C\n    });\n}\n// @__NO_SIDE_EFFECTS__\nexport function _xid(Class\x2C params) {\n    return new Class({\n        type: "string"\x2C\n        format: "xid"\x2C\n        check: "string_format"\x2C\n        abort: false\x2C\n        ...util.normalizeParams(params)\x2C\n    });\n}\n// @__NO_SIDE_EFFECTS__\nexport function _ksuid(Class\x2C params) {\n    return new Class({\n        type: "string"\x2C\n        format: "ksuid"\x2C\n        check: "string_format"\x2C\n        abort: false\x2C\n        ...util.normalizeParams(params)\x2C\n    });\n}\n// @__NO_SIDE_EFFECTS__\nexport function _ipv4(Class\x2C params) {\n    return new Class({\n        type: "string"\x2C\n        format: "ipv4"\x2C\n        check: "string_format"\x2C\n        abort: false\x2C\n        ...util.normalizeParams(params)\x2C\n    });\n}\n// @__NO_SIDE_EFFECTS__\nexport function _ipv6(Class\x2C params) {\n    return new Class({\n        type: "string"\x2C\n        format: "ipv6"\x2C\n        check: "string_format"\x2C\n        abort: false\x2C\n        ...util.normalizeParams(params)\x2C\n    });\n}\n// @__NO_SIDE_EFFECTS__\nexport function _mac(Class\x2C params) {\n    return new Class({\n        type: "string"\x2C\n        format: "mac"\x2C\n        check: "string_format"\x2C\n        abort: false\x2C\n        ...util.normalizeParams(params)\x2C\n    });\n}\n// @__NO_SIDE_EFFECTS__\nexport function _cidrv4(Class\x2C params) {\n    return new Class({\n        type: "string"\x2C\n        format: "cidrv4"\x2C\n        check: "string_format"\x2C\n        abort: false\x2C\n        ...util.normalizeParams(params)\x2C\n    });\n}\n// @__NO_SIDE_EFFECTS__\nexport function _cidrv6(Class\x2C params) {\n    return new Class({\n        type: "string"\x2C\n        format: "cidrv6"\x2C\n        check: "string_format"\x2C\n        abort: false\x2C\n        ...util.normalizeParams(params)\x2C\n    });\n}\n// @__NO_SIDE_EFFECTS__\nexport function _base64(Class\x2C params) {\n    return new Class({\n        type: "string"\x2C\n        format: "base64"\x2C\n        check: "string_format"\x2C\n        abort: false\x2C\n        ...util.normalizeParams(params)\x2C\n    });\n}\n// @__NO_SIDE_EFFECTS__\nexport function _base64url(Class\x2C params) {\n    return new Class({\n        type: "string"\x2C\n        format: "base64url"\x2C\n        check: "string_format"\x2C\n        abort: false\x2C\n        ...util.normalizeParams(params)\x2C\n    });\n}\n// @__NO_SIDE_EFFECTS__\nexport function _e164(Class\x2C params) {\n    return new Class({\n        type: "string"\x2C\n        format: "e164"\x2C\n        check: "string_format"\x2C\n        abort: false\x2C\n        ...util.normalizeParams(params)\x2C\n    });\n}\n// @__NO_SIDE_EFFECTS__\nexport function _jwt(Class\x2C params) {\n    return new Class({\n        type: "string"\x2C\n        format: "jwt"\x2C\n        check: "string_format"\x2C\n        abort: false\x2C\n        ...util.normalizeParams(params)\x2C\n    });\n}\nexport const TimePrecision = {\n    Any: null\x2C\n    Minute: -1\x2C\n    Second: 0\x2C\n    Millisecond: 3\x2C\n    Microsecond: 6\x2C\n};\n// @__NO_SIDE_EFFECTS__\nexport function _isoDateTime(Class\x2C params) {\n    return new Class({\n        type: "string"\x2C\n        format: "datetime"\x2C\n        check: "string_format"\x2C\n        offset: false\x2C\n        local: false\x2C\n        precision: null\x2C\n        ...util.normalizeParams(params)\x2C\n    });\n}\n// @__NO_SIDE_EFFECTS__\nexport function _isoDate(Class\x2C params) {\n    return new Class({\n        type: "string"\x2C\n        format: "date"\x2C\n        check: "string_format"\x2C\n        ...util.normalizeParams(params)\x2C\n    });\n}\n// @__NO_SIDE_EFFECTS__\nexport function _isoTime(Class\x2C params) {\n    return new Class({\n        type: "string"\x2C\n        format: "time"\x2C\n        check: "string_format"\x2C\n        precision: null\x2C\n        ...util.normalizeParams(params)\x2C\n    });\n}\n// @__NO_SIDE_EFFECTS__\nexport function _isoDuration(Class\x2C params) {\n    return new Class({\n        type: "string"\x2C\n        format: "duration"\x2C\n        check: "string_format"\x2C\n        ...util.normalizeParams(params)\x2C\n    });\n}\n// @__NO_SIDE_EFFECTS__\nexport function _number(Class\x2C params) {\n    return new Class({\n        type: "number"\x2C\n        checks: []\x2C\n        ...util.normalizeParams(params)\x2C\n    });\n}\n// @__NO_SIDE_EFFECTS__\nexport function _coercedNumber(Class\x2C params) {\n    return new Class({\n        type: "number"\x2C\n        coerce: true\x2C\n        checks: []\x2C\n        ...util.normalizeParams(params)\x2C\n    });\n}\n// @__NO_SIDE_EFFECTS__\nexport function _int(Class\x2C params) {\n    return new Class({\n        type: "number"\x2C\n        check: "number_format"\x2C\n        abort: false\x2C\n        format: "safeint"\x2C\n        ...util.normalizeParams(params)\x2C\n    });\n}\n// @__NO_SIDE_EFFECTS__\nexport function _float32(Class\x2C params) {\n    return new Class({\n        type: "number"\x2C\n        check: "number_format"\x2C\n        abort: false\x2C\n        format: "float32"\x2C\n        ...util.normalizeParams(params)\x2C\n    });\n}\n// @__NO_SIDE_EFFECTS__\nexport function _float64(Class\x2C params) {\n    return new Class({\n        type: "number"\x2C\n        check: "number_format"\x2C\n        abort: false\x2C\n        format: "float64"\x2C\n        ...util.normalizeParams(params)\x2C\n    });\n}\n// @__NO_SIDE_EFFECTS__\nexport function _int32(Class\x2C params) {\n    return new Class({\n        type: "number"\x2C\n        check: "number_format"\x2C\n        abort: false\x2C\n        format: "int32"\x2C\n        ...util.normalizeParams(params)\x2C\n    });\n}\n// @__NO_SIDE_EFFECTS__\nexport function _uint32(Class\x2C params) {\n    return new Class({\n        type: "number"\x2C\n        check: "number_format"\x2C\n        abort: false\x2C\n        format: "uint32"\x2C\n        ...util.normalizeParams(params)\x2C\n    });\n}\n// @__NO_SIDE_EFFECTS__\nexport function _boolean(Class\x2C params) {\n    return new Class({\n        type: "boolean"\x2C\n        ...util.normalizeParams(params)\x2C\n    });\n}\n// @__NO_SIDE_EFFECTS__\nexport function _coercedBoolean(Class\x2C params) {\n    return new Class({\n        type: "boolean"\x2C\n        coerce: true\x2C\n        ...util.normalizeParams(params)\x2C\n    });\n}\n// @__NO_SIDE_EFFECTS__\nexport function _bigint(Class\x2C params) {\n    return new Class({\n        type: "bigint"\x2C\n        ...util.normalizeParams(params)\x2C\n    });\n}\n// @__NO_SIDE_EFFECTS__\nexport function _coercedBigint(Class\x2C params) {\n    return new Class({\n        type: "bigint"\x2C\n        coerce: true\x2C\n        ...util.normalizeParams(params)\x2C\n    });\n}\n// @__NO_SIDE_EFFECTS__\nexport function _int64(Class\x2C params) {\n    return new Class({\n        type: "bigint"\x2C\n        check: "bigint_format"\x2C\n        abort: false\x2C\n        format: "int64"\x2C\n        ...util.normalizeParams(params)\x2C\n    });\n}\n// @__NO_SIDE_EFFECTS__\nexport function _uint64(Class\x2C params) {\n    return new Class({\n        type: "bigint"\x2C\n        check: "bigint_format"\x2C\n        abort: false\x2C\n        format: "uint64"\x2C\n        ...util.normalizeParams(params)\x2C\n    });\n}\n// @__NO_SIDE_EFFECTS__\nexport function _symbol(Class\x2C params) {\n    return new Class({\n        type: "symbol"\x2C\n        ...util.normalizeParams(params)\x2C\n    });\n}\n// @__NO_SIDE_EFFECTS__\nexport function _undefined(Class\x2C params) {\n    return new Class({\n        type: "undefined"\x2C\n        ...util.normalizeParams(params)\x2C\n    });\n}\n// @__NO_SIDE_EFFECTS__\nexport function _null(Class\x2C params) {\n    return new Class({\n        type: "null"\x2C\n        ...util.normalizeParams(params)\x2C\n    });\n}\n// @__NO_SIDE_EFFECTS__\nexport function _any(Class) {\n    return new Class({\n        type: "any"\x2C\n    });\n}\n// @__NO_SIDE_EFFECTS__\nexport function _unknown(Class) {\n    return new Class({\n        type: "unknown"\x2C\n    });\n}\n// @__NO_SIDE_EFFECTS__\nexport function _never(Class\x2C params) {\n    return new Class({\n        type: "never"\x2C\n        ...util.normalizeParams(params)\x2C\n    });\n}\n// @__NO_SIDE_EFFECTS__\nexport function _void(Class\x2C params) {\n    return new Class({\n        type: "void"\x2C\n        ...util.normalizeParams(params)\x2C\n    });\n}\n// @__NO_SIDE_EFFECTS__\nexport function _date(Class\x2C params) {\n    return new Class({\n        type: "date"\x2C\n        ...util.normalizeParams(params)\x2C\n    });\n}\n// @__NO_SIDE_EFFECTS__\nexport function _coercedDate(Class\x2C params) {\n    return new Class({\n        type: "date"\x2C\n        coerce: true\x2C\n        ...util.normalizeParams(params)\x2C\n    });\n}\n// @__NO_SIDE_EFFECTS__\nexport function _nan(Class\x2C params) {\n    return new Class({\n        type: "nan"\x2C\n        ...util.normalizeParams(params)\x2C\n    });\n}\n// @__NO_SIDE_EFFECTS__\nexport function _lt(value\x2C params) {\n    return new checks.$ZodCheckLessThan({\n        check: "less_than"\x2C\n        ...util.normalizeParams(params)\x2C\n        value\x2C\n        inclusive: false\x2C\n    });\n}\n// @__NO_SIDE_EFFECTS__\nexport function _lte(value\x2C params) {\n    return new checks.$ZodCheckLessThan({\n        check: "less_than"\x2C\n        ...util.normalizeParams(params)\x2C\n        value\x2C\n        inclusive: true\x2C\n    });\n}\nexport { \n/** @deprecated Use `z.lte()` instead. */\n_lte as _max\x2C };\n// @__NO_SIDE_EFFECTS__\nexport function _gt(value\x2C params) {\n    return new checks.$ZodCheckGreaterThan({\n        check: "greater_than"\x2C\n        ...util.normalizeParams(params)\x2C\n        value\x2C\n        inclusive: false\x2C\n    });\n}\n// @__NO_SIDE_EFFECTS__\nexport function _gte(value\x2C params) {\n    return new checks.$ZodCheckGreaterThan({\n        check: "greater_than"\x2C\n        ...util.normalizeParams(params)\x2C\n        value\x2C\n        inclusive: true\x2C\n    });\n}\nexport { \n/** @deprecated Use `z.gte()` instead. */\n_gte as _min\x2C };\n// @__NO_SIDE_EFFECTS__\nexport function _positive(params) {\n    return _gt(0\x2C params);\n}\n// negative\n// @__NO_SIDE_EFFECTS__\nexport function _negative(params) {\n    return _lt(0\x2C params);\n}\n// nonpositive\n// @__NO_SIDE_EFFECTS__\nexport function _nonpositive(params) {\n    return _lte(0\x2C params);\n}\n// nonnegative\n// @__NO_SIDE_EFFECTS__\nexport function _nonnegative(params) {\n    return _gte(0\x2C params);\n}\n// @__NO_SIDE_EFFECTS__\nexport function _multipleOf(value\x2C params) {\n    return new checks.$ZodCheckMultipleOf({\n        check: "multiple_of"\x2C\n        ...util.normalizeParams(params)\x2C\n        value\x2C\n    });\n}\n// @__NO_SIDE_EFFECTS__\nexport function _maxSize(maximum\x2C params) {\n    return new checks.$ZodCheckMaxSize({\n        check: "max_size"\x2C\n        ...util.normalizeParams(params)\x2C\n        maximum\x2C\n    });\n}\n// @__NO_SIDE_EFFECTS__\nexport function _minSize(minimum\x2C params) {\n    return new checks.$ZodCheckMinSize({\n        check: "min_size"\x2C\n        ...util.normalizeParams(params)\x2C\n        minimum\x2C\n    });\n}\n// @__NO_SIDE_EFFECTS__\nexport function _size(size\x2C params) {\n    return new checks.$ZodCheckSizeEquals({\n        check: "size_equals"\x2C\n        ...util.normalizeParams(params)\x2C\n        size\x2C\n    });\n}\n// @__NO_SIDE_EFFECTS__\nexport function _maxLength(maximum\x2C params) {\n    const ch = new checks.$ZodCheckMaxLength({\n        check: "max_length"\x2C\n        ...util.normalizeParams(params)\x2C\n        maximum\x2C\n    });\n    return ch;\n}\n// @__NO_SIDE_EFFECTS__\nexport function _minLength(minimum\x2C params) {\n    return new checks.$ZodCheckMinLength({\n        check: "min_length"\x2C\n        ...util.normalizeParams(params)\x2C\n        minimum\x2C\n    });\n}\n// @__NO_SIDE_EFFECTS__\nexport function _length(length\x2C params) {\n    return new checks.$ZodCheckLengthEquals({\n        check: "length_equals"\x2C\n        ...util.normalizeParams(params)\x2C\n        length\x2C\n    });\n}\n// @__NO_SIDE_EFFECTS__\nexport function _regex(pattern\x2C params) {\n    return new checks.$ZodCheckRegex({\n        check: "string_format"\x2C\n        format: "regex"\x2C\n        ...util.normalizeParams(params)\x2C\n        pattern\x2C\n    });\n}\n// @__NO_SIDE_EFFECTS__\nexport function _lowercase(params) {\n    return new checks.$ZodCheckLowerCase({\n        check: "string_format"\x2C\n        format: "lowercase"\x2C\n        ...util.normalizeParams(params)\x2C\n    });\n}\n// @__NO_SIDE_EFFECTS__\nexport function _uppercase(params) {\n    return new checks.$ZodCheckUpperCase({\n        check: "string_format"\x2C\n        format: "uppercase"\x2C\n        ...util.normalizeParams(params)\x2C\n    });\n}\n// @__NO_SIDE_EFFECTS__\nexport function _includes(includes\x2C params) {\n    return new checks.$ZodCheckIncludes({\n        check: "string_format"\x2C\n        format: "includes"\x2C\n        ...util.normalizeParams(params)\x2C\n        includes\x2C\n    });\n}\n// @__NO_SIDE_EFFECTS__\nexport function _startsWith(prefix\x2C params) {\n    return new checks.$ZodCheckStartsWith({\n        check: "string_format"\x2C\n        format: "starts_with"\x2C\n        ...util.normalizeParams(params)\x2C\n        prefix\x2C\n    });\n}\n// @__NO_SIDE_EFFECTS__\nexport function _endsWith(suffix\x2C params) {\n    return new checks.$ZodCheckEndsWith({\n        check: "string_format"\x2C\n        format: "ends_with"\x2C\n        ...util.normalizeParams(params)\x2C\n        suffix\x2C\n    });\n}\n// @__NO_SIDE_EFFECTS__\nexport function _property(property\x2C schema\x2C params) {\n    return new checks.$ZodCheckProperty({\n        check: "property"\x2C\n        property\x2C\n        schema\x2C\n        ...util.normalizeParams(params)\x2C\n    });\n}\n// @__NO_SIDE_EFFECTS__\nexport function _mime(types\x2C params) {\n    return new checks.$ZodCheckMimeType({\n        check: "mime_type"\x2C\n        mime: types\x2C\n        ...util.normalizeParams(params)\x2C\n    });\n}\n// @__NO_SIDE_EFFECTS__\nexport function _overwrite(tx) {\n    return new checks.$ZodCheckOverwrite({\n        check: "overwrite"\x2C\n        tx\x2C\n    });\n}\n// normalize\n// @__NO_SIDE_EFFECTS__\nexport function _normalize(form) {\n    return _overwrite((input) => input.normalize(form));\n}\n// trim\n// @__NO_SIDE_EFFECTS__\nexport function _trim() {\n    return _overwrite((input) => input.trim());\n}\n// toLowerCase\n// @__NO_SIDE_EFFECTS__\nexport function _toLowerCase() {\n    return _overwrite((input) => input.toLowerCase());\n}\n// toUpperCase\n// @__NO_SIDE_EFFECTS__\nexport function _toUpperCase() {\n    return _overwrite((input) => input.toUpperCase());\n}\n// slugify\n// @__NO_SIDE_EFFECTS__\nexport function _slugify() {\n    return _overwrite((input) => util.slugify(input));\n}\n// @__NO_SIDE_EFFECTS__\nexport function _array(Class\x2C element\x2C params) {\n    return new Class({\n        type: "array"\x2C\n        element\x2C\n        // get element() {\n        //   return element;\n        // }\x2C\n        ...util.normalizeParams(params)\x2C\n    });\n}\n// @__NO_SIDE_EFFECTS__\nexport function _union(Class\x2C options\x2C params) {\n    return new Class({\n        type: "union"\x2C\n        options\x2C\n        ...util.normalizeParams(params)\x2C\n    });\n}\nexport function _xor(Class\x2C options\x2C params) {\n    return new Class({\n        type: "union"\x2C\n        options\x2C\n        inclusive: false\x2C\n        ...util.normalizeParams(params)\x2C\n    });\n}\n// @__NO_SIDE_EFFECTS__\nexport function _discriminatedUnion(Class\x2C discriminator\x2C options\x2C params) {\n    return new Class({\n        type: "union"\x2C\n        options\x2C\n        discriminator\x2C\n        ...util.normalizeParams(params)\x2C\n    });\n}\n// @__NO_SIDE_EFFECTS__\nexport function _intersection(Class\x2C left\x2C right) {\n    return new Class({\n        type: "intersection"\x2C\n        left\x2C\n        right\x2C\n    });\n}\n// export function _tuple(\n//   Class: util.SchemaClass<schemas.$ZodTuple>\x2C\n//   items: []\x2C\n//   params?: string | $ZodTupleParams\n// ): schemas.$ZodTuple<[]\x2C null>;\n// @__NO_SIDE_EFFECTS__\nexport function _tuple(Class\x2C items\x2C _paramsOrRest\x2C _params) {\n    const hasRest = _paramsOrRest instanceof schemas.$ZodType;\n    const params = hasRest ? _params : _paramsOrRest;\n    const rest = hasRest ? _paramsOrRest : null;\n    return new Class({\n        type: "tuple"\x2C\n        items\x2C\n        rest\x2C\n        ...util.normalizeParams(params)\x2C\n    });\n}\n// @__NO_SIDE_EFFECTS__\nexport function _record(Class\x2C keyType\x2C valueType\x2C params) {\n    return new Class({\n        type: "record"\x2C\n        keyType\x2C\n        valueType\x2C\n        ...util.normalizeParams(params)\x2C\n    });\n}\n// @__NO_SIDE_EFFECTS__\nexport function _map(Class\x2C keyType\x2C valueType\x2C params) {\n    return new Class({\n        type: "map"\x2C\n        keyType\x2C\n        valueType\x2C\n        ...util.normalizeParams(params)\x2C\n    });\n}\n// @__NO_SIDE_EFFECTS__\nexport function _set(Class\x2C valueType\x2C params) {\n    return new Class({\n        type: "set"\x2C\n        valueType\x2C\n        ...util.normalizeParams(params)\x2C\n    });\n}\n// @__NO_SIDE_EFFECTS__\nexport function _enum(Class\x2C values\x2C params) {\n    const entries = Array.isArray(values) ? Object.fromEntries(values.map((v) => [v\x2C v])) : values;\n    // if (Array.isArray(values)) {\n    //   for (const value of values) {\n    //     entries[value] = value;\n    //   }\n    // } else {\n    //   Object.assign(entries\x2C values);\n    // }\n    // const entries: util.EnumLike = {};\n    // for (const val of values) {\n    //   entries[val] = val;\n    // }\n    return new Class({\n        type: "enum"\x2C\n        entries\x2C\n        ...util.normalize