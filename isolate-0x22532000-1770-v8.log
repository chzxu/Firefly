script-source,773,file:///mnt/d/blog/Firefly/node_modules/array-iterate/lib/index.js,const own = {}.hasOwnProperty\n\n/**\n * Perform the specified action for each element in an array.\n * When `callbackFn` returns a `number`\x2C moves to the element at that index\n * next.\n *\n * @param {unknown[]} values\n *   Values to iterate over.\n * @param {(this: unknown\x2C value: unknown\x2C index: number\x2C array: unknown[]) => number | void} callbackFn\n *   Function called for each element.\n *   Can return the `index` to move to next.\n * @param {unknown} [thisArg]\n *   Optional object assigned as `this` in `callbackFn`.\n * @returns {void}\n */\nexport function arrayIterate(values\x2C callbackFn\x2C thisArg) {\n  let index = -1\n\n  if (!values) {\n    throw new Error('Iterate requires that |this| not be ' + values)\n  }\n\n  if (!own.call(values\x2C 'length')) {\n    throw new Error('Iterate requires that |this| has a `length`')\n  }\n\n  if (typeof callbackFn !== 'function') {\n    throw new TypeError('`callback` must be a function')\n  }\n\n  // The length might change\x2C so we do not cache it.\n  while (++index < values.length) {\n    // Skip missing values.\n    if (!(index in values)) {\n      continue\n    }\n\n    const result = callbackFn.call(thisArg\x2C values[index]\x2C index\x2C values)\n\n    // If `callback` returns a `number`\x2C move `index` over to `number`.\n    if (typeof result === 'number') {\n      // Make sure that negative numbers do not break the loop.\n      if (result < 0) {\n        index = 0\n      }\n\n      index = result - 1\n    }\n  }\n}\n
