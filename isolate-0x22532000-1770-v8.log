script-source,284,file:///mnt/d/blog/Firefly/node_modules/astro/dist/core/csp/config.js,import * as z from "zod/v4";\nconst ALGORITHMS = {\n  "SHA-256": "sha256-"\x2C\n  "SHA-384": "sha384-"\x2C\n  "SHA-512": "sha512-"\n};\nconst ALGORITHM_VALUES = Object.values(ALGORITHMS);\nconst cspAlgorithmSchema = z.enum(Object.keys(ALGORITHMS)).optional().default("SHA-256");\nconst cspHashSchema = z.custom((value) => {\n  if (typeof value !== "string") {\n    return false;\n  }\n  return ALGORITHM_VALUES.some((allowedValue) => {\n    return value.startsWith(allowedValue);\n  });\n});\nconst ALLOWED_DIRECTIVES = [\n  "base-uri"\x2C\n  "child-src"\x2C\n  "connect-src"\x2C\n  "default-src"\x2C\n  "fenced-frame-src"\x2C\n  "font-src"\x2C\n  "form-action"\x2C\n  "frame-ancestors"\x2C\n  "frame-src"\x2C\n  "img-src"\x2C\n  "manifest-src"\x2C\n  "media-src"\x2C\n  "object-src"\x2C\n  "referrer"\x2C\n  "report-to"\x2C\n  "report-uri"\x2C\n  "require-trusted-types-for"\x2C\n  "sandbox"\x2C\n  "trusted-types"\x2C\n  "upgrade-insecure-requests"\x2C\n  "worker-src"\n];\nconst allowedDirectivesSchema = z.custom((value) => {\n  if (typeof value !== "string") {\n    return false;\n  }\n  return ALLOWED_DIRECTIVES.some((allowedValue) => {\n    return value.startsWith(allowedValue);\n  });\n});\nexport {\n  ALGORITHMS\x2C\n  allowedDirectivesSchema\x2C\n  cspAlgorithmSchema\x2C\n  cspHashSchema\n};\n
