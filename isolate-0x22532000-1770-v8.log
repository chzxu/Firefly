script-source,377,/mnt/d/blog/Firefly/node_modules/prismjs/components/index.js,const components = require('../components.js');\nconst getLoader = require('../dependencies');\n\n\n/**\n * The set of all languages which have been loaded using the below function.\n *\n * @type {Set<string>}\n */\nconst loadedLanguages = new Set();\n\n/**\n * Loads the given languages and adds them to the current Prism instance.\n *\n * If no languages are provided\x2C __all__ Prism languages will be loaded.\n *\n * @param {string|string[]} [languages]\n * @returns {void}\n */\nfunction loadLanguages(languages) {\n\x09if (languages === undefined) {\n\x09\x09languages = Object.keys(components.languages).filter(l => l != 'meta');\n\x09} else if (!Array.isArray(languages)) {\n\x09\x09languages = [languages];\n\x09}\n\n\x09// the user might have loaded languages via some other way or used `prism.js` which already includes some\n\x09// we don't need to validate the ids because `getLoader` will ignore invalid ones\n\x09const loaded = [...loadedLanguages\x2C ...Object.keys(Prism.languages)];\n\n\x09getLoader(components\x2C languages\x2C loaded).load(lang => {\n\x09\x09if (!(lang in components.languages)) {\n\x09\x09\x09if (!loadLanguages.silent) {\n\x09\x09\x09\x09console.warn('Language does not exist: ' + lang);\n\x09\x09\x09}\n\x09\x09\x09return;\n\x09\x09}\n\n\x09\x09const pathToLanguage = './prism-' + lang;\n\n\x09\x09// remove from require cache and from Prism\n\x09\x09delete require.cache[require.resolve(pathToLanguage)];\n\x09\x09delete Prism.languages[lang];\n\n\x09\x09require(pathToLanguage);\n\n\x09\x09loadedLanguages.add(lang);\n\x09});\n}\n\n/**\n * Set this to `true` to prevent all warning messages `loadLanguages` logs.\n */\nloadLanguages.silent = false;\n\nmodule.exports = loadLanguages;\n
