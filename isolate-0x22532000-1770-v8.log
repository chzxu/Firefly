script-source,713,file:///mnt/d/blog/Firefly/node_modules/mdast-util-find-and-replace/node_modules/escape-string-regexp/index.js,export default function escapeStringRegexp(string) {\n\x09if (typeof string !== 'string') {\n\x09\x09throw new TypeError('Expected a string');\n\x09}\n\n\x09// Escape characters with special meaning either inside or outside character sets.\n\x09// Use a simple backslash escape when it\u2019s always valid\x2C and a `\\xnn` escape when the simpler form would be disallowed by Unicode patterns\u2019 stricter grammar.\n\x09return string\n\x09\x09.replace(/[|\\\\{}()[\\]^$+*?.]/g\x2C '\\\\$&')\n\x09\x09.replace(/-/g\x2C '\\\\x2d');\n}\n
