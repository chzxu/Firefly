script-source,280,file:///mnt/d/blog/Firefly/node_modules/astro/dist/assets/fonts/config.js,import * as z from "zod/v4";\nimport { FONT_TYPES } from "./constants.js";\nconst WeightSchema = z.union([z.string()\x2C z.number()]);\nconst StyleSchema = z.enum(["normal"\x2C "italic"\x2C "oblique"]);\nconst DisplaySchema = z.enum(["auto"\x2C "block"\x2C "swap"\x2C "fallback"\x2C "optional"]);\nconst FormatSchema = z.enum(FONT_TYPES);\nconst _FontProviderSchema = z.strictObject({\n  name: z.string()\x2C\n  config: z.record(z.string()\x2C z.any()).optional()\x2C\n  init: z.custom((v) => typeof v === "function").optional()\x2C\n  resolveFont: z.custom((v) => typeof v === "function")\x2C\n  listFonts: z.custom((v) => typeof v === "function").optional()\n});\nconst FontProviderSchema = z.custom((v) => {\n  return _FontProviderSchema.safeParse(v).success;\n}\x2C "Invalid FontProvider object");\nconst FontFamilySchema = z.object({\n  name: z.string()\x2C\n  cssVariable: z.string()\x2C\n  provider: FontProviderSchema\x2C\n  weights: z.tuple([WeightSchema]\x2C WeightSchema).optional()\x2C\n  styles: z.tuple([StyleSchema]\x2C StyleSchema).optional()\x2C\n  subsets: z.tuple([z.string()]\x2C z.string()).optional()\x2C\n  formats: z.tuple([FormatSchema]\x2C FormatSchema).optional()\x2C\n  fallbacks: z.array(z.string()).optional()\x2C\n  optimizedFallbacks: z.boolean().optional()\x2C\n  display: DisplaySchema.optional()\x2C\n  stretch: z.string().optional()\x2C\n  featureSettings: z.string().optional()\x2C\n  variationSettings: z.string().optional()\x2C\n  unicodeRange: z.tuple([z.string()]\x2C z.string()).optional()\x2C\n  options: z.record(z.string()\x2C z.any()).optional()\n}).strict();\nexport {\n  DisplaySchema\x2C\n  FontFamilySchema\x2C\n  FontProviderSchema\x2C\n  StyleSchema\x2C\n  WeightSchema\n};\n
