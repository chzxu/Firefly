script-source,414,file:///mnt/d/blog/Firefly/node_modules/mdast-util-to-hast/lib/handlers/heading.js,/**\n * @import {Element} from 'hast'\n * @import {Heading} from 'mdast'\n * @import {State} from '../state.js'\n */\n\n/**\n * Turn an mdast `heading` node into hast.\n *\n * @param {State} state\n *   Info passed around.\n * @param {Heading} node\n *   mdast node.\n * @returns {Element}\n *   hast node.\n */\nexport function heading(state\x2C node) {\n  /** @type {Element} */\n  const result = {\n    type: 'element'\x2C\n    tagName: 'h' + node.depth\x2C\n    properties: {}\x2C\n    children: state.all(node)\n  }\n  state.patch(node\x2C result)\n  return state.applyData(node\x2C result)\n}\n
