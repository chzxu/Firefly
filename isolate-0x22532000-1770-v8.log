script-source,151,file:///mnt/d/blog/Firefly/node_modules/astro/dist/core/logger/core.js,import colors from "piccolore";\nconst AstroLoggerLabels = [\n  "add"\x2C\n  "build"\x2C\n  "check"\x2C\n  "config"\x2C\n  "content"\x2C\n  "crypto"\x2C\n  "deprecated"\x2C\n  "markdown"\x2C\n  "router"\x2C\n  "types"\x2C\n  "vite"\x2C\n  "watch"\x2C\n  "middleware"\x2C\n  "preferences"\x2C\n  "redirects"\x2C\n  "sync"\x2C\n  "session"\x2C\n  "toolbar"\x2C\n  "assets"\x2C\n  "env"\x2C\n  "update"\x2C\n  "adapter"\x2C\n  "islands"\x2C\n  "cache"\x2C\n  "csp"\x2C\n  // SKIP_FORMAT: A special label that tells the logger not to apply any formatting.\n  // Useful for messages that are already formatted\x2C like the server start message.\n  "SKIP_FORMAT"\n];\nconst dateTimeFormat = new Intl.DateTimeFormat([]\x2C {\n  hour: "2-digit"\x2C\n  minute: "2-digit"\x2C\n  second: "2-digit"\x2C\n  hour12: false\n});\nconst levels = {\n  debug: 20\x2C\n  info: 30\x2C\n  warn: 40\x2C\n  error: 50\x2C\n  silent: 90\n};\nfunction log(opts\x2C level\x2C label\x2C message\x2C newLine = true) {\n  const logLevel = opts.level;\n  const dest = opts.destination;\n  const event = {\n    label\x2C\n    level\x2C\n    message\x2C\n    newLine\n  };\n  if (!isLogLevelEnabled(logLevel\x2C level)) {\n    return;\n  }\n  dest.write(event);\n}\nfunction isLogLevelEnabled(configuredLogLevel\x2C level) {\n  return levels[configuredLogLevel] <= levels[level];\n}\nfunction info(opts\x2C label\x2C message\x2C newLine = true) {\n  return log(opts\x2C "info"\x2C label\x2C message\x2C newLine);\n}\nfunction warn(opts\x2C label\x2C message\x2C newLine = true) {\n  return log(opts\x2C "warn"\x2C label\x2C message\x2C newLine);\n}\nfunction error(opts\x2C label\x2C message\x2C newLine = true) {\n  return log(opts\x2C "error"\x2C label\x2C message\x2C newLine);\n}\nfunction debug(...args) {\n  if ("_astroGlobalDebug" in globalThis) {\n    globalThis._astroGlobalDebug(...args);\n  }\n}\nfunction getEventPrefix({ level\x2C l