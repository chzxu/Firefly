script-source,717,file:///mnt/d/blog/Firefly/node_modules/mdast-util-to-markdown/lib/util/association.js,/**\n * @import {AssociationId} from '../types.js'\n */\n\nimport {decodeString} from 'micromark-util-decode-string'\n\n/**\n * Get an identifier from an association to match it to others.\n *\n * Associations are nodes that match to something else through an ID:\n * <https://github.com/syntax-tree/mdast#association>.\n *\n * The `label` of an association is the string value: character escapes and\n * references work\x2C and casing is intact.\n * The `identifier` is used to match one association to another:\n * controversially\x2C character escapes and references don\u2019t work in this\n * matching: `&copy;` does not match `\xa9`\x2C and `\\+` does not match `+`.\n *\n * But casing is ignored (and whitespace) is trimmed and collapsed: ` A\\nb`\n * matches `a b`.\n * So\x2C we do prefer the label when figuring out how we\u2019re going to serialize:\n * it has whitespace\x2C casing\x2C and we can ignore most useless character\n * escapes and all character references.\n *\n * @type {AssociationId}\n */\nexport function association(node) {\n  if (node.label || !node.identifier) {\n    return node.label || ''\n  }\n\n  return decodeString(node.identifier)\n}\n
