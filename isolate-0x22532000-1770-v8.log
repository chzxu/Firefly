ment'\x2C\n    url: false\n  }\x2C\n  /** @type {ErrorInfo} */\n  nonConformingDoctype: {\n    reason: 'Unexpected non-conforming doctype declaration'\x2C\n    description:\n      'Expected `<!doctype html>` or `<!doctype html system "about:legacy-compat">`'\x2C\n    url: false\n  }\x2C\n  /** @type {ErrorInfo} */\n  nonVoidHtmlElementStartTagWithTrailingSolidus: {\n    reason: 'Unexpected trailing slash on start tag of non-void element'\x2C\n    description: 'Unexpected `/`. Expected `>` instead'\n  }\x2C\n  /** @type {ErrorInfo} */\n  noncharacterCharacterReference: {\n    reason:\n      'Unexpected noncharacter code point referenced by character reference'\x2C\n    description: 'Unexpected code point. Do not use noncharacters in HTML'\n  }\x2C\n  /** @type {ErrorInfo} */\n  noncharacterInInputStream: {\n    reason: 'Unexpected noncharacter character'\x2C\n    description: 'Unexpected code point `%x`. Do not use noncharacters in HTML'\n  }\x2C\n  /** @type {ErrorInfo} */\n  nullCharacterReference: {\n    reason: 'Unexpected NULL character referenced by character reference'\x2C\n    description: 'Unexpected code point. Do not use NULL characters in HTML'\n  }\x2C\n  /** @type {ErrorInfo} */\n  openElementsLeftAfterEof: {\n    reason: 'Unexpected end of file'\x2C\n    description: 'Unexpected end of file. Expected closing tag instead'\x2C\n    url: false\n  }\x2C\n  /** @type {ErrorInfo} */\n  surrogateCharacterReference: {\n    reason: 'Unexpected surrogate character referenced by character reference'\x2C\n    description:\n      'Unexpected code point. Do not use lone surrogate characters in HTML'\n  }\x2C\n  /** @type {ErrorInfo} */\n  surrogateInInputStream: {\n    reason: 'Unexpected surrogate character'\x2C\n    description:\n      'Unexpected code point `%x`. Do not use lone surrogate characters in HTML'\n  }\x2C\n  /** @type {ErrorInfo} */\n  unexpectedCharacterAfterDoctypeSystemIdentifier: {\n    reason: 'Invalid character after system identifier in doctype