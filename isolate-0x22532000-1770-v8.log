script-source,407,file:///mnt/d/blog/Firefly/node_modules/mdast-util-from-markdown/lib/index.js,/**\n * @import {\n *   Break\x2C\n *   Blockquote\x2C\n *   Code\x2C\n *   Definition\x2C\n *   Emphasis\x2C\n *   Heading\x2C\n *   Html\x2C\n *   Image\x2C\n *   InlineCode\x2C\n *   Link\x2C\n *   ListItem\x2C\n *   List\x2C\n *   Nodes\x2C\n *   Paragraph\x2C\n *   PhrasingContent\x2C\n *   ReferenceType\x2C\n *   Root\x2C\n *   Strong\x2C\n *   Text\x2C\n *   ThematicBreak\n * } from 'mdast'\n * @import {\n *   Encoding\x2C\n *   Event\x2C\n *   Token\x2C\n *   Value\n * } from 'micromark-util-types'\n * @import {Point} from 'unist'\n * @import {\n *   CompileContext\x2C\n *   CompileData\x2C\n *   Config\x2C\n *   Extension\x2C\n *   Handle\x2C\n *   OnEnterError\x2C\n *   Options\n * } from './types.js'\n */\n\nimport { toString } from 'mdast-util-to-string';\nimport { parse\x2C postprocess\x2C preprocess } from 'micromark';\nimport { decodeNumericCharacterReference } from 'micromark-util-decode-numeric-character-reference';\nimport { decodeString } from 'micromark-util-decode-string';\nimport { normalizeIdentifier } from 'micromark-util-normalize-identifier';\nimport { decodeNamedCharacterReference } from 'decode-named-character-reference';\nimport { stringifyPosition } from 'unist-util-stringify-position';\nconst own = {}.hasOwnProperty;\n\n/**\n * Turn markdown into a syntax tree.\n *\n * @overload\n * @param {Value} value\n * @param {Encoding | null | undefined} [encoding]\n * @param {Options | null | undefined} [options]\n * @returns {Root}\n *\n * @overload\n * @param {Value} value\n * @param {Options | null | undefined} [options]\n * @returns {Root}\n *\n * @param {Value} value\n *   Markdown to parse.\n * @param {Encoding | Options | null | undefined} [encoding]\n *   Character encoding for when `value` is `Buffer`.\n * @param {Options | null | undefined} [options]\n *   Configuration.\n * @returns {Root}\n *   mdast tree.\n */\nexport function fromMarkdown(value\x2C encoding\x2C options) {\n  if (encoding && typeof encoding === 'object') {\n    options = encoding;\n    encoding = undefined;\n  }\n  return compiler(options)(postprocess(parse(options).document().write(preprocess()(value\x2C encoding\x2C true))));\n}\n\n/**\n * Note this compiler only understand complete buffering\x2C not streaming.\n *\n * @param {Options | null | undefined} [options]\n */\nfunction compiler(options) {\n  /** @type {Config} */\n  const config = {\n    transforms: []\x2C\n    canContainEols: ['emphasis'\x2C 'fragment'\x2C 'heading'\x2C 'paragraph'\x2C 'strong']\x2C\n    enter: {\n      autolink: opener(link)\x2C\n      autolinkProtocol: onenterdata\x2C\n      autolinkEmail: onenterdata\x2C\n      atxHeading: opener(heading)\x2C\n      blockQuote: opener(blockQuote)\x2C\n      characterEscape: onenterdata\x2C\n      characterReference: onenterdata\x2C\n      codeFenced: opener(codeFlow)\x2C\n      codeFencedFenceInfo: buffer\x2C\n      codeFencedFenceMeta: buffer\x2C\n      codeIndented: opener(codeFlow\x2C buffer)\x2C\n      codeText: opener(codeText\x2C buffer)\x2C\n      codeTextData: onenterdata\x2C\n      data: onenterdata\x2C\n      codeFlowValue: onenterdata\x2C\n      definition: opener(definition)\x2C\n      definitionDestinationString: buffer\x2C\n      definitionLabelString: buffer\x2C\n      definitionTitleString: buffer\x2C\n      emphasis: opener(emphasis)\x2C\n      hardBreakEscape: opener(hardBreak)\x2C\n      hardBreakTrailing: opener(hardBreak)\x2C\n      htmlFlow: opener(html\x2C buffer)\x2C\n      htmlFlowData: onenterdata\x2C\n      htmlText: opener(html\x2C buffer)\x2C\n      htmlTextData: onenterdata\x2C\n      image: opener(image)\x2C\n      label: buffer\x2C\n      link: opener(link)\x2C\n      listItem: opener(listItem)\x2C\n      listItemValue: onenterlistitemvalue\x2C\n      listOrdered: opener(list\x2C onenterlistordered)\x2C\n      listUnordered: opener(list)\x2C\n      paragraph: opener(paragraph)\x2C\n   