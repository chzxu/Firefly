'./error.js';\nlet KEY_PART_RE = /^[a-zA-Z0-9-_]+[ \\t]*$/;\nexport function parseKey(str\x2C ptr\x2C end = '=') {\n    let dot = ptr - 1;\n    let parsed = [];\n    let endPtr = str.indexOf(end\x2C ptr);\n    if (endPtr < 0) {\n        throw new TomlError('incomplete key-value: cannot find end of key'\x2C {\n            toml: str\x2C\n            ptr: ptr\x2C\n        });\n    }\n    do {\n        let c = str[ptr = ++dot];\n        // If it's whitespace\x2C ignore\n        if (c !== ' ' && c !== '\\t') {\n            // If it's a string\n            if (c === '"' || c === '\\'') {\n                if (c === str[ptr + 1] && c === str[ptr + 2]) {\n                    throw new TomlError('multiline strings are not allowed in keys'\x2C {\n                        toml: str\x2C\n                        ptr: ptr\x2C\n                    });\n                }\n                let eos = getStringEnd(str\x2C ptr);\n                if (eos < 0) {\n                    throw new TomlError('unfinished string encountered'\x2C {\n                        toml: str\x2C\n                        ptr: ptr\x2C\n                    });\n                }\n                dot = str.indexOf('.'\x2C eos);\n                let strEnd = str.slice(eos\x2C dot < 0 || dot > endPtr ? endPtr : dot);\n                let newLine = indexOfNewline(strEnd);\n                if (newLine > -1) {\n                    throw new TomlError('newlines are not allowed in keys'\x2C {\n                        toml: str\x2C\n                        ptr: ptr + dot + newLine\x2C\n                    });\n                }\n                if (strEnd.trimStart()) {\n                    throw new TomlError('found extra tokens after the string part'\x2C {\n                        toml: str\x2C\n                        ptr: eos\x2C\n                    });\n                }\n                if (endPtr < eos) {\n                    endPtr = str.indexOf(end\x2C eos);\n                    if (endPtr < 0) {\n            