script-source,560,file:///mnt/d/blog/Firefly/node_modules/parse5/dist/common/foreign-content.js,import { TAG_ID as $\x2C NS\x2C ATTRS\x2C getTagID } from './html.js';\n//MIME types\nconst MIME_TYPES = {\n    TEXT_HTML: 'text/html'\x2C\n    APPLICATION_XML: 'application/xhtml+xml'\x2C\n};\n//Attributes\nconst DEFINITION_URL_ATTR = 'definitionurl';\nconst ADJUSTED_DEFINITION_URL_ATTR = 'definitionURL';\nconst SVG_ATTRS_ADJUSTMENT_MAP = new Map([\n    'attributeName'\x2C\n    'attributeType'\x2C\n    'baseFrequency'\x2C\n    'baseProfile'\x2C\n    'calcMode'\x2C\n    'clipPathUnits'\x2C\n    'diffuseConstant'\x2C\n    'edgeMode'\x2C\n    'filterUnits'\x2C\n    'glyphRef'\x2C\n    'gradientTransform'\x2C\n    'gradientUnits'\x2C\n    'kernelMatrix'\x2C\n    'kernelUnitLength'\x2C\n    'keyPoints'\x2C\n    'keySplines'\x2C\n    'keyTimes'\x2C\n    'lengthAdjust'\x2C\n    'limitingConeAngle'\x2C\n    'markerHeight'\x2C\n    'markerUnits'\x2C\n    'markerWidth'\x2C\n    'maskContentUnits'\x2C\n    'maskUnits'\x2C\n    'numOctaves'\x2C\n    'pathLength'\x2C\n    'patternContentUnits'\x2C\n    'patternTransform'\x2C\n    'patternUnits'\x2C\n    'pointsAtX'\x2C\n    'pointsAtY'\x2C\n    'pointsAtZ'\x2C\n    'preserveAlpha'\x2C\n    'preserveAspectRatio'\x2C\n    'primitiveUnits'\x2C\n    'refX'\x2C\n    'refY'\x2C\n    'repeatCount'\x2C\n    'repeatDur'\x2C\n    'requiredExtensions'\x2C\n    'requiredFeatures'\x2C\n    'specularConstant'\x2C\n    'specularExponent'\x2C\n    'spreadMethod'\x2C\n    'startOffset'\x2C\n    'stdDeviation'\x2C\n    'stitchTiles'\x2C\n    'surfaceScale'\x2C\n    'systemLanguage'\x2C\n    'tableValues'\x2C\n    'targetX'\x2C\n    'targetY'\x2C\n    'textLength'\x2C\n    'viewBox'\x2C\n    'viewTarget'\x2C\n    'xChannelSelector'\x2C\n    'yChannelSelector'\x2C\n    'zoomAndPan'\x2C\n].map((attr) => [attr.toLowerCase()\x2C attr]));\nconst XML_ATTRS_ADJUSTMENT_MAP = new Map([\n    ['xlink:actuate'\x2C { prefix: 'xlink'\x2C name: 'actuate'\x2C namespace: NS.XLINK }]\x2C\n    ['xlink:arcrole'\x2C { prefix: 'xlink'\x2C name: 'arcrole'\x2C namespace: NS.XLINK }]\x2C\n    ['xlink:href'\x2C { prefix: 'xlink'\x2C name: 'href'\x2C namespace: NS.XLINK }]\x2C\n    ['xlink:role'\x2C { prefix: 'xlink'\x2C name: 'role'\x2C namespace: NS.XLINK }]\x2C\n    ['xlink:show'\x2C { prefix: 'xlink'\x2C name: 'show'\x2C namespace: NS.XLINK }]\x2C\n    ['xlink:title'\x2C { prefix: 'xlink'\x2C name: 'title'\x2C namespace: NS.XLINK }]\x2C\n    ['xlink:type'\x2C { prefix: 'xlink'\x2C name: 'type'\x2C namespace: NS.XLINK }]\x2C\n    ['xml:lang'\x2C { prefix: 'xml'\x2C name: 'lang'\x2C namespace: NS.XML }]\x2C\n    ['xml:space'\x2C { prefix: 'xml'\x2C name: 'space'\x2C namespace: NS.XML }]\x2C\n    ['xmlns'\x2C { prefix: ''\x2C name: 'xmlns'\x2C namespace: NS.XMLNS }]\x2C\n    ['xmlns:xlink'\x2C { prefix: 'xmlns'\x2C name: 'xlink'\x2C namespace: NS.XMLNS }]\x2C\n]);\n//SVG tag names adjustment map\nexport const SVG_TAG_NAMES_ADJUSTMENT_MAP = new Map([\n    'altGlyph'\x2C\n    'altGlyphDef'\x2C\n    'altGlyphItem'\x2C\n    'animateColor'\x2C\n    'animateMotion'\x2C\n    'animateTransform'\x2C\n    'clipPath'\x2C\n    'feBlend'\x2C\n    'feColorMatrix'\x2C\n    'feComponentTransfer'\x2C\n    'feComposite'\x2C\n    'feConvolveMatrix'\x2C\n    'feDiffuseLighting'\x2C\n    'feDisplacementMap'\x2C\n    'feDistantLight'\x2C\n    'feFlood'\x2C\n    'feFuncA'\x2C\n    'feFuncB'\x2C\n    'feFuncG'\x2C\n    'feFuncR'\x2C\n    'feGaussianBlur'\x2C\n    'feImage'\x2C\n    'feMerge'\x2C\n    'feMergeNode'\x2C\n    'feMorphology'\x2C\n    'feOffset'\x2C\n    'fePointLight'\x2C\n    'feSpecularLighting'\x2C\n    'feSpotLight'\x2C\n    'feTile'\x2C\n    'feTurbulence'\x2C\n    'foreignObject'\x2C\n    'glyphRef'\x2C\n    'linearGradient'\x2C\n    'radialGradient'\x2C\n    'textPath'\x2C\n].map((tn) => [tn.toLowerCase()\x2C tn]));\n//Tags that causes exit from foreign content\nconst EXITS_FOREIGN_CONTENT = new Set([\n    $.B\x2C\n    $.BIG\x2C\n    $.BLOCKQUOTE\x2C\n    $.BODY\x2C\n    $.BR\x2C\n    $.CENTER\x2C\n    $.CODE\x2C\n    $.DD\x2C\n    $.DIV\x2C\n    $.DL\x2C\n    $.DT\x2C\n    $.EM\x2C\n    $.EMBED\x2C\n    $.H1\x2C\n    $.H2\x2C\n    $.H3\x2C\n    $.H4\x2C\n    $.H5\x2C\n    $.H6\x2C\n    $.HEAD\x2C\n    $.HR\x2C\n    $.I\x2C\n    $.IMG\x2C\n    $.LI\x2C\n    $.LISTING\x2C\n    $.MENU\x2C\n    $.META\x2C\n    $.NOBR\x2C\n    $.OL\x2C\n    $.P\x2C\n    $.PRE\x2C\n    $.RUBY\x2C\n    $.S\x2C\n    $.SMALL\x2C\n    $.SPAN\x2C\n    $.STRONG\x2C\n    $.STRIKE\x2C\n    $.SUB\x2C\n    $.SUP\x2C\n    $.TABLE\x2C\n    $.TT\x2C\n    $.U\x2C\n    $.UL\x2C\n    $.VAR\x2C\n]);\n//Check exit from foreign content\nexport function causesExit(startTagToken) {\n    const tn = startTagToken.tagID;\n    const isFontWithAttrs = tn === $.FONT &&\n        startTagToken.attrs.some(({ name }) => name === ATTRS.COLOR || name === ATTRS.SIZE || name === ATTRS.FACE);\n    return isFontWithAttrs || EXITS_FOREIGN_CONTENT.has(tn);\n}\n//Token adjustments\nexport function adjustTokenMathMLAttrs(token) {\n    for (let i = 0; i < token.attrs.length; i++) {\n        if (token.attrs[i].name === DEFINITION_URL_ATTR) {\n            token.attrs[i].name = ADJUSTED_DEFINITION_URL_ATTR;\n            break;\n        }\n    }\n}\nexport function adjustTokenSVGAttrs(token) {\n    for (let i = 0; i < token.attrs.length; i++) {\n        const adjustedAttrName = SVG_ATTRS_ADJUSTMENT_MAP.get(token.attrs[i].name);\n        if (adjustedAttrName != null) {\n            token.attrs[i].name = adjustedAttrName;\n        }\n    }\n}\nexport function adjustTokenXMLAttrs(token) {\n    for (let i = 0; i < token.attrs.length; i++) {\n        const adjustedAttrEntry = XML_ATTRS_ADJUSTMENT_MAP.get(token.attrs[i].name);\n        if (adjustedAttrEntry) {\n            token.attrs[i].prefix = adjustedAttrEntry.prefix;\n            token.attrs[i].name = adjustedAttrEntry.name;\n            token.attrs[i].namespace = adjustedAttrEntry.namespace;\n        }\n    }\n}\nexport function adjustTokenSVGTagName(token) {\n    const adjustedTagName = SVG_TAG_NAMES_ADJUSTMENT_MAP.get(token.tagName);\n    if (adjustedTagName != null) {\n        token.tagName = adjustedTagName;\n        token.tagID = getTagID(token.tagName);\n    }\n}\n//Integration points\nfunction isMathMLTextIntegrationPoint(tn\x2C ns) {\n    return ns === NS.MATHML && (tn === $.MI || tn === $.MO || tn === $.MN || tn === $.MS || tn === $.MTEXT);\n}\nfunction isHtmlIntegrationPoint(tn\x2C ns\x2C attrs) {\n    if (ns === NS.MATHML && tn === $.ANNOTATION_XML) {\n        for (let i = 0; i < attrs.length; i++) {\n            if (attrs[i].name === ATTRS.ENCODING) {\n                const value = attrs[i].value.toLowerCase();\n                return value === MIME_TYPES.TEXT_HTML || value === MIME_TYPES.APPLICATION_XML;\n            }\n        }\n    }\n    return ns === NS.SVG && (tn === $.FOREIGN_OBJECT || tn === $.DESC || tn === $.TITLE);\n}\nexport function isIntegrationPoint(tn\x2C ns\x2C attrs\x2C foreignNS) {\n    return (((!foreignNS || foreignNS === NS.HTML) && isHtmlIntegrationPoint(tn\x2C ns\x2C attrs)) ||\n        ((!foreignNS || foreignNS === NS.MATHML) && isMathMLTextIntegrationPoint(tn\x2C ns)));\n}\n
