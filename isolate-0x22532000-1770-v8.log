script-source,506,file:///mnt/d/blog/Firefly/node_modules/zod/v4/locales/sl.js,import * as util from "../core/util.js";\nconst error = () => {\n    const Sizable = {\n        string: { unit: "znakov"\x2C verb: "imeti" }\x2C\n        file: { unit: "bajtov"\x2C verb: "imeti" }\x2C\n        array: { unit: "elementov"\x2C verb: "imeti" }\x2C\n        set: { unit: "elementov"\x2C verb: "imeti" }\x2C\n    };\n    function getSizing(origin) {\n        return Sizable[origin] ?? null;\n    }\n    const FormatDictionary = {\n        regex: "vnos"\x2C\n        email: "e-po\u0161tni naslov"\x2C\n        url: "URL"\x2C\n        emoji: "emoji"\x2C\n        uuid: "UUID"\x2C\n        uuidv4: "UUIDv4"\x2C\n        uuidv6: "UUIDv6"\x2C\n        nanoid: "nanoid"\x2C\n        guid: "GUID"\x2C\n        cuid: "cuid"\x2C\n        cuid2: "cuid2"\x2C\n        ulid: "ULID"\x2C\n        xid: "XID"\x2C\n        ksuid: "KSUID"\x2C\n        datetime: "ISO datum in \u010das"\x2C\n        date: "ISO datum"\x2C\n        time: "ISO \u010das"\x2C\n        duration: "ISO trajanje"\x2C\n        ipv4: "IPv4 naslov"\x2C\n        ipv6: "IPv6 naslov"\x2C\n        cidrv4: "obseg IPv4"\x2C\n        cidrv6: "obseg IPv6"\x2C\n        base64: "base64 kodiran niz"\x2C\n        base64url: "base64url kodiran niz"\x2C\n        json_string: "JSON niz"\x2C\n        e164: "E.164 \u0161tevilka"\x2C\n        jwt: "JWT"\x2C\n        template_literal: "vnos"\x2C\n    };\n    const TypeDictionary = {\n        nan: "NaN"\x2C\n        number: "\u0161tevilo"\x2C\n        array: "tabela"\x2C\n    };\n    return (issue) => {\n        switch (issue.code) {\n            case "invalid_type": {\n                const expected = TypeDictionary[issue.expected] ?? issue.expected;\n                const receivedType = util.parsedType(issue.input);\n                const received = TypeDictionary[receivedType] ?? receivedType;\n                if (/^[A-Z]/.test(issue.expected)) {\n                    return `Neveljaven vnos: pri\u010dakovano instanceof ${issue.expected}\x2C prejeto ${received}`;\n                }\n                return `Neveljaven vnos: pri\u010dakovano ${expected}\x2C prejeto ${received}`;\n            }\n            case "invalid_value":\n                if (issue.values.length === 1)\n                    return `Neveljaven vnos: pri\u010dakovano ${util.stringifyPrimitive(issue.values[0])}`;\n                return `Neveljavna mo\u017enost: pri\u010dakovano eno izmed ${util.joinValues(issue.values\x2C "|")}`;\n            case "too_big": {\n                const adj = issue.inclusive ? "<=" : "<";\n                const sizing = getSizing(issue.origin);\n                if (sizing)\n                    return `Preveliko: pri\u010dakovano\x2C da bo ${issue.origin ?? "vrednost"} imelo ${adj}${issue.maximum.toString()} ${sizing.unit ?? "elementov"}`;\n                return `Preveliko: pri\u010dakovano\x2C da bo ${issue.origin ?? "vrednost"} ${adj}${issue.maximum.toString()}`;\n            }\n            case "too_small": {\n                const adj = issue.inclusive ? ">=" : ">";\n                const sizing = getSizing(issue.origin);\n                if (sizing) {\n                    return `Premajhno: pri\u010dakovano\x2C da bo ${issue.origin} imelo ${adj}${issue.minimum.toString()} ${sizing.unit}`;\n                }\n                return `Premajhno: pri\u010dakovano\x2C da bo ${issue.origin} ${adj}${issue.minimum.toString()}`;\n            }\n            case "invalid_format": {\n                const _issue = issue;\n                if (_issue.format === "starts_with") {\n                    return `Neveljaven niz: mora se za\u010deti z "${_issue.prefix}"`;\n                }\n                if (_issue.format === "ends_with")\n                    return `Neveljaven niz: mora se kon\u010dati z "${_issue.suffix}"`;\n                if (_issue.format === "includes")\n                    return `Neveljaven niz: mora vsebovati "${_issue.includes}"`;\n                if (_issue.format === "regex")\n                    return `Neveljaven niz: mora ustrezati vzorcu ${_issue.pattern}`;\n                return `Neveljaven ${FormatDictionary[_issue.format] ?? issue.format}`;\n            }\n            case "not_multiple_of":\n                return `Neveljavno \u0161tevilo: mora biti ve\u010dkratnik ${issue.divisor}`;\n            case "unrecognized_keys":\n                return `Neprepoznan${issue.keys.length > 1 ? "i klju\u010di" : " klju\u010d"}: ${util.joinValues(issue.keys\x2C "\x2C ")}`;\n            case "invalid_key":\n                return `Neveljaven klju\u010d v ${issue.origin}`;\n            case "invalid_union":\n                return "Neveljaven vnos";\n            case "invalid_element":\n                return `Neveljavna vrednost v ${issue.origin}`;\n            default:\n                return "Neveljaven vnos";\n        }\n    };\n};\nexport default function () {\n    return {\n        localeError: error()\x2C\n    };\n}\n
