script-source,518,file:///mnt/d/blog/Firefly/node_modules/zod/v4/locales/yo.js,import * as util from "../core/util.js";\nconst error = () => {\n    const Sizable = {\n        string: { unit: "\xe0mi"\x2C verb: "n\xed" }\x2C\n        file: { unit: "bytes"\x2C verb: "n\xed" }\x2C\n        array: { unit: "nkan"\x2C verb: "n\xed" }\x2C\n        set: { unit: "nkan"\x2C verb: "n\xed" }\x2C\n    };\n    function getSizing(origin) {\n        return Sizable[origin] ?? null;\n    }\n    const FormatDictionary = {\n        regex: "\u1eb9\u0300r\u1ecd \xecb\xe1w\u1ecdl\xe9"\x2C\n        email: "\xe0d\xedr\u1eb9\u0301s\xec \xecm\u1eb9\u0301l\xec"\x2C\n        url: "URL"\x2C\n        emoji: "emoji"\x2C\n        uuid: "UUID"\x2C\n        uuidv4: "UUIDv4"\x2C\n        uuidv6: "UUIDv6"\x2C\n        nanoid: "nanoid"\x2C\n        guid: "GUID"\x2C\n        cuid: "cuid"\x2C\n        cuid2: "cuid2"\x2C\n        ulid: "ULID"\x2C\n        xid: "XID"\x2C\n        ksuid: "KSUID"\x2C\n        datetime: "\xe0k\xf3k\xf2 ISO"\x2C\n        date: "\u1ecdj\u1ecd\u0301 ISO"\x2C\n        time: "\xe0k\xf3k\xf2 ISO"\x2C\n        duration: "\xe0k\xf3k\xf2 t\xf3 p\xe9 ISO"\x2C\n        ipv4: "\xe0d\xedr\u1eb9\u0301s\xec IPv4"\x2C\n        ipv6: "\xe0d\xedr\u1eb9\u0301s\xec IPv6"\x2C\n        cidrv4: "\xe0gb\xe8gb\xe8 IPv4"\x2C\n        cidrv6: "\xe0gb\xe8gb\xe8 IPv6"\x2C\n        base64: "\u1ecd\u0300r\u1ecd\u0300 t\xed a k\u1ecd\u0301 n\xed base64"\x2C\n        base64url: "\u1ecd\u0300r\u1ecd\u0300 base64url"\x2C\n        json_string: "\u1ecd\u0300r\u1ecd\u0300 JSON"\x2C\n        e164: "n\u1ecd\u0301mb\xe0 E.164"\x2C\n        jwt: "JWT"\x2C\n        template_literal: "\u1eb9\u0300r\u1ecd \xecb\xe1w\u1ecdl\xe9"\x2C\n    };\n    const TypeDictionary = {\n        nan: "NaN"\x2C\n        number: "n\u1ecd\u0301mb\xe0"\x2C\n        array: "akop\u1ecd"\x2C\n    };\n    return (issue) => {\n        switch (issue.code) {\n            case "invalid_type": {\n                const expected = TypeDictionary[issue.expected] ?? issue.expected;\n                const receivedType = util.parsedType(issue.input);\n                const received = TypeDictionary[receivedType] ?? receivedType;\n                if (/^[A-Z]/.test(issue.expected)) {\n                    return `\xccb\xe1w\u1ecdl\xe9 a\u1e63\xec\u1e63e: a n\xed l\xe1ti fi instanceof ${issue.expected}\x2C \xe0m\u1ecd\u0300 a r\xed ${received}`;\n                }\n                return `\xccb\xe1w\u1ecdl\xe9 a\u1e63\xec\u1e63e: a n\xed l\xe1ti fi ${expected}\x2C \xe0m\u1ecd\u0300 a r\xed ${received}`;\n            }\n            case "invalid_value":\n                if (issue.values.length === 1)\n                    return `\xccb\xe1w\u1ecdl\xe9 a\u1e63\xec\u1e63e: a n\xed l\xe1ti fi ${util.stringifyPrimitive(issue.values[0])}`;\n                return `\xc0\u1e63\xe0y\xe0n a\u1e63\xec\u1e63e: yan \u1ecd\u0300kan l\xe1ra ${util.joinValues(issue.values\x2C "|")}`;\n            case "too_big": {\n                const adj = issue.inclusive ? "<=" : "<";\n                const sizing = getSizing(issue.origin);\n                if (sizing)\n                    return `T\xf3 p\u1ecd\u0300 j\xf9: a n\xed l\xe1ti j\u1eb9\u0301 p\xe9 ${issue.origin ?? "iye"} ${sizing.verb} ${adj}${issue.maximum} ${sizing.unit}`;\n                return `T\xf3 p\u1ecd\u0300 j\xf9: a n\xed l\xe1ti j\u1eb9\u0301 ${adj}${issue.maximum}`;\n            }\n            case "too_small": {\n                const adj = issue.inclusive ? ">=" : ">";\n                const sizing = getSizing(issue.origin);\n                if (sizing)\n                    return `K\xe9r\xe9 ju: a n\xed l\xe1ti j\u1eb9\u0301 p\xe9 ${issue.origin} ${sizing.verb} ${adj}${issue.minimum} ${sizing.unit}`;\n                return `K\xe9r\xe9 ju: a n\xed l\xe1ti j\u1eb9\u0301 ${adj}${issue.minimum}`;\n            }\n            case "invalid_format": {\n                const _issue = issue;\n                if (_issue.format === "starts_with")\n                    return `\u1ecc\u0300r\u1ecd\u0300 a\u1e63\xec\u1e63e: gb\u1ecd\u0301d\u1ecd\u0300 b\u1eb9\u0300r\u1eb9\u0300 p\u1eb9\u0300l\xfa "${_issue.prefix}"`;\n                if (_issue.format === "ends_with")\n                    return `\u1ecc\u0300r\u1ecd\u0300 a\u1e63\xec\u1e63e: gb\u1ecd\u0301d\u1ecd\u0300 par\xed p\u1eb9\u0300l\xfa "${_issue.suffix}"`;\n                if (_issue.format === "includes")\n                    return `\u1ecc\u0300r\u1ecd\u0300 a\u1e63\xec\u1e63e: gb\u1ecd\u0301d\u1ecd\u0300 n\xed "${_issue.includes}"`;\n                if (_issue.format === "regex")\n                    return `\u1ecc\u0300r\u1ecd\u0300 a\u1e63\xec\u1e63e: gb\u1ecd\u0301d\u1ecd\u0300 b\xe1 \xe0p\u1eb9\u1eb9r\u1eb9 mu ${_issue.pattern}`;\n                return `A\u1e63\xec\u1e63e: ${FormatDictionary[_issue.format] ?? issue.format}`;\n            }\n            case "not_multiple_of":\n                return `N\u1ecd\u0301mb\xe0 a\u1e63\xec\u1e63e: gb\u1ecd\u0301d\u1ecd\u0300 j\u1eb9\u0301 \xe8y\xe0 p\xedp\xedn ti ${issue.divisor}`;\n            case "unrecognized_keys":\n                return `B\u1ecdt\xecn\xec \xe0\xecm\u1ecd\u0300: ${util.joinValues(issue.keys\x2C "\x2C ")}`;\n            case "invalid_key":\n                return `B\u1ecdt\xecn\xec a\u1e63\xec\u1e63e n\xedn\xfa ${issue.origin}`;\n            case "invalid_union":\n                return "\xccb\xe1w\u1ecdl\xe9 a\u1e63\xec\u1e63e";\n            case "invalid_element":\n                return `Iye a\u1e63\xec\u1e63e n\xedn\xfa ${issue.origin}`;\n            default:\n                return "\xccb\xe1w\u1ecdl\xe9 a\u1e63\xec\u1e63e";\n        }\n    };\n};\nexport default function () {\n    return {\n        localeError: error()\x2C\n    };\n}\n
