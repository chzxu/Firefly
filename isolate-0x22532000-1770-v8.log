script-source,714,file:///mnt/d/blog/Firefly/node_modules/mdast-util-to-markdown/lib/configure.js,/**\n * @import {Options\x2C State} from './types.js'\n */\n\nconst own = {}.hasOwnProperty\n\n/**\n * @param {State} base\n * @param {Options} extension\n * @returns {State}\n */\nexport function configure(base\x2C extension) {\n  let index = -1\n  /** @type {keyof Options} */\n  let key\n\n  // First do subextensions.\n  if (extension.extensions) {\n    while (++index < extension.extensions.length) {\n      configure(base\x2C extension.extensions[index])\n    }\n  }\n\n  for (key in extension) {\n    if (own.call(extension\x2C key)) {\n      switch (key) {\n        case 'extensions': {\n          // Empty.\n          break\n        }\n\n        /* c8 ignore next 4 */\n        case 'unsafe': {\n          list(base[key]\x2C extension[key])\n          break\n        }\n\n        case 'join': {\n          list(base[key]\x2C extension[key])\n          break\n        }\n\n        case 'handlers': {\n          map(base[key]\x2C extension[key])\n          break\n        }\n\n        default: {\n          // @ts-expect-error: matches.\n          base.options[key] = extension[key]\n        }\n      }\n    }\n  }\n\n  return base\n}\n\n/**\n * @template T\n * @param {Array<T>} left\n * @param {Array<T> | null | undefined} right\n */\nfunction list(left\x2C right) {\n  if (right) {\n    left.push(...right)\n  }\n}\n\n/**\n * @template T\n * @param {Record<string\x2C T>} left\n * @param {Record<string\x2C T> | null | undefined} right\n */\nfunction map(left\x2C right) {\n  if (right) {\n    Object.assign(left\x2C right)\n  }\n}\n
