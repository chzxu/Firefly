script-source,581,file:///mnt/d/blog/Firefly/node_modules/property-information/lib/hast-to-react.js,/**\n * Special cases for React (`Record<string\x2C string>`).\n *\n * `hast` is close to `React` but differs in a couple of cases.\n * To get a React property from a hast property\x2C\n * check if it is in `hastToReact`.\n * If it is\x2C use the corresponding value;\n * otherwise\x2C use the hast property.\n *\n * @type {Record<string\x2C string>}\n */\nexport const hastToReact = {\n  classId: 'classID'\x2C\n  dataType: 'datatype'\x2C\n  itemId: 'itemID'\x2C\n  strokeDashArray: 'strokeDasharray'\x2C\n  strokeDashOffset: 'strokeDashoffset'\x2C\n  strokeLineCap: 'strokeLinecap'\x2C\n  strokeLineJoin: 'strokeLinejoin'\x2C\n  strokeMiterLimit: 'strokeMiterlimit'\x2C\n  typeOf: 'typeof'\x2C\n  xLinkActuate: 'xlinkActuate'\x2C\n  xLinkArcRole: 'xlinkArcrole'\x2C\n  xLinkHref: 'xlinkHref'\x2C\n  xLinkRole: 'xlinkRole'\x2C\n  xLinkShow: 'xlinkShow'\x2C\n  xLinkTitle: 'xlinkTitle'\x2C\n  xLinkType: 'xlinkType'\x2C\n  xmlnsXLink: 'xmlnsXlink'\n}\n
