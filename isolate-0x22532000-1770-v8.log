| !shouldSkip(typeOf(entry)))\n            entries.push(pair(entry));\n        }\n        return index;\n      }\n    }\n\n    const {message} = value;\n    return as([TYPE\x2C {name: type\x2C message}]\x2C value);\n  };\n\n  return pair;\n};\n\n/**\n * @typedef {Array<string\x2Cany>} Record a type representation\n */\n\n/**\n * Returns an array of serialized Records.\n * @param {any} value a serializable value.\n * @param {{json?: boolean\x2C lossy?: boolean}?} options an object with a `lossy` or `json` property that\x2C\n *  if `true`\x2C will not throw errors on incompatible types\x2C and behave more\n *  like JSON stringify would behave. Symbol and Function will be discarded.\n * @returns {Record[]}\n */\n export const serialize = (value\x2C {json\x2C lossy} = {}) => {\n  const _ = [];\n  return serializer(!(json || lossy)\x2C !!json\x2C new Map\x2C _)(value)\x2C _;\n};\n
