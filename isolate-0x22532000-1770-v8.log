script-source,738,file:///mnt/d/blog/Firefly/node_modules/mdast-util-to-markdown/lib/handle/paragraph.js,/**\n * @import {Info\x2C State} from 'mdast-util-to-markdown'\n * @import {Paragraph\x2C Parents} from 'mdast'\n */\n\n/**\n * @param {Paragraph} node\n * @param {Parents | undefined} _\n * @param {State} state\n * @param {Info} info\n * @returns {string}\n */\nexport function paragraph(node\x2C _\x2C state\x2C info) {\n  const exit = state.enter('paragraph')\n  const subexit = state.enter('phrasing')\n  const value = state.containerPhrasing(node\x2C info)\n  subexit()\n  exit()\n  return value\n}\n
