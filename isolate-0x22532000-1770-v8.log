ength = array[position++];\n            const bytePosition = position << 2;\n            return astBuffer.toString('utf8'\x2C bytePosition\x2C bytePosition + length);\n        };\n    }\n    else {\n        const textDecoder = new TextDecoder();\n        convertString = (position) => {\n            const length = array[position++];\n            const bytePosition = position << 2;\n            return textDecoder.decode(astBuffer.subarray(bytePosition\x2C bytePosition + length));\n        };\n    }\n    return Object.assign(array\x2C { convertString });\n}\n\nconst parseAst = (input\x2C { allowReturnOutsideFunction = false\x2C jsx = false } = {}) => convertProgram(getAstBuffer(parse(input\x2C allowReturnOutsideFunction\x2C jsx)));\nconst parseAstAsync = async (input\x2C { allowReturnOutsideFunction = false\x2C jsx = false\x2C signal } = {}) => convertProgram(getAstBuffer(await parseAsync(input\x2C allowReturnOutsideFunction\x2C jsx\x2C signal)));\n\nexport { ANNOTATION_KEY\x2C ArrowFunctionExpression\x2C AwaitExpression\x2C BLANK\x2C BlockStatement\x2C CallExpression\x2C CatchClause\x2C EMPTY_ARRAY\x2C EMPTY_OBJECT\x2C EMPTY_SET\x2C ExportDefaultDeclaration\x2C ExpressionStatement\x2C FIXED_STRINGS\x2C FunctionExpression\x2C INVALID_ANNOTATION_KEY\x2C Identifier\x2C LOGLEVEL_DEBUG\x2C LOGLEVEL_ERROR\x2C LOGLEVEL_INFO\x2C LOGLEVEL_WARN\x2C Literal\x2C MemberExpression\x2C ObjectExpression\x2C Program\x2C Property\x2C RestElement\x2C ReturnStatement\x2C StaticBlock\x2C TemplateLiteral\x2C URL_GENERATEBUNDLE\x2C URL_JSX\x2C URL_LOAD\x2C URL_OUTPUT_AMD_BASEPATH\x2C URL_OUTPUT_AMD_ID\x2C URL_OUTPUT_DIR\x2C URL_OUTPUT_EXTERNALIMPORTATTRIBUTES\x2C URL_OUTPUT_FORMAT\x2C URL_OUTPUT_GENERATEDCODE\x2C URL_OUTPUT_INLINEDYNAMICIMPORTS\x2C URL_OUTPUT_INTEROP\x2C URL_OUTPUT_MANUALCHUNKS\x2C URL_OUTPUT_SOURCEMAPBASEURL\x2C URL_OUTPUT_SOURCEMAPFILE\x2C URL_PRESERVEENTRYSIGNATURES\x2C URL_TRANSFORM\x2C URL_TREESHAKE\x2C URL_TREESHAKE_MODULESIDEEFFECTS\x2C URL_WATCH\x2C VariableDeclarat