script-source,432,file:///mnt/d/blog/Firefly/node_modules/@ungap/structured-clone/esm/index.js,import {deserialize} from './deserialize.js';\nimport {serialize} from './serialize.js';\n\n/**\n * @typedef {Array<string\x2Cany>} Record a type representation\n */\n\n/**\n * Returns an array of serialized Records.\n * @param {any} any a serializable value.\n * @param {{transfer?: any[]\x2C json?: boolean\x2C lossy?: boolean}?} options an object with\n * a transfer option (ignored when polyfilled) and/or non standard fields that\n * fallback to the polyfill if present.\n * @returns {Record[]}\n */\nexport default typeof structuredClone === "function" ?\n  /* c8 ignore start */\n  (any\x2C options) => (\n    options && ('json' in options || 'lossy' in options) ?\n      deserialize(serialize(any\x2C options)) : structuredClone(any)\n  ) :\n  (any\x2C options) => deserialize(serialize(any\x2C options));\n  /* c8 ignore stop */\n\nexport {deserialize\x2C serialize};\n
