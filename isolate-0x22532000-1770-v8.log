script-source,282,file:///mnt/d/blog/Firefly/node_modules/astro/dist/env/schema.js,import * as z from "zod/v4";\nconst StringSchema = z.object({\n  type: z.literal("string")\x2C\n  optional: z.boolean().optional()\x2C\n  default: z.string().optional()\x2C\n  max: z.number().optional()\x2C\n  min: z.number().min(0).optional()\x2C\n  length: z.number().optional()\x2C\n  url: z.boolean().optional()\x2C\n  includes: z.string().optional()\x2C\n  startsWith: z.string().optional()\x2C\n  endsWith: z.string().optional()\n});\nconst NumberSchema = z.object({\n  type: z.literal("number")\x2C\n  optional: z.boolean().optional()\x2C\n  default: z.number().optional()\x2C\n  gt: z.number().optional()\x2C\n  min: z.number().optional()\x2C\n  lt: z.number().optional()\x2C\n  max: z.number().optional()\x2C\n  int: z.boolean().optional()\n});\nconst BooleanSchema = z.object({\n  type: z.literal("boolean")\x2C\n  optional: z.boolean().optional()\x2C\n  default: z.boolean().optional()\n});\nconst EnumSchema = z.object({\n  type: z.literal("enum")\x2C\n  values: z.array(\n    // We use "'" for codegen so it can't be passed here\n    z.string().refine((v) => !v.includes("'")\x2C {\n      message: `The "'" character can't be used as an enum value`\n    })\n  )\x2C\n  optional: z.boolean().optional()\x2C\n  default: z.string().optional()\n});\nconst EnvFieldType = z.union([\n  StringSchema\x2C\n  NumberSchema\x2C\n  BooleanSchema\x2C\n  EnumSchema.superRefine((schema\x2C ctx) => {\n    if (schema.default) {\n      if (!schema.values.includes(schema.default)) {\n        ctx.addIssue({\n          code: z.ZodIssueCode.custom\x2C\n          message: `The default value "${schema.default}" must be one of the specified values: ${schema.values.join("\x2C ")}.`\n        });\n      }\n    }\n  })\n]);\nconst PublicClientEnvFieldMetadata = z.object({\n  context: z.literal("client")\x2C\n  access: z.literal("public")\n});\nconst PublicServerEnvFieldMetadata = z.object({\n  context: z.literal("server")\x2C\n  access: z.literal("public")\n});\nconst SecretServerEnvFieldMetadata = z.object({\n  context: z.literal("server")\x2C\n  access: z.literal("secret")\n});\nconst _EnvFieldMetadata = z.union([\n  PublicClientEnvFieldMetadata\x2C\n  PublicServerEnvFieldMetadata\x2C\n  SecretServerEnvFieldMetadata\n]);\nconst EnvFieldMetadata = z.custom().superRefine((data\x2C ctx) => {\n  const result = _EnvFieldMetadata.safeParse(data);\n  if (result.success) {\n    return;\n  }\n  for (const issue of result.error.issues) {\n    if (issue.code === z.ZodIssueCode.invalid_union) {\n      ctx.addIssue({\n        code: z.ZodIssueCode.custom\x2C\n        message: `**Invalid combination** of "access" and "context" options:\n  Secret client variables are not supported. Please review the configuration.\n  Learn more at https://docs.astro.build/en/guides/environment-variables/#variable-types`\x2C\n        path: ["context"\x2C "access"]\n      });\n    } else {\n      ctx.addIssue({\n        ...issue\x2C\n        code: "custom"\n      });\n    }\n  }\n});\nconst EnvSchemaKey = z.string().min(1).refine(([firstChar]) => isNaN(Number.parseInt(firstChar))\x2C {\n  message: "A valid variable name cannot start with a number."\n}).refine((str) => /^[A-Z0-9_]+$/.test(str)\x2C {\n  message: "A valid variable name can only contain uppercase letters\x2C numbers and underscores."\n});\nconst EnvSchema = z.record(EnvSchemaKey\x2C z.intersection(EnvFieldMetadata\x2C EnvFieldType));\nexport {\n  EnvSchema\n};\n
