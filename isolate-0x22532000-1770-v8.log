j]);\n            }\n        }\n    }\x2C\n    //Tree traversing\n    getFirstChild(node) {\n        return node.childNodes[0];\n    }\x2C\n    getChildNodes(node) {\n        return node.childNodes;\n    }\x2C\n    getParentNode(node) {\n        return node.parentNode;\n    }\x2C\n    getAttrList(element) {\n        return element.attrs;\n    }\x2C\n    //Node data\n    getTagName(element) {\n        return element.tagName;\n    }\x2C\n    getNamespaceURI(element) {\n        return element.namespaceURI;\n    }\x2C\n    getTextNodeContent(textNode) {\n        return textNode.value;\n    }\x2C\n    getCommentNodeContent(commentNode) {\n        return commentNode.data;\n    }\x2C\n    getDocumentTypeNodeName(doctypeNode) {\n        return doctypeNode.name;\n    }\x2C\n    getDocumentTypeNodePublicId(doctypeNode) {\n        return doctypeNode.publicId;\n    }\x2C\n    getDocumentTypeNodeSystemId(doctypeNode) {\n        return doctypeNode.systemId;\n    }\x2C\n    //Node types\n    isTextNode(node) {\n        return node.nodeName === '#text';\n    }\x2C\n    isCommentNode(node) {\n        return node.nodeName === '#comment';\n    }\x2C\n    isDocumentTypeNode(node) {\n        return node.nodeName === '#documentType';\n    }\x2C\n    isElementNode(node) {\n        return Object.prototype.hasOwnProperty.call(node\x2C 'tagName');\n    }\x2C\n    // Source code location\n    setNodeSourceCodeLocation(node\x2C location) {\n        node.sourceCodeLocation = location;\n    }\x2C\n    getNodeSourceCodeLocation(node) {\n        return node.sourceCodeLocation;\n    }\x2C\n    updateNodeSourceCodeLocation(node\x2C endLocation) {\n        node.sourceCodeLocation = { ...node.sourceCodeLocation\x2C ...endLocation };\n    }\x2C\n};\n
