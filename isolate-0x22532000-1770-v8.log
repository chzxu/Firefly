script-source,716,file:///mnt/d/blog/Firefly/node_modules/mdast-util-to-markdown/lib/unsafe.js,/**\n * @import {ConstructName\x2C Unsafe} from 'mdast-util-to-markdown'\n */\n\n/**\n * List of constructs that occur in phrasing (paragraphs\x2C headings)\x2C but cannot\n * contain things like attention (emphasis\x2C strong)\x2C images\x2C or links.\n * So they sort of cancel each other out.\n * Note: could use a better name.\n *\n * @type {Array<ConstructName>}\n */\nconst fullPhrasingSpans = [\n  'autolink'\x2C\n  'destinationLiteral'\x2C\n  'destinationRaw'\x2C\n  'reference'\x2C\n  'titleQuote'\x2C\n  'titleApostrophe'\n]\n\n/** @type {Array<Unsafe>} */\nexport const unsafe = [\n  {character: '\\t'\x2C after: '[\\\\r\\\\n]'\x2C inConstruct: 'phrasing'}\x2C\n  {character: '\\t'\x2C before: '[\\\\r\\\\n]'\x2C inConstruct: 'phrasing'}\x2C\n  {\n    character: '\\t'\x2C\n    inConstruct: ['codeFencedLangGraveAccent'\x2C 'codeFencedLangTilde']\n  }\x2C\n  {\n    character: '\\r'\x2C\n    inConstruct: [\n      'codeFencedLangGraveAccent'\x2C\n      'codeFencedLangTilde'\x2C\n      'codeFencedMetaGraveAccent'\x2C\n      'codeFencedMetaTilde'\x2C\n      'destinationLiteral'\x2C\n      'headingAtx'\n    ]\n  }\x2C\n  {\n    character: '\\n'\x2C\n    inConstruct: [\n      'codeFencedLangGraveAccent'\x2C\n      'codeFencedLangTilde'\x2C\n      'codeFencedMetaGraveAccent'\x2C\n      'codeFencedMetaTilde'\x2C\n      'destinationLiteral'\x2C\n      'headingAtx'\n    ]\n  }\x2C\n  {character: ' '\x2C after: '[\\\\r\\\\n]'\x2C inConstruct: 'phrasing'}\x2C\n  {character: ' '\x2C before: '[\\\\r\\\\n]'\x2C inConstruct: 'phrasing'}\x2C\n  {\n    character: ' '\x2C\n    inConstruct: ['codeFencedLangGraveAccent'\x2C 'codeFencedLangTilde']\n  }\x2C\n  // An exclamation mark can start an image\x2C if it is followed by a link or\n  // a link reference.\n  {\n    character: '!'\x2C\n    after: '\\\\['\x2C\n    inConstruct: 'phrasing'\x2C\n    notInConstruct: fullPhrasingSpans\n  }\x2C\n  // A quote can break out of a title.\n  {character: '"'\x2C inConstruct: 'titleQuote'}\x2C\n  // A number sign could start an ATX heading if it starts a line.\n  {atBreak: true\x2C character: '#'}\x2C\n  {character: '#'\x2C inConstruct: 'headingAtx'\x2C after: '(?:[\\r\\n]|$)'}\x2C\n  // Dollar sign and percentage are not used in markdown.\n  // An ampersand could start a character reference.\n  {character: '&'\x2C after: '[#A-Za-z]'\x2C inConstruct: 'phrasing'}\x2C\n  // An apostrophe can break out of a title.\n  {character: "'"\x2C inConstruct: 'titleApostrophe'}\x2C\n  // A left paren could break out of a destination raw.\n  {character: '('\x2C inConstruct: 'destinationRaw'}\x2C\n  // A left paren followed by `]` could make something into a link or image.\n  {\n    before: '\\\\]'\x2C\n    character: '('\x2C\n    inConstruct: 'phrasing'\x2C\n    notInConstruct: fullPhrasingSpans\n  }\x2C\n  // A right paren could start a list item or break out of a destination\n  // raw.\n  {atBreak: true\x2C before: '\\\\d+'\x2C character: ')'}\x2C\n  {character: ')'\x2C inConstruct: 'destinationRaw'}\x2C\n  // An asterisk can start thematic breaks\x2C list items\x2C emphasis\x2C strong.\n  {atBreak: true\x2C character: '*'\x2C after: '(?:[ \\t\\r\\n*])'}\x2C\n  {character: '*'\x2C inConstruct: 'phrasing'\x2C notInConstruct: fullPhrasingSpans}\x2C\n  // A plus sign could start a list item.\n  {atBreak: true\x2C character: '+'\x2C after: '(?:[ \\t\\r\\n])'}\x2C\n  // A dash can start thematic breaks\x2C list items\x2C and setext heading\n  // underlines.\n  {atBreak: true\x2C character: '-'\x2C after: '(?:[ \\t\\r\\n-])'}\x2C\n  // A dot could start a list item.\n  {atBreak: true\x2C before: '\\\\d+'\x2C character: '.'\x2C after: '(?:[ \\t\\r\\n]|$)'}\x2C\n  // Slash\x2C colon\x2C and semicolon are not used in markdown for constructs.\n  // A less than can start html (flow or text) or an autolink.\n  // HTML could start with an exclamation mark (declaration\x2C cdata\x2C comment)\x2C\n  // slash (closing tag)\x2C question mark (instruction)\x2C or a letter (tag).\n  // An autolink also starts with a letter.\n  // Finally\x2C it could break out of a destination literal.\n  {atBreak: true\x2C character: '<'\x2C after: '[!/?A-Za-z]'}\x2C\n  {\n    character: '<'\x2C\n    after: '[!/?A-Za-z]'\x2C\n    inConstruct: 'phrasing'\x2C\n    notInConstruct: fullPhrasingSpans\n  }\x2C\n  {character: '<'\x2C inConstruct: 'destinationLiteral'}\x2C\n  // An equals to can start setext heading underlines.\n  {atBreak: true\x2C character: '='}\x2C\n  // A greater than can start block quotes and it can break out of a\n  // destination literal.\n  {atBreak: true\x2C character: '>'}\x2C\n  {character: '>'\x2C inConstruct: 'destinationLiteral'}\x2C\n  // Question mark and at sign are not used in markdown for constructs.\n  // A left bracket can start definitions\x2C references\x2C labels\x2C\n  {atBreak: true\x2C character: '['}\x2C\n  {character: '['\x2C inConstruct: 'phrasing'\x2C notInConstruct: fullPhrasingSpans}\x2C\n  {character: '['\x2C inConstruct: ['label'\x2C 'reference']}\x2C\n  // A backslash can start an escape (when followed by punctuation) or a\n  // hard break (when followed by an eol).\n  // Note: typical escapes are handled in `safe`!\n  {character: '\\\\'\x2C after: '[\\\\r\\\\n]'\x2C inConstruct: 'phrasing'}\x2C\n  // A right bracket can exit labels.\n  {character: ']'\x2C inConstruct: ['label'\x2C 'reference']}\x2C\n  // Caret is not used in markdown for constructs.\n  // An underscore can start emphasis\x2C strong\x2C or a thematic break.\n  {atBreak: true\x2C character: '_'}\x2C\n  {character: '_'\x2C inConstruct: 'phrasing'\x2C notInConstruct: fullPhrasingSpans}\x2C\n  // A grave accent can start code (fenced or text)\x2C or it can break out of\n  // a grave accent code fence.\n  {atBreak: true\x2C character: '`'}\x2C\n  {\n    character: '`'\x2C\n    inConstruct: ['codeFencedLangGraveAccent'\x2C 'codeFencedMetaGraveAccent']\n  }\x2C\n  {character: '`'\x2C inConstruct: 'phrasing'\x2C notInConstruct: fullPhrasingSpans}\x2C\n  // Left brace\x2C vertical bar\x2C right brace are not used in markdown for\n  // constructs.\n  // A tilde can start code (fenced).\n  {atBreak: true\x2C character: '~'}\n]\n
