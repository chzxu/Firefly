script-source,148,file:///mnt/d/blog/Firefly/node_modules/astro/dist/core/logger/impls/json.js,import {\n  AstroLogger\x2C\n  levels\n} from "../core.js";\nimport { matchesLevel } from "../public.js";\nconst SGR_REGEX = new RegExp(`${String.fromCharCode(27)}\\\\[[0-9;]*m`\x2C "g");\nfunction jsonLoggerDestination(config = {}) {\n  const { pretty = false\x2C level = "info" } = config;\n  return {\n    write(event) {\n      let dest = process.stderr;\n      if (levels[event.level] < levels["error"]) {\n        dest = process.stdout;\n      }\n      if (!matchesLevel(event.level\x2C level)) {\n        return;\n      }\n      let trailingLine = event.newLine ? "\\n" : "";\n      const message = event.message.replace(SGR_REGEX\x2C "");\n      if (pretty) {\n        dest.write(\n          JSON.stringify({ message\x2C label: event.label\x2C level: event.level }\x2C null\x2C 2) + trailingLine\n        );\n      } else {\n        dest.write(\n          JSON.stringify({ message\x2C label: event.label\x2C level: event.level }) + trailingLine\n        );\n      }\n    }\n  };\n}\nfunction createJsonLoggerFromFlags(config) {\n  return new AstroLogger({\n    destination: jsonLoggerDestination({ pretty: false })\x2C\n    level: config.logLevel ?? "info"\n  });\n}\nexport {\n  SGR_REGEX\x2C\n  createJsonLoggerFromFlags\x2C\n  jsonLoggerDestination as default\n};\n
