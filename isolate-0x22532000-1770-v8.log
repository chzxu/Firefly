script-source,415,file:///mnt/d/blog/Firefly/node_modules/mdast-util-to-hast/lib/handlers/html.js,/**\n * @import {Element} from 'hast'\n * @import {Html} from 'mdast'\n * @import {State} from '../state.js'\n * @import {Raw} from '../../index.js'\n */\n\n/**\n * Turn an mdast `html` node into hast (`raw` node in dangerous mode\x2C otherwise\n * nothing).\n *\n * @param {State} state\n *   Info passed around.\n * @param {Html} node\n *   mdast node.\n * @returns {Element | Raw | undefined}\n *   hast node.\n */\nexport function html(state\x2C node) {\n  if (state.options.allowDangerousHtml) {\n    /** @type {Raw} */\n    const result = {type: 'raw'\x2C value: node.value}\n    state.patch(node\x2C result)\n    return state.applyData(node\x2C result)\n  }\n\n  return undefined\n}\n
