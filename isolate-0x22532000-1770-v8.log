script-source,130,file:///mnt/d/blog/Firefly/node_modules/astro/node_modules/yargs-parser/build/lib/yargs-parser.js,/**\n * @license\n * Copyright (c) 2016\x2C Contributors\n * SPDX-License-Identifier: ISC\n */\n/* eslint-disable prefer-arrow-callback */\nimport { tokenizeArgString } from './tokenize-arg-string.js';\nimport { DefaultValuesForTypeKey } from './yargs-parser-types.js';\nimport { camelCase\x2C decamelize\x2C looksLikeNumber } from './string-utils.js';\nlet mixin;\nexport class YargsParser {\n    constructor(_mixin) {\n        mixin = _mixin;\n    }\n    parse(argsInput\x2C options) {\n        const opts = Object.assign({\n            alias: undefined\x2C\n            array: undefined\x2C\n            boolean: undefined\x2C\n            config: undefined\x2C\n            configObjects: undefined\x2C\n            configuration: undefined\x2C\n            coerce: undefined\x2C\n            count: undefined\x2C\n            default: undefined\x2C\n            envPrefix: undefined\x2C\n            narg: undefined\x2C\n            normalize: undefined\x2C\n            string: undefined\x2C\n            number: undefined\x2C\n            __: undefined\x2C\n            key: undefined\n        }\x2C options);\n        // allow a string argument to be passed in rather\n        // than an argv array.\n        const args = tokenizeArgString(argsInput);\n        // tokenizeArgString adds extra quotes to args if argsInput is a string\n        // only strip those extra quotes in processValue if argsInput is a string\n        const inputIsString = typeof argsInput === 'string';\n        // aliases might have transitive relationships\x2C normalize this.\n        const aliases = combineAliases(Object.assign(Object.create(null)\x2C opts.alias));\n        const configuration = Object.assign({\n            'boolean-negation': true\x2C\n            'camel-case-expansion': true\x2C\n            'combine-arrays': false\x2C\n            'dot-notation': true\x2C\n            'du